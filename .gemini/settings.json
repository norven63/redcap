{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "redcap-session-start",
            "type": "command",
            "command": "bash compass/tools/redcap-layerB-session-start.sh gemini",
            "description": "RedCap Layer B 会话开始：捕获初始 HEAD 作为本次会话基线"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "redcap-session-end",
            "type": "command",
            "command": "bash loom/tools/redcap-layerA-session-end.sh gemini",
            "description": "RedCap 通用 SessionEnd 分发代理：Layer A 清理 / Layer B 评审、报告与飞书兜底"
          }
        ]
      }
    ]
  }
}
