{
  "version": 1,
  "policy_id": "redcap-cli-product-surface",
  "status": "active-before-public-release",
  "purpose": "Make the RedCap CLI diagnosable by external users and Agent containers without leaking local secrets or forcing users to read internal script output.",
  "required_commands": [
    "doctor",
    "debug",
    "help",
    "--trace"
  ],
  "workspace_contract": {
    "must_reuse_runtime_workspace_boundary": true,
    "workspace_option": "--workspace",
    "task_file_option": "--task-file",
    "missing_task_file_behavior": "doctor/debug explain the missing project task card in degraded mode instead of falling back to the RedCap runtime task card"
  },
  "doctor_contract": {
    "audience": "external user or Agent container operator",
    "must_include": [
      "single overall status line",
      "managed workspace summary",
      "task-card status",
      "up to five prioritized findings",
      "next step"
    ],
    "must_not_include": [
      "raw [ok]/[fail] gate dumps",
      "full internal diagnose output",
      "secret values or identity file contents"
    ]
  },
  "debug_contract": {
    "json_flag": "--json",
    "required_json_fields": [
      "version",
      "surface",
      "status",
      "runtime_root",
      "workspace_root",
      "task_file",
      "task_file_status",
      "task_id",
      "boundary_mode",
      "checks",
      "no_secrets_assertion"
    ],
    "forbidden_json_fields": [
      "identity_file",
      "agent_name"
    ],
    "no_secrets_assertion": true
  },
  "trace_contract": {
    "activation": "redcap --trace <command> ... or redcap <command> --trace ...",
    "allowed_fields": [
      "command",
      "runtime_root",
      "workspace_root",
      "task_file",
      "delegated_to"
    ],
    "must_not_use": [
      "set -x",
      "environment dump",
      "shell execution transcript"
    ]
  },
  "error_contract": {
    "exit_code_for_usage_errors": 2,
    "required_fields": [
      "cause",
      "impact",
      "suggested_action"
    ],
    "typo_suggestions_required": true
  },
  "redaction_contract": {
    "replace_home_paths_with": "$HOME",
    "replace_other_absolute_paths_with": "<absolute-path:sha256-12>",
    "forbidden_substrings": [
      "/Users/",
      "/home/",
      ".cap",
      "identity_file",
      "agent_name",
      "API_KEY",
      "TOKEN",
      "SECRET",
      "PASSWORD"
    ]
  },
  "checker": "compass/tools/redcap-cli-product-surface-check.sh"
}
