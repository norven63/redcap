{
  "version": 1,
  "description": "Fail-closed safety policy for future RedCap npm / standalone runtime packaging. The default check scans the intended package surface, not the whole local workspace.",
  "contract_profile": "alpha-readiness-split-contract",
  "contract_boundary_policy": "references/runtime-public-contract-policy.json",
  "default_package_globs": [
    "package.json",
    "bin/redcap",
    "README.md",
    "ARCHITECTURE.md",
    "revive-cap.sh",
    "closeout-cap.sh",
    "runtime/redcap-core/**",
    "runtime/host-adapters/**",
    "compass/tools/redcap-*.sh",
    "compass/tools/redcap-*.py",
    "prism/tools/*.sh",
    "prism/tools/*.py",
    "prism/README.md",
    "references/*.json",
    "references/file-lookup-dictionary.md",
    "references/public-release-handoff.md",
    "references/redcap-system-layers.md",
    "templates/shared-knowledge/README.md",
    "templates/shared-knowledge/schemas/*.json"
  ],
  "default_exclude_globs": [
    "compass/tools/redcap-acceptance-index.*",
    "compass/tools/redcap-artifact-*",
    "compass/tools/redcap-backlog-check.sh",
    "compass/tools/redcap-check-state.sh",
    "compass/tools/redcap-claude-hook-*",
    "compass/tools/redcap-clean-workspace-e2e.*",
    "compass/tools/redcap-closure-reanchor-check.sh",
    "compass/tools/redcap-commit-message-check.py",
    "compass/tools/redcap-commit-proof-check.sh",
    "compass/tools/redcap-contributing-ia-check.sh",
    "compass/tools/redcap-ensure-git-hooks.sh",
    "compass/tools/redcap-execution-layer-split-check.*",
    "compass/tools/redcap-explore-notes-check.sh",
    "compass/tools/redcap-host-workboard-sync.sh",
    "compass/tools/redcap-human-product-surface-check.*",
    "compass/tools/redcap-information-architecture-check.*",
    "compass/tools/redcap-interop-governance.sh",
    "compass/tools/redcap-legacy-asset-*",
    "compass/tools/redcap-llm-wiki-*",
    "compass/tools/redcap-midcourse-architecture-*",
    "compass/tools/redcap-multi-session-acceptance.sh",
    "compass/tools/redcap-pre-release-structure-task-tree-check.*",
    "compass/tools/redcap-root-information-architecture-check.*",
    "compass/tools/redcap-root-ia-deferral-check.*",
    "compass/tools/redcap-public-distillation-preflight.*",
    "compass/tools/redcap-r0-r22-registry-check.*",
    "compass/tools/redcap-r1-prism-package-visible-support-copy-first-apply-check.*",
    "compass/tools/redcap-r1-control-plane-internal-maintainer-facade-copy-first-apply-check.*",
    "compass/tools/redcap-r1-next-safe-slice-after-internal-maintainer-facade-batch-preflight-check.*",
    "compass/tools/redcap-r1-control-plane-internal-maintainer-facade-batch-2-copy-first-apply-check.*",
    "compass/tools/redcap-r1-next-safe-slice-after-internal-maintainer-facade-batch-2-check.*",
    "compass/tools/redcap-r1-control-plane-public-internal-contract-mirror-preflight-check.*",
    "compass/tools/redcap-r1-next-safe-slice-after-control-plane-contract-mirror-preflight-check.*",
    "compass/tools/redcap-r1-contract-mirror-apply-preflight-subset-check.*",
    "compass/tools/redcap-reviewer-order.py",
    "compass/tools/redcap-review-proof-check.sh",
    "compass/tools/redcap-review-tracks-check.sh",
    "compass/tools/redcap-runtime-contract-surface-check.*",
    "compass/tools/redcap-runtime-helper-check.sh",
    "compass/tools/redcap-session-*.sh",
    "compass/tools/redcap-state-machine-check.sh",
    "compass/tools/redcap-retrieval-escalation-check.*",
    "compass/tools/redcap-agent-reading-absorption-check.*",
    "compass/tools/redcap-codex-live-marker-e2e.sh",
    "compass/tools/redcap-codex-pre-tool-use.sh",
    "compass/tools/redcap-codex-session-start.sh",
    "compass/tools/redcap-codex-stop.sh",
    "compass/tools/redcap-layerB-session-end.sh",
    "compass/tools/redcap-layerB-session-start.sh",
    "compass/tools/redcap-on-qa-pass.sh",
    "compass/tools/redcap-provider-policy.sh",
    "compass/tools/redcap-evolution-grade-check.*",
    "compass/tools/redcap-forge-check.*",
    "references/agent-reading-absorption-policy.json",
    "references/clean-workspace-install-e2e.json",
    "references/evolution-grade-baseline.json",
    "references/human-product-surface-policy.json",
    "references/information-architecture-artifact-governance-policy.json",
    "references/legacy-asset-*.json",
    "references/llm-wiki-*.json",
    "references/midcourse-architecture-task-tree-review.json",
    "references/pre-release-structure-refactor-task-tree.json",
    "references/public-distillation-preflight-policy.json",
    "references/r1-prism-package-visible-support-copy-first-apply.json",
    "references/r1-control-plane-internal-maintainer-facade-copy-first-apply.json",
    "references/r1-next-safe-slice-after-internal-maintainer-facade-batch-preflight.json",
    "references/r1-control-plane-internal-maintainer-facade-batch-2-copy-first-apply.json",
    "references/r1-next-safe-slice-after-internal-maintainer-facade-batch-2.json",
    "references/r1-control-plane-public-internal-contract-mirror-preflight.json",
    "references/r1-next-safe-slice-after-control-plane-contract-mirror-preflight.json",
    "references/r1-contract-mirror-apply-preflight-subset.json",
    "references/redcap-r0-r22-registry.json",
    "references/redcap-holistic-smell-audit.json",
    "references/root-information-architecture-consolidation-plan.json",
    "references/retrieval-escalation-policy.json",
    "references/review-tracks.json",
    "references/skill-lifecycle-policy.json",
    "references/spec-*.json"
  ],
  "deny_path_globs": [
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    ".git/**",
    ".cap/**",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    ".github/copilot-instructions.md",
    "cli_console.md",
    "prompt.txt",
    "compass/.workflow/**",
    "compass/.runtime/**",
    "prism/runs/**",
    "prism/reports/.session-registry.yaml",
    "private-archive/redcap-knowledge/**",
    "redcap-knowledge/**",
    "references/human-product-surface-policy.json",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/.DS_Store",
    "compass/tools/redcap-r1-next-safe-slice-after-control-plane-contract-mirror-preflight-check.*",
    "compass/tools/redcap-r1-contract-mirror-apply-preflight-subset-check.*",
    "references/r1-next-safe-slice-after-control-plane-contract-mirror-preflight.json",
    "references/r1-contract-mirror-apply-preflight-subset.json"
  ],
  "secret_patterns": [
    {
      "id": "private-key-block",
      "pattern": "-----BEGIN (?:RSA |OPENSSH |EC |DSA |)?PRIVATE KEY-----"
    },
    {
      "id": "google-api-key",
      "pattern": "AIza[0-9A-Za-z_-]{25,}"
    },
    {
      "id": "openai-style-key",
      "pattern": "\\bsk-(?:proj|live|svcacct)-[A-Za-z0-9_-]{24,}|\\bsk-[A-Za-z0-9]{32,}"
    },
    {
      "id": "anthropic-style-key",
      "pattern": "sk-ant-[A-Za-z0-9_-]{24,}"
    },
    {
      "id": "generic-env-secret-assignment",
      "pattern": "\\b[A-Z0-9_]*(?:API_KEY|ACCESS_TOKEN|SECRET|PASSWORD|WEBHOOK|COOKIE|PRIVATE_KEY)[A-Z0-9_]*\\s*=\\s*['\\\"]?[^'\\\"\\s]{16,}"
    },
    {
      "id": "feishu-bot-webhook",
      "pattern": "open\\.feishu\\.cn/open-apis/bot/v2/hook/[0-9A-Za-z_-]{20,}"
    },
    {
      "id": "local-user-home-path",
      "pattern": "(?:/Users/[A-Za-z0-9._-]+(?:/|$)|/home/[A-Za-z0-9._-]+(?:/|$))"
    }
  ],
  "max_text_scan_bytes": 2097152,
  "manual_review_boundaries": [
    {
      "id": "real-npm-publish",
      "reason": "The checker can block unsafe package candidates, but the actual npm/pip/brew/Gitee release target, credentials, and public package metadata still require a deliberate release decision."
    },
    {
      "id": "generated-package-manifest",
      "reason": "When RedCap gains a real package builder, that builder must pass its exact file list to this checker before publish instead of relying only on the default package globs."
    }
  ]
}
