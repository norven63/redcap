  "authority_boundary": {
    "backlog_responsibility": "保存跨会话的长期路线、阶段状态、当前焦点与证据锚点。",
    "dev_task_responsibility": "保存当前 live task 的原始输入、确认需求、执行切片与允许修改范围。",
    "human_guide_responsibility": "给人解释这条路线在做什么、哪些已完成、哪些还没做，以及术语是什么意思。"
  },
  "human_contract": {
    "required_headings": [
      "## 一句话先看懂",
      "## 这份机制管什么 / 不管什么",
      "## 使用方式",
      "## 后续推进顺序"
    ],
    "generated_block_start": "<!-- redcap:backlog-generated:start -->",
    "generated_block_end": "<!-- redcap:backlog-generated:end -->"
  },
  "current_focus": {
    "item_id": "P4-11",
    "summary": "P4-11 待推进：P4-10 已完成 Prism report archive 预检；下一步需要重新评审剩余发布前 blocker，决定是进入报告归档 copy-first 实施、控制面后续 batch，还是其他更安全的小切片。"
  },
  "glossary": [
    {
      "term": "backlog",
      "label": "长期路线",
      "meaning": "用来保存“这轮之后还要继续做什么”的跨会话路线表。它不接管当前任务执行细节，只负责长期保持。"
    },
    {
      "term": "active_slice",
      "label": "当前执行切片",
      "meaning": "`.dev-task.md` 里的当前这一刀；它告诉脚本“现在正在做哪部分”，不等于整个长期路线。"
    },
    {
      "term": "validator chain",
      "label": "统一校验链",
      "meaning": "把 PM Gate、漂移检查、任务报告检查、制品生命周期检查等串成一条 fail-closed（失败即阻断）执行链。"
    },
    {
      "term": "mirror-only",
      "label": "只读镜像面",
      "meaning": "宿主 plan.md / workboard 只能展示 RedCap 当前指针和状态，不能反向改写真相源。"
    },
    {
      "term": "spec",
      "label": "设计说明文档",
      "meaning": "负责给人看清设计意图、边界和证据，不负责替代脚本或 gate 成为运行时权威。"
    }
  ],
