{
  "version": 1,
  "description": "Lifecycle policy for RedCap legacy assets, archaeology records, and ignored runtime evidence.",
  "required_actions": [
    "preserve",
    "archive",
    "translate",
    "prune-when-safe",
    "ignore-runtime"
  ],
  "assets": [
    {
      "id": "current-task-card",
      "path": ".dev-task.md",
      "kind": "active-control-plane",
      "default_action": "preserve",
      "authority": ".dev-task.md is the current task truth source; stale completed notes must be corrected, not archived silently.",
      "check_paths": [
        "compass/tools/redcap-tracking-health.sh",
        "compass/tools/redcap-layerb-closeout-runtime.sh"
      ]
    },
    {
      "id": "docs-catalog",
      "path": "compass/docs/catalog.json",
      "kind": "progressive-disclosure-index",
      "default_action": "preserve",
      "authority": "docs catalog is the first-read index for historical docs; it prevents bulk-reading task reports and specs.",
      "check_paths": [
        "compass/tools/redcap-docs-catalog.sh"
      ]
    },
    {
      "id": "task-reports",
      "path": "compass/docs/task-reports",
      "kind": "tracked-archaeology",
      "default_action": "archive",
      "authority": "task reports are historical evidence; use catalog summaries and exact reads instead of default full-history loading.",
      "check_paths": [
        "compass/tools/redcap-docs-catalog.sh",
        "compass/tools/redcap-human-output-quality-check.sh"
      ]
    },
    {
      "id": "spec-registry",
      "path": "references/spec-registry.json",
      "kind": "spec-authority-index",
      "default_action": "preserve",
      "authority": "spec authority, lifecycle status, and supersession must be tracked in the registry before specs move or retire.",
      "check_paths": [
        "compass/tools/redcap-spec-check.sh"
      ]
    },
    {
      "id": "prism-runs",
      "path": "prism/runs",
      "kind": "ignored-runtime-evidence",
      "default_action": "prune-when-safe",
      "authority": "formal and named local evidence are preserved; acceptance fixtures may be pruned only when prism-runs-lifecycle classifies them safe.",
      "check_paths": [
        "prism/tools/prism-runs-lifecycle.sh"
      ]
    },
    {
      "id": "knowledge-lessons",
      "path": "compass/knowledge/lessons.md",
      "kind": "active-knowledge",
      "default_action": "translate",
      "authority": "hot lessons stay active; cold or superseded lessons move only when the knowledge index preserves archaeology.",
      "check_paths": [
        "compass/tools/redcap-knowledge-index-check.sh",
        "compass/tools/redcap-token-risk-audit.sh"
      ]
    },
    {
      "id": "runtime-working-dirs",
      "path": "compass/.workflow",
      "kind": "ignored-local-runtime",
      "default_action": "ignore-runtime",
      "authority": "workflow/runtime directories are local state, not tracked historical truth; never bulk-read them for archaeology.",
      "check_paths": [
        "compass/tools/redcap-current-status.sh"
      ]
    }
  ],
  "prism_runs_policy": {
    "summary_command": "prism/tools/prism-runs-lifecycle.sh summary",
    "check_command": "prism/tools/prism-runs-lifecycle.sh check",
    "acceptance_fixture_target": 0,
    "preserve_classes": [
      "formal-run",
      "named-local-evidence",
      "infra-locks"
    ]
  }
}
