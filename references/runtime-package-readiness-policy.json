{
  "version": 1,
  "policy_id": "redcap-runtime-package-readiness",
  "status": "readiness-only",
  "publish_allowed": false,
  "package_manager": "npm",
  "package_name": "@norven63/redcap",
  "package_version": "0.1.0-alpha.0",
  "public_identity_status": "prepared-private-readiness",
  "license_status": "manual-before-public-publish",
  "surface_mode": "curated-runtime-readiness-surface",
  "candidate_count_target": {
    "max_before_release_task": 180,
    "reason": "Public npm candidates should contain the runnable CLI/runtime contract and release safety checks. The alpha readiness surface may temporarily include repo-governance checks required by diagnose/spec-check; the separate formal release task must decide whether to trim these into a smaller runtime profile or split a maintainer profile."
  },
  "bin": {
    "redcap": "bin/redcap"
  },
  "candidate_globs": [
    "package.json",
    "bin/redcap",
    "README.md",
    "ARCHITECTURE.md",
    "revive-cap.sh",
    "closeout-cap.sh",
    "runtime/redcap-core/**",
    "runtime/host-adapters/**",
    "compass/tools/redcap-*.sh",
    "compass/tools/redcap-*.py",
    "prism/tools/*.sh",
    "prism/tools/*.py",
    "prism/README.md",
    "references/*.json",
    "references/file-lookup-dictionary.md",
    "references/public-release-handoff.md",
    "references/redcap-system-layers.md",
    "shared-knowledge/README.md",
    "shared-knowledge/schemas/*.json"
  ],
  "exclude_globs": [
    "compass/tools/redcap-acceptance-index.*",
    "compass/tools/redcap-artifact-*",
    "compass/tools/redcap-backlog-check.sh",
    "compass/tools/redcap-check-state.sh",
    "compass/tools/redcap-claude-hook-*",
    "compass/tools/redcap-clean-workspace-e2e.*",
    "compass/tools/redcap-closure-reanchor-check.sh",
    "compass/tools/redcap-commit-message-check.py",
    "compass/tools/redcap-commit-proof-check.sh",
    "compass/tools/redcap-contributing-ia-check.sh",
    "compass/tools/redcap-ensure-git-hooks.sh",
    "compass/tools/redcap-execution-layer-split-check.*",
    "compass/tools/redcap-explore-notes-check.sh",
    "compass/tools/redcap-host-workboard-sync.sh",
    "compass/tools/redcap-information-architecture-check.*",
    "compass/tools/redcap-interop-governance.sh",
    "compass/tools/redcap-legacy-asset-*",
    "compass/tools/redcap-llm-wiki-*",
    "compass/tools/redcap-midcourse-architecture-*",
    "compass/tools/redcap-multi-session-acceptance.sh",
    "compass/tools/redcap-pre-release-structure-task-tree-check.*",
    "compass/tools/redcap-public-distillation-preflight.*",
    "compass/tools/redcap-r0-r22-registry-check.*",
    "compass/tools/redcap-reviewer-order.py",
    "compass/tools/redcap-review-proof-check.sh",
    "compass/tools/redcap-review-tracks-check.sh",
    "compass/tools/redcap-runtime-helper-check.sh",
    "compass/tools/redcap-session-*.sh",
    "compass/tools/redcap-state-machine-check.sh",
    "compass/tools/redcap-retrieval-escalation-check.*",
    "compass/tools/redcap-agent-reading-absorption-check.*",
    "compass/tools/redcap-codex-live-marker-e2e.sh",
    "compass/tools/redcap-codex-pre-tool-use.sh",
    "compass/tools/redcap-codex-session-start.sh",
    "compass/tools/redcap-codex-stop.sh",
    "compass/tools/redcap-layerB-session-end.sh",
    "compass/tools/redcap-layerB-session-start.sh",
    "compass/tools/redcap-on-qa-pass.sh",
    "compass/tools/redcap-provider-policy.sh",
    "compass/tools/redcap-evolution-grade-check.*",
    "compass/tools/redcap-forge-check.*",
    "references/agent-reading-absorption-policy.json",
    "references/clean-workspace-install-e2e.json",
    "references/evolution-grade-baseline.json",
    "references/information-architecture-artifact-governance-policy.json",
    "references/legacy-asset-*.json",
    "references/llm-wiki-*.json",
    "references/midcourse-architecture-task-tree-review.json",
    "references/pre-release-structure-refactor-task-tree.json",
    "references/public-distillation-preflight-policy.json",
    "references/redcap-r0-r22-registry.json",
    "references/redcap-holistic-smell-audit.json",
    "references/retrieval-escalation-policy.json",
    "references/review-tracks.json",
    "references/skill-lifecycle-policy.json",
    "references/spec-*.json"
  ],
  "required_files": [
    "package.json",
    "bin/redcap",
    "README.md",
    "revive-cap.sh",
    "closeout-cap.sh",
    "runtime/redcap-core/README.md",
    "runtime/redcap-core/bin/redcap",
    "runtime/redcap-core/revive-cap.sh",
    "runtime/redcap-core/closeout-cap.sh",
    "runtime/host-adapters/codex/README.md",
    "runtime/redcap-core/import-map.json",
    "references/package-publish-safety-policy.json",
    "references/runtime-package-readiness-policy.json",
    "references/public-package-surface-policy.json",
    "references/public-release-handoff.md"
  ],
  "safety_gate": "bash compass/tools/redcap-package-publish-safety-check.sh --candidate-list <generated-candidate-list>",
  "manual_release_boundaries": [
    "Public package name is prepared as @norven63/redcap, but registry ownership must still be verified during the separate release task.",
    "Distribution license selection remains a human legal/product decision before public publish.",
    "Registry tokens, signing credentials, and remote repository permissions must never be embedded in this repository.",
    "Changing publish_allowed to true requires a separate release task, package safety pass, and Prism review."
  ]
}
