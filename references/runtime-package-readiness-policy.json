{
  "version": 1,
  "policy_id": "redcap-runtime-package-readiness",
  "status": "readiness-only",
  "publish_allowed": false,
  "package_manager": "npm",
  "package_name": "@norven63/redcap",
  "package_version": "0.1.0-alpha.0",
  "public_identity_status": "prepared-private-readiness",
  "license_status": "manual-before-public-publish",
  "bin": {
    "redcap": "bin/redcap"
  },
  "candidate_globs": [
    "package.json",
    "bin/redcap",
    "README.md",
    "ARCHITECTURE.md",
    "revive-cap.sh",
    "closeout-cap.sh",
    "runtime/redcap-core/**",
    "runtime/host-adapters/**",
    "compass/tools/redcap-*.sh",
    "compass/tools/redcap-*.py",
    "prism/tools/*.sh",
    "prism/tools/*.py",
    "prism/README.md",
    "references/*.json",
    "references/file-lookup-dictionary.md",
    "references/redcap-system-layers.md",
    "shared-knowledge/README.md",
    "shared-knowledge/schemas/*.json"
  ],
  "exclude_globs": [
    "compass/tools/redcap-multi-session-acceptance.sh"
  ],
  "required_files": [
    "package.json",
    "bin/redcap",
    "README.md",
    "revive-cap.sh",
    "closeout-cap.sh",
    "runtime/redcap-core/README.md",
    "runtime/redcap-core/bin/redcap",
    "runtime/redcap-core/revive-cap.sh",
    "runtime/redcap-core/closeout-cap.sh",
    "runtime/host-adapters/codex/README.md",
    "references/package-publish-safety-policy.json",
    "references/runtime-package-readiness-policy.json",
    "references/public-package-surface-policy.json"
  ],
  "safety_gate": "bash compass/tools/redcap-package-publish-safety-check.sh --candidate-list <generated-candidate-list>",
  "manual_release_boundaries": [
    "Public package name is prepared as @norven63/redcap, but registry ownership must still be verified during the separate release task.",
    "Distribution license selection remains a human legal/product decision before public publish.",
    "Registry tokens, signing credentials, and remote repository permissions must never be embedded in this repository.",
    "Changing publish_allowed to true requires a separate release task, package safety pass, and Prism review."
  ]
}
