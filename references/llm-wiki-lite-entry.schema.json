{
  "version": 1,
  "schema_id": "llm-wiki-lite-entry",
  "type": "object",
  "required": [
    "version",
    "id",
    "title",
    "status",
    "visibility",
    "authority",
    "candidate_type",
    "privacy_classification",
    "source_anchors",
    "summary",
    "body",
    "forge_promotion"
  ],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "title": {"type": "string", "minLength": 2},
    "status": {"type": "string", "enum": ["active", "stale", "retired"]},
    "visibility": {"type": "string", "enum": ["private"]},
    "authority": {"type": "string", "const": "non-authoritative-derived-context"},
    "candidate_type": {"type": "string"},
    "privacy_classification": {"type": "string", "enum": ["public", "internal", "private", "sensitive"]},
    "source_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_path",
          "source_kind",
          "commit_sha_or_digest",
          "last_reviewed_at",
          "privacy_classification"
        ]
      }
    },
    "summary": {"type": "string", "minLength": 10},
    "body": {"type": "string", "minLength": 20},
    "forge_promotion": {
      "type": "object",
      "required": ["status", "requires_forge", "public_write_allowed"]
    }
  },
  "additionalProperties": false
}
