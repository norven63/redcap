{
  "version": 1,
  "description": "Layer B policy for handling user requirements inserted during an already-running task. The policy turns mid-task changes into a ledger, a replan gate, and a parent/child completion guard. Inserted user changes are referenced as Markdown headings like '### U1', '### U2', etc.",
  "ledger_section": "中插需求账本",
  "replan_decision_section": "中插需求重排决策摘要",
  "continuation_intent_section": "续接/中插任务意图确认",
  "continuation_trigger_phrases": [
    "继续",
    "接下来",
    "下一步",
    "按照计划",
    "按计划",
    "把计划执行干净",
    "按照你们的计划",
    "你们按照",
    "继续推进",
    "稳步推进",
    "开始吧"
  ],
  "required_continuation_fields": [
    "续接锚点",
    "锚点来源",
    "选定执行范围",
    "未执行范围",
    "是否抢占旧任务线",
    "决策理由",
    "用户可见边界"
  ],
  "allowed_continuation_anchor_sources": [
    "current-conversation",
    "dev-task",
    "runtime-state",
    "parent-ledger",
    "task-report",
    "backlog",
    "prism-review"
  ],
  "continuation_takeover_markers": [
    "yes",
    "是",
    "替换",
    "抢占",
    "不继续",
    "不再继续"
  ],
  "continuation_old_task_markers": [
    "旧任务",
    "旧任务线",
    "上一轮",
    "上一步",
    "已关闭",
    "不继续",
    "不再继续",
    "task_id",
    "redcap-"
  ],
  "required_columns": [
    "id",
    "触发",
    "类型",
    "阻塞当前任务",
    "优先级",
    "处理方式",
    "确认需求更新",
    "计划更新",
    "验收更新",
    "状态",
    "证据"
  ],
  "allowed_types": [
    "authorization",
    "new-requirement",
    "correction",
    "constraint-change",
    "priority-change",
    "scope-change",
    "status-question",
    "bug-report",
    "control-plane-defect"
  ],
  "allowed_priorities": ["P0", "P1", "P2", "P3"],
  "allowed_blocking_values": ["yes", "no"],
  "allowed_update_values": ["yes", "no", "n/a"],
  "allowed_dispositions": [
    "merge-current",
    "split-child",
    "replace-scope",
    "defer-followup",
    "reject-out-of-scope"
  ],
  "allowed_statuses": [
    "captured",
    "replanning",
    "integrated",
    "split",
    "deferred",
    "rejected",
    "superseded",
    "blocked"
  ],
  "resolved_statuses": ["integrated", "split", "deferred", "rejected", "superseded"],
  "open_statuses": ["captured", "replanning", "blocked"],
  "terminal_active_slices": ["task-complete", "closeout-complete", "completed"],
  "change_states": ["CHANGE_INTAKE", "REPLAN_REVIEW", "RESUME_EXECUTING"],
  "disposition_rules": {
    "merge-current": {
      "requires_confirmed_update": true,
      "requires_plan_update": true,
      "requires_acceptance_update": true,
      "terminal_status": "integrated"
    },
    "replace-scope": {
      "requires_confirmed_update": true,
      "requires_plan_update": true,
      "requires_acceptance_update": true,
      "terminal_status": "integrated"
    },
    "split-child": {
      "requires_confirmed_update": true,
      "requires_plan_update": true,
      "requires_acceptance_update": false,
      "terminal_status": "split",
      "requires_child_evidence": true
    },
    "defer-followup": {
      "requires_confirmed_update": false,
      "requires_plan_update": true,
      "requires_acceptance_update": false,
      "terminal_status": "deferred"
    },
    "reject-out-of-scope": {
      "requires_confirmed_update": false,
      "requires_plan_update": true,
      "requires_acceptance_update": false,
      "terminal_status": "rejected"
    }
  },
  "parent_completion_claim_values": ["none", "child-only", "parent-complete"],
  "required_replan_decision_fields": [
    "处置",
    "决策理由",
    "全景影响",
    "用户可见表达"
  ],
  "replan_decision_rule": "Every U<n> row in the inserted-requirement ledger must have a matching subsection under ## 中插需求重排决策摘要. The subsection must state the disposition, why that disposition is justified, how it affects the parent/task panorama, and what should be visible to the user."
}
