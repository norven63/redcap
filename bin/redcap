#!/usr/bin/env bash
# Thin RedCap CLI facade. Keep logic in repo-owned tools; this file only routes.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$SOURCE_DIR/$TARGET"
  fi
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REDCAP_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REDCAP_RUNTIME_ROOT="$REDCAP_ROOT"
REDCAP_TRACE="${REDCAP_TRACE:-0}"
REDCAP_CMD_REMAINING_ARGS=()

redcap_error() {
  local cause="$1"
  local impact="$2"
  local suggested_action="$3"
  local exit_code="${4:-2}"

  {
    echo "RedCap error"
    echo "cause: $cause"
    echo "impact: $impact"
    echo "suggested_action: $suggested_action"
  } >&2
  exit "$exit_code"
}

path_inside() {
  local child="$1"
  local parent="$2"
  [[ "$child/" == "$parent/"* ]]
}

default_workspace_root() {
  local cursor

  cursor="$(pwd -P)"
  if path_inside "$cursor" "$REDCAP_ROOT"; then
    printf '%s\n' "$REDCAP_ROOT"
    return
  fi

  while [[ "$cursor" != "/" ]]; do
    if [[ -f "$cursor/.dev-task.md" ]]; then
      printf '%s\n' "$cursor"
      return
    fi
    cursor="$(dirname "$cursor")"
  done

  printf '%s\n' "$(pwd -P)"
}

abs_dir() {
  local dir="$1"
  if ! cd -P "$dir" >/dev/null 2>&1; then
    redcap_error \
      "workspace directory not found: $dir" \
      "RedCap cannot decide which project task card or state to use." \
      "Pass an existing directory with --workspace <dir>, or run from the managed project root."
  fi
  pwd
}

abs_file_from_workspace() {
  local file="$1"
  local workspace="$2"
  local candidate dir base

  if [[ "$file" == /* ]]; then
    candidate="$file"
  else
    candidate="$workspace/$file"
  fi

  dir="$(dirname "$candidate")"
  base="$(basename "$candidate")"
  if ! cd -P "$dir" >/dev/null 2>&1; then
    redcap_error \
      "task-file directory not found: $dir" \
      "RedCap cannot read the selected project task card." \
      "Create the directory or pass a valid --task-file path."
  fi
  printf '%s/%s\n' "$(pwd)" "$base"
}

resolve_workspace_task_args() {
  local workspace="${REDCAP_WORKSPACE:-}"
  local task_file=""
  REDCAP_CMD_REMAINING_ARGS=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --workspace)
        if [[ $# -lt 2 ]]; then
          redcap_error \
            "--workspace requires a value" \
            "RedCap cannot resolve the managed project workspace." \
            "Use --workspace <dir>, for example: redcap doctor --workspace ."
        fi
        workspace="$2"
        shift 2
        ;;
      --workspace=*)
        workspace="${1#--workspace=}"
        shift
        ;;
      --task-file)
        if [[ $# -lt 2 ]]; then
          redcap_error \
            "--task-file requires a value" \
            "RedCap cannot resolve the task card for this command." \
            "Use --task-file <file>, or omit it to use <workspace>/.dev-task.md."
        fi
        task_file="$2"
        shift 2
        ;;
      --task-file=*)
        task_file="${1#--task-file=}"
        shift
        ;;
      --)
        shift
        while [[ $# -gt 0 ]]; do
          if [[ "$1" == "--trace" ]]; then
            REDCAP_TRACE=1
          elif [[ -z "$task_file" ]]; then
            task_file="$1"
          else
            REDCAP_CMD_REMAINING_ARGS+=("$1")
          fi
          shift
        done
        ;;
      -*)
        if [[ "$1" == "--trace" ]]; then
          REDCAP_TRACE=1
        else
          REDCAP_CMD_REMAINING_ARGS+=("$1")
        fi
        shift
        ;;
      *)
        if [[ -z "$task_file" ]]; then
          task_file="$1"
        else
          REDCAP_CMD_REMAINING_ARGS+=("$1")
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$workspace" ]]; then
    workspace="$(default_workspace_root)"
  fi
  if [[ -z "$task_file" && -n "${REDCAP_TASK_FILE:-}" ]]; then
    task_file="$REDCAP_TASK_FILE"
  fi

  REDCAP_CMD_WORKSPACE_ROOT="$(abs_dir "$workspace")"
  if [[ -z "$task_file" ]]; then
    REDCAP_CMD_TASK_FILE="$REDCAP_CMD_WORKSPACE_ROOT/.dev-task.md"
  else
    REDCAP_CMD_TASK_FILE="$(abs_file_from_workspace "$task_file" "$REDCAP_CMD_WORKSPACE_ROOT")"
  fi

  export REDCAP_RUNTIME_ROOT
  export REDCAP_WORKSPACE_ROOT="$REDCAP_CMD_WORKSPACE_ROOT"
  export REDCAP_TASK_FILE="$REDCAP_CMD_TASK_FILE"
}

resolve_workspace_options_only() {
  local workspace="${REDCAP_WORKSPACE:-}"
  local task_file=""
  REDCAP_CMD_REMAINING_ARGS=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --workspace)
        if [[ $# -lt 2 ]]; then
          redcap_error \
            "--workspace requires a value" \
            "RedCap cannot resolve the managed project workspace." \
            "Use --workspace <dir>, for example: redcap closeout status --workspace ."
        fi
        workspace="$2"
        shift 2
        ;;
      --workspace=*)
        workspace="${1#--workspace=}"
        shift
        ;;
      --task-file)
        if [[ $# -lt 2 ]]; then
          redcap_error \
            "--task-file requires a value" \
            "RedCap cannot resolve the task card for this command." \
            "Use --task-file <file>, or omit it to use <workspace>/.dev-task.md."
        fi
        task_file="$2"
        shift 2
        ;;
      --task-file=*)
        task_file="${1#--task-file=}"
        shift
        ;;
      --trace)
        REDCAP_TRACE=1
        shift
        ;;
      *)
        REDCAP_CMD_REMAINING_ARGS+=("$1")
        shift
        ;;
    esac
  done

  if [[ -z "$workspace" ]]; then
    workspace="$(default_workspace_root)"
  fi
  if [[ -z "$task_file" && -n "${REDCAP_TASK_FILE:-}" ]]; then
    task_file="$REDCAP_TASK_FILE"
  fi

  REDCAP_CMD_WORKSPACE_ROOT="$(abs_dir "$workspace")"
  if [[ -z "$task_file" ]]; then
    REDCAP_CMD_TASK_FILE="$REDCAP_CMD_WORKSPACE_ROOT/.dev-task.md"
  else
    REDCAP_CMD_TASK_FILE="$(abs_file_from_workspace "$task_file" "$REDCAP_CMD_WORKSPACE_ROOT")"
  fi
  REDCAP_CMD_REMAINING_ARGS+=(--task-file "$REDCAP_CMD_TASK_FILE")

  export REDCAP_RUNTIME_ROOT
  export REDCAP_WORKSPACE_ROOT="$REDCAP_CMD_WORKSPACE_ROOT"
  export REDCAP_TASK_FILE="$REDCAP_CMD_TASK_FILE"
}

emit_trace() {
  local traced_command="$1"
  local delegated_to="$2"
  if [[ "$REDCAP_TRACE" != "1" ]]; then
    return 0
  fi
  bash "$REDCAP_ROOT/compass/tools/redcap-cli-product-surface.sh" trace \
    --runtime-root "$REDCAP_RUNTIME_ROOT" \
    --workspace-root "$REDCAP_CMD_WORKSPACE_ROOT" \
    --task-file "$REDCAP_CMD_TASK_FILE" \
    --traced-command "$traced_command" \
    --delegated-to "$delegated_to"
}

usage() {
  cat <<'EOF'
usage: redcap <command> [args...]

commands:
  revive                 run ./revive-cap.sh
  status                 show current RedCap status for the workspace
  diagnose               run the diagnostic overview for the workspace
  doctor                 explain CLI health in human-readable product language
  debug                  emit a redacted diagnostic packet for support or Agent containers
  closeout               route to ./closeout-cap.sh for the workspace task file
  prism-availability     inspect or refresh Prism agent availability
  file-dictionary        validate the File Lookup Dictionary
  shared-knowledge       manage the shared knowledge repository template
  publish-safety         audit package candidate files before public release
  package-manifest       generate/check runtime package candidate files
  package-surface        validate public package identity and surface readiness
  pre-release-review     validate product-architecture blockers before release readiness
  change-intake          validate mid-task inserted requirement handling
  version                print RedCap package version
  help                   show command-specific help

workspace options for status/diagnose/change-intake/closeout:
  --workspace <dir>      managed project workspace (default: current directory)
  --task-file <file>     task file path (default: <workspace>/.dev-task.md)
  --trace                explain command routing without dumping env or secrets
  REDCAP_WORKSPACE       optional workspace env fallback when no flag is given
  REDCAP_TASK_FILE       optional task-file env fallback when no flag is given
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --trace)
      REDCAP_TRACE=1
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

COMMAND="${1:-}"
if [[ -z "$COMMAND" ]]; then
  usage >&2
  redcap_error \
    "missing command" \
    "RedCap does not know which workflow action to run." \
    "Run redcap help to list commands, or try redcap doctor."
fi
shift || true

case "$COMMAND" in
  revive)
    REDCAP_CMD_WORKSPACE_ROOT="$(default_workspace_root)"
    REDCAP_CMD_TASK_FILE="$REDCAP_CMD_WORKSPACE_ROOT/.dev-task.md"
    emit_trace "revive" "$REDCAP_ROOT/revive-cap.sh"
    exec "$REDCAP_ROOT/revive-cap.sh" "$@"
    ;;
  status)
    resolve_workspace_task_args "$@"
    emit_trace "status" "$REDCAP_ROOT/compass/tools/redcap-current-status.sh"
    if [[ "${#REDCAP_CMD_REMAINING_ARGS[@]}" -gt 0 ]]; then
      exec bash "$REDCAP_ROOT/compass/tools/redcap-current-status.sh" "$REDCAP_CMD_TASK_FILE" "${REDCAP_CMD_REMAINING_ARGS[@]}"
    fi
    exec bash "$REDCAP_ROOT/compass/tools/redcap-current-status.sh" "$REDCAP_CMD_TASK_FILE"
    ;;
  diagnose)
    resolve_workspace_task_args "$@"
    emit_trace "diagnose" "$REDCAP_ROOT/compass/tools/redcap-diagnose.sh"
    if [[ "${#REDCAP_CMD_REMAINING_ARGS[@]}" -gt 0 ]]; then
      exec bash "$REDCAP_ROOT/compass/tools/redcap-diagnose.sh" "$REDCAP_CMD_TASK_FILE" "${REDCAP_CMD_REMAINING_ARGS[@]}"
    fi
    exec bash "$REDCAP_ROOT/compass/tools/redcap-diagnose.sh" "$REDCAP_CMD_TASK_FILE"
    ;;
  doctor)
    resolve_workspace_task_args "$@"
    emit_trace "doctor" "$REDCAP_ROOT/compass/tools/redcap-cli-product-surface.sh"
    if [[ "${#REDCAP_CMD_REMAINING_ARGS[@]}" -gt 0 ]]; then
      exec bash "$REDCAP_ROOT/compass/tools/redcap-cli-product-surface.sh" doctor \
        --runtime-root "$REDCAP_RUNTIME_ROOT" \
        --workspace-root "$REDCAP_CMD_WORKSPACE_ROOT" \
        --task-file "$REDCAP_CMD_TASK_FILE" \
        "${REDCAP_CMD_REMAINING_ARGS[@]}"
    fi
    exec bash "$REDCAP_ROOT/compass/tools/redcap-cli-product-surface.sh" doctor \
      --runtime-root "$REDCAP_RUNTIME_ROOT" \
      --workspace-root "$REDCAP_CMD_WORKSPACE_ROOT" \
      --task-file "$REDCAP_CMD_TASK_FILE"
    ;;
  debug)
    resolve_workspace_task_args "$@"
    emit_trace "debug" "$REDCAP_ROOT/compass/tools/redcap-cli-product-surface.sh"
    if [[ "${#REDCAP_CMD_REMAINING_ARGS[@]}" -gt 0 ]]; then
      exec bash "$REDCAP_ROOT/compass/tools/redcap-cli-product-surface.sh" debug \
        --runtime-root "$REDCAP_RUNTIME_ROOT" \
        --workspace-root "$REDCAP_CMD_WORKSPACE_ROOT" \
        --task-file "$REDCAP_CMD_TASK_FILE" \
        "${REDCAP_CMD_REMAINING_ARGS[@]}"
    fi
    exec bash "$REDCAP_ROOT/compass/tools/redcap-cli-product-surface.sh" debug \
      --runtime-root "$REDCAP_RUNTIME_ROOT" \
      --workspace-root "$REDCAP_CMD_WORKSPACE_ROOT" \
      --task-file "$REDCAP_CMD_TASK_FILE"
    ;;
  closeout)
    resolve_workspace_options_only "$@"
    emit_trace "closeout" "$REDCAP_ROOT/closeout-cap.sh"
    exec "$REDCAP_ROOT/closeout-cap.sh" "${REDCAP_CMD_REMAINING_ARGS[@]}"
    ;;
  prism-availability)
    exec bash "$REDCAP_ROOT/prism/tools/prism-availability.sh" "${1:-status}" "${@:2}"
    ;;
  file-dictionary)
    exec bash "$REDCAP_ROOT/compass/tools/redcap-file-lookup-dictionary-check.sh" "$@"
    ;;
  shared-knowledge)
    exec bash "$REDCAP_ROOT/compass/tools/redcap-shared-knowledge.sh" "$@"
    ;;
  publish-safety)
    exec bash "$REDCAP_ROOT/compass/tools/redcap-package-publish-safety-check.sh" "$@"
    ;;
  package-manifest)
    exec bash "$REDCAP_ROOT/compass/tools/redcap-runtime-package-manifest.sh" "$@"
    ;;
  package-surface)
    exec bash "$REDCAP_ROOT/compass/tools/redcap-public-package-surface.sh" "$@"
    ;;
  pre-release-review)
    exec bash "$REDCAP_ROOT/compass/tools/redcap-pre-release-product-architecture-check.sh" "$@"
    ;;
  change-intake)
    resolve_workspace_task_args "$@"
    emit_trace "change-intake" "$REDCAP_ROOT/compass/tools/redcap-change-intake-check.sh"
    if [[ "${#REDCAP_CMD_REMAINING_ARGS[@]}" -gt 0 ]]; then
      exec bash "$REDCAP_ROOT/compass/tools/redcap-change-intake-check.sh" "$REDCAP_CMD_TASK_FILE" "${REDCAP_CMD_REMAINING_ARGS[@]}"
    fi
    exec bash "$REDCAP_ROOT/compass/tools/redcap-change-intake-check.sh" "$REDCAP_CMD_TASK_FILE"
    ;;
  help|-h|--help)
    topic="${1:-}"
    exec bash "$REDCAP_ROOT/compass/tools/redcap-cli-product-surface.sh" help --topic "$topic"
    ;;
  version|-v|--version)
    python3 - "$REDCAP_ROOT/package.json" <<'PY'
import json
import sys
from pathlib import Path

package_json = Path(sys.argv[1])
payload = json.loads(package_json.read_text(encoding="utf-8"))
print(payload.get("version", "unknown"))
PY
    ;;
  *)
    suggestion="Run redcap help to list commands."
    case "$COMMAND" in
      docter) suggestion="Did you mean: redcap doctor ?" ;;
      stauts) suggestion="Did you mean: redcap status ?" ;;
      debg) suggestion="Did you mean: redcap debug ?" ;;
      diagnoze) suggestion="Did you mean: redcap diagnose ?" ;;
    esac
    redcap_error \
      "unknown command: $COMMAND" \
      "RedCap cannot route this request to a workflow action." \
      "$suggestion"
    ;;
esac
