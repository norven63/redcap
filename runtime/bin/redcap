#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PRISM="$REPO_ROOT/runtime/prism/bin/prism"

usage() {
  cat <<'USAGE'
Usage:
  runtime/bin/redcap gate [--task TEXT|--request FILE] [--risk-level LEVEL]
  runtime/bin/redcap intake [--task TEXT|--request FILE] [--risk-level LEVEL]
  runtime/bin/redcap enforcement-check
  runtime/bin/redcap hook-coverage-check
  runtime/bin/redcap boundary resolve|check|init|self-check [...]
  runtime/bin/redcap boundary-consumers check|self-check [...]
  runtime/bin/redcap archaeology extract-boundary|seed|check|self-check [...]
  runtime/bin/redcap lifecycle check|self-check [...]
  runtime/bin/redcap final-claim check|self-check [...]
  runtime/bin/redcap phase2-blueprint check|self-check [...]
  runtime/bin/redcap full-revival-amendment check|self-check [...]
  runtime/bin/redcap e2e-trace check|self-check [...]
  runtime/bin/redcap fsm check|status|transition [...]
  runtime/bin/redcap loom-workflow check|self-check [...]
  runtime/bin/redcap knowledge-gateway check|search [...]
  runtime/bin/redcap evidence-restore restore [...]
  runtime/bin/redcap legacy-evidence check|plan|restore|self-check [...]
  runtime/bin/redcap session-ownership claim|check|self-check [...]
  runtime/bin/redcap host-hook-audit
  runtime/bin/redcap prism-dispatch [...]
  runtime/bin/redcap prism-resolution [...]
  runtime/bin/redcap prism-rebuttal-request [...]
  runtime/bin/redcap prism-ledger [...]
  runtime/bin/redcap task-facts record|summary|check|self-check [...]
  runtime/bin/redcap terminal-goal check|context|self-check [...]
  runtime/bin/redcap human-output check|self-check|lint-text|lint-file [...]
  runtime/bin/redcap prism-shard [...]
  runtime/bin/redcap scan-conclusion check|self-check [...]
  runtime/bin/redcap intent-judge classify|self-check [...]
  runtime/bin/redcap soul-load check|load|self-check [...]
  runtime/bin/redcap status [...]
  runtime/bin/redcap revive [...]
  runtime/bin/redcap revival-queue check|self-check [...]
  runtime/bin/redcap known-issues-order check|self-check [...]
  runtime/bin/redcap known-issues-queue check|self-check [...]
  runtime/bin/redcap formal-usable-check [--skip-host-hook-audit]
  runtime/bin/redcap complete-revival-check [--require-terminal-verified] [--skip-host-hook-audit]
  runtime/bin/redcap temporary-usable-check
  runtime/bin/redcap process-artifacts check|self-check [...]
  runtime/bin/redcap layout-check [check|self-check]
  runtime/bin/redcap check

Commands:
  gate          Run deterministic Prism rule review.
  intake        Run gate and exit 2 when full Prism is required.
  enforcement-check
                Verify the protocol/workflow enforcement matrix with probes.
  hook-coverage-check
                Verify required guardrails have deployed host hook coverage.
  boundary      Resolve and verify runtime/project/user-private boundaries.
  boundary-consumers
                Verify runtime-writing commands use the project-level .redcap boundary.
  archaeology   Run bounded old-RedCap archaeology shard extraction.
  lifecycle     Validate development lifecycle evidence against the FSM.
  final-claim   Guard final completion claims against task-body evidence.
  phase2-blueprint
                Validate the RedCap 1.1 Phase 2 blueprint contract.
  full-revival-amendment
                Verify that full revival cannot be reduced to a minimum kernel.
  e2e-trace     Run the RedCap 1.0 hook/session/FSM/completion trace.
  fsm           Run the RedCap workflow FSM kernel.
  loom-workflow Verify the role-based Loom engineering workflow contract.
  knowledge-gateway
                Run the minimal index-first RedCap knowledge gateway.
  evidence-restore
                Restore bounded generated evidence through a RedCap-owned writer.
  legacy-evidence
                Check, plan, or restore old external RedCap evidence safely.
  session-ownership
                Run the minimal RedCap host/session ownership kernel.
  host-hook-audit
                Audit current host hook and provider-call interception coverage.
  prism-dispatch
                Dispatch a Prism provider review through the enforced dispatcher.
  prism-resolution
                Verify accept/reject/escalate resolution for Prism concern/block verdicts.
  prism-rebuttal-request
                Generate a bounded same-provider rebuttal request for a rejected concern.
  prism-ledger  Record and summarize Prism task execution health.
  task-facts    Record and summarize RedCap task fact status.
  terminal-goal
                Guard terminal objectives so phase achievements cannot close parent goals.
  human-output  Check Chinese-first human-facing output policy.
  prism-shard   Validate and merge bounded Prism long-task shard accounts.
  scan-conclusion
                Guard 360-degree old RedCap scan conclusions with structured scan facts.
  intent-judge  Classify prompt intent with deterministic rules and bounded Prism LLM fallback.
  soul-load     Load or verify Cap identity sources without leaking private text.
  status        Show the human-facing RedCap status surface.
  revive        Load Cap identity and show the revival status surface.
  revival-queue Check the executable RedCap revival implementation queue.
  known-issues-order
                Check the ordered queue for known remaining RedCap issues.
  known-issues-queue
                Check known remaining RedCap issue statuses and deferrals.
  formal-usable-check
                Verify RedCap formal usability through user-facing workflows.
  complete-revival-check
                Verify RedCap complete-revival terminal acceptance.
  temporary-usable-check
                Verify the current scaffold is usable enough for revival work.
  process-artifacts
                Verify one-turn process artifacts are kept out of stable contracts.
  layout-check  Verify directory policy, root thinness, and unit boundaries.
  check         Run Prism, FSM, knowledge, and layout checks.
USAGE
}

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
  usage
  exit 2
fi
shift

case "$cmd" in
  gate)
    exec "$PRISM" gate "$@"
    ;;
  intake)
    exec "$PRISM" gate --fail-when-required "$@"
    ;;
  enforcement-check)
    exec "$REPO_ROOT/runtime/prism/bin/enforcement-check" "$@"
    ;;
  hook-coverage-check)
    exec "$REPO_ROOT/runtime/prism/bin/hook-coverage-check" "$@"
    ;;
  boundary)
    exec python3 "$REPO_ROOT/runtime/core/runtime_boundary.py" "$@"
    ;;
  boundary-consumers)
    exec python3 "$REPO_ROOT/runtime/core/runtime_boundary_consumers.py" "$@"
    ;;
  archaeology)
    exec python3 "$REPO_ROOT/runtime/core/archaeology_shards.py" "$@"
    ;;
  lifecycle)
    exec python3 "$REPO_ROOT/runtime/core/development_lifecycle.py" "$@"
    ;;
  final-claim)
    exec python3 "$REPO_ROOT/runtime/core/final_claim_guard.py" "$@"
    ;;
  phase2-blueprint)
    exec python3 "$REPO_ROOT/runtime/core/phase2_blueprint.py" "$@"
    ;;
  full-revival-amendment)
    exec python3 "$REPO_ROOT/runtime/core/full_revival_amendment.py" "$@"
    ;;
  e2e-trace)
    exec python3 "$REPO_ROOT/runtime/core/e2e_trace.py" "$@"
    ;;
  fsm)
    exec python3 "$REPO_ROOT/runtime/core/fsm.py" "$@"
    ;;
  fsm-check)
    exec python3 "$REPO_ROOT/runtime/core/fsm.py" check "$@"
    ;;
  loom-workflow)
    exec python3 "$REPO_ROOT/runtime/core/loom_workflow.py" "$@"
    ;;
  knowledge-gateway)
    exec python3 "$REPO_ROOT/runtime/core/knowledge_gateway.py" "$@"
    ;;
  knowledge-gateway-check)
    exec python3 "$REPO_ROOT/runtime/core/knowledge_gateway.py" check "$@"
    ;;
  evidence-restore)
    exec python3 "$REPO_ROOT/runtime/core/evidence_restore.py" "$@"
    ;;
  legacy-evidence)
    exec python3 "$REPO_ROOT/runtime/core/legacy_evidence_policy.py" "$@"
    ;;
  session-ownership)
    exec python3 "$REPO_ROOT/runtime/core/session_ownership.py" "$@"
    ;;
  session-ownership-check)
    exec python3 "$REPO_ROOT/runtime/core/session_ownership.py" self-check "$@"
    ;;
  host-hook-audit)
    exec python3 "$REPO_ROOT/runtime/host-adapters/host-hook-audit.py" "$@"
    ;;
  prism-dispatch)
    exec "$REPO_ROOT/runtime/prism/bin/prism-dispatch" "$@"
    ;;
  prism-resolution)
    exec "$PRISM" resolution-check "$@"
    ;;
  prism-rebuttal-request)
    exec "$PRISM" rebuttal-request "$@"
    ;;
  prism-ledger)
    exec "$REPO_ROOT/runtime/prism/bin/prism-ledger" "$@"
    ;;
  task-facts)
    exec python3 "$REPO_ROOT/runtime/core/task_facts.py" "$@"
    ;;
  terminal-goal)
    exec python3 "$REPO_ROOT/runtime/core/terminal_goal_guard.py" "$@"
    ;;
  human-output)
    exec python3 "$REPO_ROOT/runtime/core/human_output_policy.py" "$@"
    ;;
  prism-shard)
    exec python3 "$REPO_ROOT/runtime/prism/bin/prism-shard" "$@"
    ;;
  scan-conclusion)
    exec python3 "$REPO_ROOT/runtime/core/scan_conclusion_guard.py" "$@"
    ;;
  intent-judge)
    exec python3 "$REPO_ROOT/runtime/core/intent_judge.py" "$@"
    ;;
  soul-load)
    exec python3 "$REPO_ROOT/runtime/core/soul_loader.py" "$@"
    ;;
  status)
    exec python3 "$REPO_ROOT/runtime/core/status_surface.py" status "$@"
    ;;
  revive)
    exec python3 "$REPO_ROOT/runtime/core/status_surface.py" revive "$@"
    ;;
  revival-queue)
    exec python3 "$REPO_ROOT/runtime/core/revival_queue.py" "$@"
    ;;
  known-issues-order)
    exec python3 "$REPO_ROOT/runtime/core/known_issues_order.py" "$@"
    ;;
  known-issues-queue)
    exec python3 "$REPO_ROOT/runtime/core/known_issues_queue.py" "$@"
    ;;
  formal-usable-check)
    exec python3 "$REPO_ROOT/runtime/core/formal_usable_check.py" check "$@"
    ;;
  complete-revival-check)
    exec python3 "$REPO_ROOT/runtime/core/complete_revival_check.py" check "$@"
    ;;
  temporary-usable-check)
    exec python3 "$REPO_ROOT/runtime/core/temporary_usable_check.py" "$@"
    ;;
  process-artifacts)
    exec python3 "$REPO_ROOT/runtime/core/process_artifact_placement.py" "$@"
    ;;
  layout-check)
    exec python3 "$REPO_ROOT/runtime/core/layout_guard.py" "$@"
    ;;
  check)
    "$PRISM" check
    "$REPO_ROOT/runtime/bin/redcap" prism-resolution --self-check
    "$REPO_ROOT/runtime/bin/redcap" prism-shard self-check
    "$REPO_ROOT/runtime/bin/redcap" task-facts self-check
    "$REPO_ROOT/runtime/bin/redcap" task-facts check
    "$REPO_ROOT/runtime/bin/redcap" terminal-goal self-check
    "$REPO_ROOT/runtime/bin/redcap" terminal-goal check
    "$REPO_ROOT/runtime/bin/redcap" human-output check
    "$REPO_ROOT/runtime/bin/redcap" human-output self-check
    "$REPO_ROOT/runtime/bin/redcap" scan-conclusion self-check
    "$REPO_ROOT/runtime/bin/redcap" known-issues-order check
    "$REPO_ROOT/runtime/bin/redcap" known-issues-queue check --require-1-4-verified
    "$REPO_ROOT/runtime/bin/redcap" boundary-consumers check
    "$REPO_ROOT/runtime/bin/redcap" legacy-evidence check
    "$REPO_ROOT/runtime/bin/redcap" legacy-evidence self-check
    "$REPO_ROOT/runtime/bin/redcap" process-artifacts check
    "$REPO_ROOT/runtime/bin/redcap" process-artifacts self-check
    "$REPO_ROOT/runtime/bin/redcap" status --json --require-scan-complete
    "$REPO_ROOT/runtime/bin/redcap" revive --json --no-write-evidence --require-scan-complete
    python3 "$REPO_ROOT/runtime/core/status_surface.py" self-check
    "$REPO_ROOT/runtime/bin/redcap" revival-queue self-check
    "$REPO_ROOT/runtime/bin/redcap" revival-queue check --skip-heavy-host-audit
    python3 "$REPO_ROOT/runtime/core/formal_usable_check.py" self-check
    python3 "$REPO_ROOT/runtime/core/complete_revival_check.py" self-check
    "$REPO_ROOT/runtime/bin/redcap" session-ownership self-check
    "$REPO_ROOT/runtime/bin/redcap" intent-judge self-check
    python3 "$REPO_ROOT/runtime/host-adapters/codex/codex-hook.py" --self-check-intent-judge
    "$REPO_ROOT/runtime/bin/redcap" host-hook-audit
    "$REPO_ROOT/runtime/bin/redcap" prism-dispatch --timeout-policy-check
    python3 "$REPO_ROOT/runtime/prism/bin/prism-dispatch-timeout-e2e"
    "$REPO_ROOT/runtime/bin/redcap" boundary check
    "$REPO_ROOT/runtime/bin/redcap" boundary self-check
    "$REPO_ROOT/runtime/bin/redcap" archaeology check
    "$REPO_ROOT/runtime/bin/redcap" archaeology self-check
    "$REPO_ROOT/runtime/bin/redcap" lifecycle self-check
    "$REPO_ROOT/runtime/bin/redcap" final-claim self-check
    "$REPO_ROOT/runtime/bin/redcap" phase2-blueprint check
    "$REPO_ROOT/runtime/bin/redcap" phase2-blueprint self-check
    "$REPO_ROOT/runtime/bin/redcap" full-revival-amendment self-check
    "$REPO_ROOT/runtime/bin/redcap" full-revival-amendment check
    "$REPO_ROOT/runtime/bin/redcap" e2e-trace self-check
    "$REPO_ROOT/runtime/bin/redcap" fsm check
    "$REPO_ROOT/runtime/bin/redcap" loom-workflow self-check
    "$REPO_ROOT/runtime/bin/redcap" loom-workflow check
    "$REPO_ROOT/runtime/bin/redcap" knowledge-gateway check
    "$REPO_ROOT/runtime/bin/redcap" knowledge-gateway self-check
    python3 "$REPO_ROOT/runtime/core/revival_loop.py" check
    python3 "$REPO_ROOT/runtime/core/revival_loop.py" self-check
    "$REPO_ROOT/runtime/bin/redcap" soul-load check
    "$REPO_ROOT/runtime/bin/redcap" soul-load self-check
    "$REPO_ROOT/runtime/bin/redcap" layout-check
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
