#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PRISM="$REPO_ROOT/runtime/prism/bin/prism"

usage() {
  cat <<'USAGE'
Usage:
  runtime/bin/redcap gate [--task TEXT|--request FILE] [--risk-level LEVEL]
  runtime/bin/redcap intake [--task TEXT|--request FILE] [--risk-level LEVEL]
  runtime/bin/redcap enforcement-check
  runtime/bin/redcap hook-coverage-check
  runtime/bin/redcap boundary resolve|check|init|self-check [...]
  runtime/bin/redcap boundary-consumers check|self-check [...]
  runtime/bin/redcap archaeology extract-boundary|seed|check|self-check [...]
  runtime/bin/redcap lifecycle check|self-check [...]
  runtime/bin/redcap final-claim check|self-check [...]
  runtime/bin/redcap phase2-blueprint check|self-check [...]
  runtime/bin/redcap full-revival-amendment check|self-check [...]
  runtime/bin/redcap e2e-trace check|self-check [...]
  runtime/bin/redcap complete-revival-e2e design-check|codex-isolation-check|prepare|preflight|preflight-regression-test|carrier-probe|convergence-check|convergence-guard-check|prune-runs|prune-check|report-check|external-sample-check|contract-map-check|harness-timeout-regression-test|runner-negative-probe-regression-test|run|finalize-existing|self-check [...]
  runtime/bin/redcap ol11 plan-check|self-check|trpg-carrier-dry-run [...]
  runtime/bin/redcap fsm check|status|transition [...]
  runtime/bin/redcap loom-workflow check|self-check [...]
  runtime/bin/redcap loom-runtime init|record-session|import-hook-events|manifest-check|failure-route|role-chain-check|session-check|real-sample-check|real-sample-generate|self-check [...]
  runtime/bin/redcap loom role-chain-check|session-check|real-sample-check|real-sample-generate [...]
  runtime/bin/redcap loom-external-sample-audit check|self-check [...]
  runtime/bin/redcap forge check|self-check [...]
  runtime/bin/redcap arsenal check|self-check [...]
  runtime/bin/redcap project-install check|package|audit-package|release-check|init|matrix-check|production-readiness-check|self-check [...]
  runtime/bin/redcap knowledge-gateway check|search|impact-check|draft|review|promote|self-check [...]
  runtime/bin/redcap knowledge-quality check|self-check [...]
  runtime/bin/redcap self-purification check|run-loop|loop-check|self-check [...]
  runtime/bin/redcap persona-observation check|self-check [...]
  runtime/bin/redcap evidence-restore restore [...]
  runtime/bin/redcap legacy-evidence check|plan|restore|self-check [...]
  runtime/bin/redcap session-ownership claim|check|self-check [...]
  runtime/bin/redcap host-hook-audit
  runtime/bin/redcap prism-dispatch [...]
  runtime/bin/redcap prism-resolution [...]
  runtime/bin/redcap prism-rebuttal-request [...]
  runtime/bin/redcap prism-consensus check|self-check|trace [...]
  runtime/bin/redcap prism-ledger [...]
  runtime/bin/redcap executed-check run|self-check [...]
  runtime/bin/redcap task-facts record|summary|check|self-check [...]
  runtime/bin/redcap completion-evidence check|self-check [...]
  runtime/bin/redcap terminal-goal check|context|self-check [...]
  runtime/bin/redcap human-output check|self-check|lint-text|lint-file [...]
  runtime/bin/redcap prism-shard [...]
  runtime/bin/redcap scan-conclusion check|self-check [...]
  runtime/bin/redcap intent-judge classify|matrix-check|self-check [...]
  runtime/bin/redcap advisory-stop check|self-check|health-check
  runtime/bin/redcap hook-quality check|self-check [...]
  runtime/bin/redcap provider-health check|self-check|live-check [...]
  runtime/bin/redcap runtime-health check|self-check|independent-probe|divergence-probe [...]
  runtime/bin/redcap config compat-check|migrate|self-check|external-probe [...]
  runtime/bin/redcap prism-context check|self-check|cap-load|cap-input-check|cap-consume [...]
  runtime/bin/redcap soul-load check|load|public-leak-scan|self-check [...]
  runtime/bin/redcap status [...]
  runtime/bin/redcap revive [...]
  runtime/bin/redcap revival-followthrough check|e2e-check|open-loop-check|open-loop-close|self-check [...]
  runtime/bin/redcap rsp-contract check|self-check [...]
  runtime/bin/redcap revival-queue check|self-check [...]
  runtime/bin/redcap residual-batch check|mutation-check|self-check [...]
  runtime/bin/redcap known-issues-order check|self-check [...]
  runtime/bin/redcap known-issues-queue check|self-check [...]
  runtime/bin/redcap evidence-retention check|plan|self-check [...]
  runtime/bin/redcap check-profiles check|decide|self-check [...]
  runtime/bin/redcap long-task check|decide|start|record|complete|boundary-check|self-check [...]
  runtime/bin/redcap cli-surface check|self-check|extract [...]
  runtime/bin/redcap fsm-check [...]
  runtime/bin/redcap knowledge-gateway-check [...]
  runtime/bin/redcap session-ownership-check [...]
  runtime/bin/redcap formal-usable-check [--skip-host-hook-audit]
  runtime/bin/redcap complete-revival-check [--require-terminal-verified] [--skip-host-hook-audit]
  runtime/bin/redcap temporary-usable-check
  runtime/bin/redcap process-artifacts check|self-check [...]
  runtime/bin/redcap layout-check [check|self-check]
  runtime/bin/redcap check [--only STEP|--profile fast|standard|release|terminal]

Commands:
  gate          Run deterministic Prism rule review.
  intake        Run gate and exit 2 when full Prism is required.
  enforcement-check
                Verify the protocol/workflow enforcement matrix with probes.
  hook-coverage-check
                Verify required guardrails have deployed host hook coverage.
  boundary      Resolve and verify runtime/project/user-private boundaries.
  boundary-consumers
                Verify runtime-writing commands use the project-level .redcap boundary.
  archaeology   Run bounded old-RedCap archaeology shard extraction.
  lifecycle     Validate development lifecycle evidence against the FSM.
  final-claim   Guard final completion claims against task-body evidence.
  phase2-blueprint
                Validate the RedCap 1.1 Phase 2 blueprint contract.
  full-revival-amendment
                Verify that full revival cannot be reduced to a minimum kernel.
  e2e-trace     Run the RedCap 1.0 hook/session/FSM/completion trace.
  complete-revival-e2e
                Run the generic AI-only RedCap E2E methodology and Codex CLI carrier probe.
  ol11         Verify OL-11 TRPG long-run E2E pre-execution contracts, provenance, evidence schema, and carrier dry run.
  fsm           Run the RedCap workflow FSM kernel.
  loom-workflow Verify the role-based Loom engineering workflow contract.
  loom-runtime  Run the project-level Loom role session manifest and loss alarms.
  loom          Alias for loom-runtime role/session checks.
  loom-external-sample-audit
                Independently audit external Loom sample evidence without reusing the Loom runtime validator.
  forge         Verify RedCap Forge and redcap-arsenal promotion rules.
  arsenal       Verify the public reusable redcap-arsenal index.
  project-install
                Package RedCap as .redcap, audit release artifacts, and initialize project-level runtime.
  knowledge-gateway
                Run the minimal index-first RedCap knowledge gateway.
  knowledge-quality
                Verify knowledge freshness, conflict, no-promote, and direct-driver eligibility metadata.
  self-purification
                Run and verify pre-task retrieval, post-task harvest, promotion decisions, and Cap private persona boundaries.
  persona-observation
                Observe Cap persona distillation evidence and upgrade unsafe gaps to actionable problems.
  evidence-restore
                Restore bounded generated evidence through a RedCap-owned writer.
  legacy-evidence
                Check, plan, or restore old external RedCap evidence safely.
  session-ownership
                Run the minimal RedCap host/session ownership kernel.
  host-hook-audit
                Audit current host hook and provider-call interception coverage.
  prism-dispatch
                Dispatch a Prism provider review through the enforced dispatcher.
  prism-resolution
                Verify accept/reject/escalate resolution for Prism concern/block verdicts.
  prism-rebuttal-request
                Generate a bounded same-provider rebuttal request for a rejected concern.
  prism-consensus
                Verify Prism provider consensus, disagreement handling, and rebuttal gates.
  prism-ledger  Record and summarize Prism task execution health.
  executed-check
                Run a command and write a RedCap executed-check receipt with stdout/stderr files.
  task-facts    Record and summarize RedCap task fact status.
  completion-evidence
                Verify completion judgments are backed by source, contract, negative, and runtime evidence.
  terminal-goal
                Guard terminal objectives so phase achievements cannot close parent goals.
  human-output  Check Chinese-first human-facing output policy.
  prism-shard   Validate and merge bounded Prism long-task shard accounts.
  scan-conclusion
                Guard 360-degree old RedCap scan conclusions with structured scan facts.
  intent-judge  Classify prompt intent with deterministic rules and bounded Prism LLM fallback.
  advisory-stop Check advisory Stop closeout contract and deployment.
  hook-quality Verify Hook false-positive and false-negative quality metrics.
  provider-health
                Verify provider command path, session, bounded file access, and failure classification.
  runtime-health
                Verify critical Cap runtime entrypoints and failure classification.
  config       Verify RedCap-owned config schema versions, migrations, unknown-version rejection, and external filesystem probes.
  prism-context
                Verify Prism raw/brief/structured context boundaries.
  soul-load     Load or verify Cap identity sources and portability without leaking private text.
  status        Show the human-facing RedCap status surface.
  revive        Load Cap identity and show the revival status surface.
  revival-followthrough
                Verify post-E2E revival gap closure queue and evidence quality.
  rsp-contract Verify RSP completion claims against plan, evidence, and new-issue queue rules.
  revival-queue Check the executable RedCap revival implementation queue.
  residual-batch
                Run the residual RSP batch as one integration check.
  known-issues-order
                Check the ordered queue for known remaining RedCap issues.
  known-issues-queue
                Check known remaining RedCap issue statuses and deferrals.
  long-task     Decide long-task entry and verify parent-objective anti-loop contracts.
  cli-surface   Verify RedCap command surface compatibility, help text, aliases, and drift probes.
  fsm-check     Compatibility alias for fsm check.
  knowledge-gateway-check
                Compatibility alias for knowledge-gateway check.
  session-ownership-check
                Compatibility alias for session-ownership self-check.
  formal-usable-check
                Verify RedCap formal usability through user-facing workflows.
  complete-revival-check
                Verify RedCap complete-revival terminal acceptance.
  temporary-usable-check
                Verify the current scaffold is usable enough for revival work.
  process-artifacts
                Verify one-turn process artifacts are kept out of stable contracts.
  layout-check  Verify directory policy, root thinness, and unit boundaries.
  check         Run Prism, FSM, knowledge, and layout checks.
USAGE
}

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
  usage
  exit 2
fi
shift

case "$cmd" in
  gate)
    exec "$PRISM" gate "$@"
    ;;
  intake)
    exec "$PRISM" gate --fail-when-required "$@"
    ;;
  enforcement-check)
    exec "$REPO_ROOT/runtime/prism/bin/enforcement-check" "$@"
    ;;
  hook-coverage-check)
    exec "$REPO_ROOT/runtime/prism/bin/hook-coverage-check" "$@"
    ;;
  boundary)
    exec python3 "$REPO_ROOT/runtime/core/runtime_boundary.py" "$@"
    ;;
  boundary-consumers)
    exec python3 "$REPO_ROOT/runtime/core/runtime_boundary_consumers.py" "$@"
    ;;
  archaeology)
    exec python3 "$REPO_ROOT/runtime/core/archaeology_shards.py" "$@"
    ;;
  lifecycle)
    exec python3 "$REPO_ROOT/runtime/core/development_lifecycle.py" "$@"
    ;;
  final-claim)
    exec python3 "$REPO_ROOT/runtime/core/final_claim_guard.py" "$@"
    ;;
  phase2-blueprint)
    exec python3 "$REPO_ROOT/runtime/core/phase2_blueprint.py" "$@"
    ;;
  full-revival-amendment)
    exec python3 "$REPO_ROOT/runtime/core/full_revival_amendment.py" "$@"
    ;;
  e2e-trace)
    exec python3 "$REPO_ROOT/runtime/core/e2e_trace.py" "$@"
    ;;
  complete-revival-e2e)
    exec python3 "$REPO_ROOT/runtime/core/complete_revival_e2e.py" "$@"
    ;;
  ol11)
    exec python3 "$REPO_ROOT/runtime/core/ol11_longrun_plan.py" "$@"
    ;;
  fsm)
    exec python3 "$REPO_ROOT/runtime/core/fsm.py" "$@"
    ;;
  fsm-check)
    exec python3 "$REPO_ROOT/runtime/core/fsm.py" check "$@"
    ;;
  loom-workflow)
    exec python3 "$REPO_ROOT/runtime/core/loom_workflow.py" "$@"
    ;;
  loom-runtime)
    exec python3 "$REPO_ROOT/runtime/core/loom_runtime.py" "$@"
    ;;
  loom)
    exec python3 "$REPO_ROOT/runtime/core/loom_runtime.py" "$@"
    ;;
  loom-external-sample-audit)
    exec python3 "$REPO_ROOT/runtime/core/loom_external_sample_audit.py" "$@"
    ;;
  forge)
    exec python3 "$REPO_ROOT/runtime/core/redcap_forge.py" "$@"
    ;;
  arsenal)
    exec python3 "$REPO_ROOT/runtime/core/redcap_forge.py" "$@"
    ;;
  project-install)
    exec python3 "$REPO_ROOT/runtime/core/project_install.py" "$@"
    ;;
  knowledge-gateway)
    exec python3 "$REPO_ROOT/runtime/core/knowledge_gateway.py" "$@"
    ;;
  knowledge-quality)
    exec python3 "$REPO_ROOT/runtime/core/knowledge_quality.py" "$@"
    ;;
  knowledge-gateway-check)
    exec python3 "$REPO_ROOT/runtime/core/knowledge_gateway.py" check "$@"
    ;;
  self-purification)
    exec python3 "$REPO_ROOT/runtime/core/self_purification.py" "$@"
    ;;
  persona-observation)
    exec python3 "$REPO_ROOT/runtime/core/persona_observation.py" "$@"
    ;;
  evidence-restore)
    exec python3 "$REPO_ROOT/runtime/core/evidence_restore.py" "$@"
    ;;
  legacy-evidence)
    exec python3 "$REPO_ROOT/runtime/core/legacy_evidence_policy.py" "$@"
    ;;
  session-ownership)
    exec python3 "$REPO_ROOT/runtime/core/session_ownership.py" "$@"
    ;;
  session-ownership-check)
    exec python3 "$REPO_ROOT/runtime/core/session_ownership.py" self-check "$@"
    ;;
  host-hook-audit)
    exec python3 "$REPO_ROOT/runtime/host-adapters/host-hook-audit.py" "$@"
    ;;
  prism-dispatch)
    exec python3 "$REPO_ROOT/runtime/prism/bin/prism-dispatch" "$@"
    ;;
  prism-resolution)
    exec "$PRISM" resolution-check "$@"
    ;;
  prism-rebuttal-request)
    exec "$PRISM" rebuttal-request "$@"
    ;;
  prism-consensus)
    exec python3 "$REPO_ROOT/runtime/core/prism_provider_consensus.py" "$@"
    ;;
  prism-ledger)
    exec "$REPO_ROOT/runtime/prism/bin/prism-ledger" "$@"
    ;;
  executed-check)
    exec python3 "$REPO_ROOT/runtime/core/executed_check_receipt.py" "$@"
    ;;
  task-facts)
    exec python3 "$REPO_ROOT/runtime/core/task_facts.py" "$@"
    ;;
  completion-evidence)
    exec python3 "$REPO_ROOT/runtime/core/completion_evidence.py" "$@"
    ;;
  terminal-goal)
    exec python3 "$REPO_ROOT/runtime/core/terminal_goal_guard.py" "$@"
    ;;
  human-output)
    exec python3 "$REPO_ROOT/runtime/core/human_output_policy.py" "$@"
    ;;
  prism-shard)
    exec python3 "$REPO_ROOT/runtime/prism/bin/prism-shard" "$@"
    ;;
  scan-conclusion)
    exec python3 "$REPO_ROOT/runtime/core/scan_conclusion_guard.py" "$@"
    ;;
  intent-judge)
    exec python3 "$REPO_ROOT/runtime/core/intent_judge.py" "$@"
    ;;
  advisory-stop)
    exec python3 "$REPO_ROOT/runtime/core/advisory_stop.py" "$@"
    ;;
  hook-quality)
    exec python3 "$REPO_ROOT/runtime/core/hook_quality_metrics.py" "$@"
    ;;
  provider-health)
    exec python3 "$REPO_ROOT/runtime/core/provider_health.py" "$@"
    ;;
  runtime-health)
    if [[ "${1:-}" == "independent-probe" ]]; then
      shift
      exec python3 "$REPO_ROOT/runtime/core/cap_runtime_health_external_probe.py" "$@"
    fi
    if [[ "${1:-}" == "divergence-probe" ]]; then
      shift
      exec python3 "$REPO_ROOT/runtime/core/cap_runtime_health_divergence_probe.py" "$@"
    fi
    exec python3 "$REPO_ROOT/runtime/core/cap_runtime_health.py" "$@"
    ;;
  config)
    if [[ "${1:-}" == "external-probe" ]]; then
      shift
      exec python3 "$REPO_ROOT/runtime/core/config_contract_compat_external_probe.py" "$@"
    fi
    exec python3 "$REPO_ROOT/runtime/core/config_contract_compat.py" "$@"
    ;;
  prism-context)
    exec python3 "$REPO_ROOT/runtime/core/prism_context_boundary.py" "$@"
    ;;
  soul-load)
    if [[ "${1:-}" == "portability-check" ]]; then
      shift
      exec python3 "$REPO_ROOT/runtime/core/cap_revival_portability.py" "$@"
    fi
    if [[ "${1:-}" == "public-leak-scan" ]]; then
      shift
      exec python3 "$REPO_ROOT/runtime/core/cap_revival_portability.py" --public-leak-scan "$@"
    fi
    if [[ "${1:-}" == "sanitize-public-leaks" ]]; then
      shift
      exec python3 "$REPO_ROOT/runtime/core/cap_revival_portability.py" --sanitize-public-leaks "$@"
    fi
    exec python3 "$REPO_ROOT/runtime/core/soul_loader.py" "$@"
    ;;
  status)
    exec python3 "$REPO_ROOT/runtime/core/status_surface.py" status "$@"
    ;;
  revive)
    exec python3 "$REPO_ROOT/runtime/core/status_surface.py" revive "$@"
    ;;
  revival-followthrough)
    exec python3 "$REPO_ROOT/runtime/core/revival_followthrough.py" "$@"
    ;;
  rsp-contract)
    exec python3 "$REPO_ROOT/runtime/core/rsp_contract.py" "$@"
    ;;
  revival-queue)
    exec python3 "$REPO_ROOT/runtime/core/revival_queue.py" "$@"
    ;;
  residual-batch)
    exec python3 "$REPO_ROOT/runtime/core/residual_batch.py" "$@"
    ;;
  known-issues-order)
    exec python3 "$REPO_ROOT/runtime/core/known_issues_order.py" "$@"
    ;;
  known-issues-queue)
    exec python3 "$REPO_ROOT/runtime/core/known_issues_queue.py" "$@"
    ;;
  evidence-retention)
    exec python3 "$REPO_ROOT/runtime/core/evidence_retention.py" "$@"
    ;;
  check-profiles)
    exec python3 "$REPO_ROOT/runtime/core/check_profiles.py" "$@"
    ;;
  long-task)
    exec python3 "$REPO_ROOT/runtime/core/long_task_contract.py" "$@"
    ;;
  cli-surface)
    exec python3 "$REPO_ROOT/runtime/core/cli_surface.py" "$@"
    ;;
  formal-usable-check)
    exec python3 "$REPO_ROOT/runtime/core/formal_usable_check.py" check "$@"
    ;;
  complete-revival-check)
    if [[ "${1:-}" == "self-check" ]]; then
      shift
      exec python3 "$REPO_ROOT/runtime/core/complete_revival_check.py" self-check "$@"
    fi
    exec python3 "$REPO_ROOT/runtime/core/complete_revival_check.py" check "$@"
    ;;
  temporary-usable-check)
    exec python3 "$REPO_ROOT/runtime/core/temporary_usable_check.py" "$@"
    ;;
  process-artifacts)
    exec python3 "$REPO_ROOT/runtime/core/process_artifact_placement.py" "$@"
    ;;
  layout-check)
    exec python3 "$REPO_ROOT/runtime/core/layout_guard.py" "$@"
    ;;
  check)
    if [[ "${1:-}" == "list" || "${1:-}" == "self-check" ]]; then
      exec python3 "$REPO_ROOT/runtime/core/check_runner.py" "$@"
    fi
    exec python3 "$REPO_ROOT/runtime/core/check_runner.py" check "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
