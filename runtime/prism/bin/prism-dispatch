        except ProviderTimeoutError as exc:
            total_deadline_elapsed = time.monotonic() - total_deadline_start
            total_deadline_attempts = exc.attempts
        if not total_deadline_attempts:
            failures.append("total deadline fixture did not raise ProviderTimeoutError")
        if total_deadline_elapsed > 2:
            failures.append("total deadline fixture exceeded dispatcher total timeout")
        if total_deadline_attempts and not any(
            attempt.get("timeout_scope") == "dispatcher-total" for attempt in total_deadline_attempts
        ):
            failures.append("total deadline fixture did not record dispatcher-total timeout scope")
        mark_session_expired(manifest, "claude-code", "33333333-3333-4333-8333-333333333333", "self-check expired provider")
        expired_manifest = load_json(manifest)
        expired_provider = expired_manifest.get("providers", {}).get("claude-code", {})
        kimi_after_expire = expired_manifest.get("providers", {}).get("kimi", {})
        if expired_provider.get("status") != "expired":
            failures.append("mark_session_expired did not persist provider expired status")
        if expired_provider.get("session_handle") != "33333333-3333-4333-8333-333333333333":
            failures.append("mark_session_expired did not persist captured provider handle")
        if kimi_after_expire.get("round_count") != 1:
            failures.append("mark_session_expired should not alter the other provider round count")
        if kimi_after_expire.get("status") != "pending":
            failures.append("mark_session_expired should not expire unrelated providers")
        if expired_manifest.get("convergence", {}).get("state") != "unresolved":
            failures.append("mark_session_expired should keep convergence unresolved")
        if markdown_review.get("provider") != "claude-code":
            failures.append("Claude markdown review extraction failed")
        if pass_summary_review.get("verdict") != "pass":
            failures.append("Claude pass summary extraction failed")
        if concern_summary_review.get("verdict") != "concern":
            failures.append("Claude concern summary extraction failed")
        if "redirect pattern inconsistency" not in concern_summary_review.get("main_concern", ""):
            failures.append("Claude concern summary did not preserve the main concern")
        if concern_summary_review.get("anti_loop_signal", {}).get("present") is not False:
            failures.append("Claude negative anti-loop summary was treated as present")
        if compressed_pass_review.get("verdict") != "pass" or compressed_pass_review.get("confidence") != "high":
            failures.append("Claude compressed pass/confidence extraction failed")
        if split_bold_confidence_review.get("verdict") != "concern" or split_bold_confidence_review.get("confidence") != "high":
            failures.append("split bold verdict/confidence extraction failed")
        if lowercase_split_bold_review.get("verdict") != "concern" or lowercase_split_bold_review.get("confidence") != "medium":
            failures.append("lowercase split bold verdict/confidence extraction failed")
        kim_safe_argv, _ = provider_command("kimi", None, "safe-check", 1)
        if "--plan" in kim_safe_argv:
            failures.append("kimi provider command still uses plan mode, which cannot combine with prompt mode")
        if "--skills-dir" not in kim_safe_argv or str(KIMI_EMPTY_SKILLS_DIR) not in kim_safe_argv:
            failures.append("kimi provider command is missing the empty skills directory")
        if "-p" not in kim_safe_argv and "--prompt" not in kim_safe_argv:
            failures.append("kimi provider command is missing non-interactive prompt mode")
        if "--output-format" not in kim_safe_argv or "stream-json" not in kim_safe_argv:
            failures.append("kimi provider command is missing stream-json output mode")
        for forbidden in ["--work-dir", "--agent-file", "--print", "--final-message-only", "--max-steps-per-turn", "-y", "--yolo", "--auto"]:
            if forbidden in kim_safe_argv:
                failures.append(f"kimi provider command still uses unsupported or unsafe option {forbidden}")
        if str(REPO_ROOT) in kim_safe_argv:
            failures.append("kimi provider command still uses RedCap repo as work-dir")
        kim_resume_argv, kim_resume_handle = provider_command("kimi", "session_11111111-1111-4111-8111-111111111111", "safe-check", 1)
        if "--session" not in kim_resume_argv or kim_resume_handle != "session_11111111-1111-4111-8111-111111111111":
            failures.append("kimi provider command is missing session resume support")
        stream_resume = extract_kimi_handle(
            '{"role":"meta","type":"session.resume_hint","session_id":"session_aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","command":"kimi -r session_aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","content":"To resume this session: kimi -r session_aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"}',
            None,
        )
        if stream_resume != "session_aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa":
            failures.append("Kimi stream-json resume hint extraction failed")
        direct_resume = extract_kimi_handle(
            "To resume this session: kimi -r session_bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
            None,
        )
        if direct_resume != "session_bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb":
            failures.append("Kimi text resume hint extraction failed")
        fake_resume = extract_kimi_handle(
            "retry_fixture.write_text(\"print(f'kimi -r 22222222-2222-4222-8222-222222222222', flush=True)\")",
            None,
        )
        if fake_resume is not None:
            failures.append("Kimi handle extraction accepted a fake session from code text")
        if provider_cwd(kim_safe_argv) == str(REPO_ROOT):
            failures.append("kimi provider command should run outside the RedCap repo cwd")
        claude_safe_argv, _ = provider_command("claude-code", None, "safe-check", 1)
        if "--bare" in claude_safe_argv:
            failures.append("claude provider command should not use bare mode because it conflicts with current reasoning settings")
        if "bypassPermissions" in claude_safe_argv:
            failures.append("claude provider command still contains unsafe bypassPermissions flag")
        if "acceptEdits" in claude_safe_argv:
            failures.append("claude provider command still uses edit-capable permission mode")
        if "--tools" not in claude_safe_argv or "" not in claude_safe_argv:
            failures.append("claude provider command does not disable tools")
        if "--disallowedTools" in claude_safe_argv or "--disallowed-tools" in claude_safe_argv:
            failures.append("claude provider command should not use stale disallowed tools")
        if "--json-schema" not in claude_safe_argv:
            failures.append("claude provider command is missing JSON schema output guard")
        try:
            assert_provider_command_safe([
                "kimi",
                "--final-message-only",
                "--plan",
                "-p",
                "x",
            ])
            failures.append("assert_provider_command_safe did not reject old Kimi final-message-only option")
        except SystemExit:
            pass
        try:
            assert_provider_command_safe([
                "kimi",
                "--skills-dir",
                str(KIMI_EMPTY_SKILLS_DIR),
                "--plan",
                "-p",
                "x",
            ])
            failures.append("assert_provider_command_safe did not reject Kimi without stream-json output")
        except SystemExit:
            pass
        try:
            assert_provider_command_safe([
                "kimi",
                "--skills-dir",
                str(KIMI_EMPTY_SKILLS_DIR),
                "--output-format",
                "stream-json",
                "--plan",
                "-p",
                "x",
            ])
            failures.append("assert_provider_command_safe did not reject Kimi plan mode")
        except SystemExit:
            pass
        try:
            assert_provider_command_safe([
                "kimi",
                "--skills-dir",
                str(KIMI_EMPTY_SKILLS_DIR),
                "--output-format",
                "stream-json",
                "--auto",
                "-p",
                "x",
            ])
            failures.append("assert_provider_command_safe did not reject Kimi auto mode")
        except SystemExit:
            pass
        try:
            assert_provider_command_safe([
                "kimi",
                "--output-format",
                "stream-json",
                "--plan",
                "-y",
                "-p",
                "x",
            ])
            failures.append("assert_provider_command_safe did not reject Kimi yolo mode")
        except SystemExit:
            pass
        sample_raw = tmp / "sample.raw.json"
        sample_payload = {
            "argv": ["fixture"],
            "attempts": [{"attempt": 1, "exit_code": 0, "timed_out": False, "stdout": "ok", "stderr": ""}],
            "exit_code": 0,
            "stdout": "ok",
            "stderr": "",
        }
        write_raw_and_meta(sample_raw, sample_payload, "kimi", raw_kind="self-check")
        sample_meta = raw_meta_path(sample_raw)
        sample_meta_ok, sample_meta_failures, _ = verify_raw_meta(sample_meta)
        if not sample_meta_ok:
            failures.append(f"raw metadata verification failed: {'; '.join(sample_meta_failures)}")
        forged_raw = tmp / "forged.raw.json"
        write_raw_and_meta(forged_raw, sample_payload, "kimi", raw_kind="self-check")
        forged_meta_path = raw_meta_path(forged_raw)
        forged_meta = load_json(forged_meta_path)
        forged_meta["exit_code"] = 99
        write_json_file(forged_meta_path, forged_meta)
        forged_ok, _, _ = verify_raw_meta(forged_meta_path)
        if forged_ok:
            failures.append("raw metadata verification did not detect forged exit_code")
        sample_raw.write_text(sample_raw.read_text(encoding="utf-8") + "tamper\n", encoding="utf-8")
        tamper_ok, _, _ = verify_raw_meta(sample_meta)
        if tamper_ok:
            failures.append("raw metadata verification did not detect raw tampering")
        try:
            assert_provider_command_safe(["claude", "--permission-mode", "bypassPermissions", "x"])
            failures.append("assert_provider_command_safe did not reject claude bypassPermissions")
        except SystemExit:
            pass
        try:
            assert_provider_command_safe(["claude", "--permission-mode", "acceptEdits", "--tools", "", "x"])
            failures.append("assert_provider_command_safe did not reject claude acceptEdits")
        except SystemExit:
            pass
        try:
            assert_provider_command_safe(["claude", "--bare", "--print", "--output-format", "json", "--permission-mode", "plan", "--tools", "", "x"])
            failures.append("assert_provider_command_safe did not reject claude without JSON schema")
        except SystemExit:
            pass
        try:
            assert_provider_command_safe([
                "claude",
                "--print",
                "--output-format",
                "json",
                "--permission-mode",
                "plan",
                "--tools",
                "",
                "--disallowedTools",
                "Bash,Edit",
                "--json-schema",
                review_json_schema_arg(),
                "x",
            ])
            failures.append("assert_provider_command_safe did not reject stale claude disallowedTools list")
        except SystemExit:
            pass
        result = {"ok": not failures, "failures": failures}
        print(json.dumps(result, ensure_ascii=False, indent=2))
        if failures:
            return 1
        print("PRISM_DISPATCH_SELF_CHECK_OK")
        return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Dispatch Prism provider reviews")
    parser.add_argument("--self-check", action="store_true")
    parser.add_argument("--verify-evidence", action="store_true")
    parser.add_argument("--verify-raw-meta", action="store_true")
    parser.add_argument("--timeout-report", action="store_true")
    parser.add_argument("--failure-report", action="store_true")
    parser.add_argument("--timeout-policy-check", action="store_true")
    parser.add_argument("--evidence-run-dir")
    parser.add_argument("--providers", default="kimi,claude-code")
    parser.add_argument("--max-age-hours", type=float)
    parser.add_argument("--provider", choices=sorted(ALLOWED_PROVIDERS))
    parser.add_argument("--manifest")
    parser.add_argument("--request")
    parser.add_argument("--review-out")
    parser.add_argument("--raw-out")
    parser.add_argument("--raw-meta")
    parser.add_argument("--timeout-policy-contract", default=str(DEFAULT_TIMEOUT_GOVERNANCE_CONTRACT))
    parser.add_argument("--extract-from-raw")
    parser.add_argument("--brief-out")
    parser.add_argument("--max-steps", type=int, default=5)
    parser.add_argument("--timeout-seconds", type=float, default=DEFAULT_TIMEOUT_SECONDS)
    parser.add_argument("--total-timeout-seconds", type=float)
    parser.add_argument("--task-total-timeout-seconds", type=float)
    parser.add_argument("--max-retries", type=int, default=DEFAULT_MAX_RETRIES)
    parser.add_argument("--dry-run", action="store_true")
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if args.self_check:
        return cmd_self_check(args)
    if args.timeout_policy_check:
        return cmd_timeout_policy_check(args)
    if args.timeout_report:
        return cmd_timeout_report(args)
    if args.failure_report:
        return cmd_failure_report(args)
    if args.verify_raw_meta:
        return cmd_verify_raw_meta(args)
    if args.verify_evidence:
        if not args.evidence_run_dir:
            parser.error("--evidence-run-dir is required with --verify-evidence")
        return cmd_verify_evidence(args)
    required = ["provider", "manifest", "review_out"]
    if not args.extract_from_raw:
        required.append("request")
    for name in required:
        if not getattr(args, name):
            parser.error(f"--{name.replace('_', '-')} is required unless --self-check is used")
    if args.timeout_seconds <= 0:
        parser.error("--timeout-seconds must be greater than 0")
    if args.total_timeout_seconds is not None and args.total_timeout_seconds <= 0:
        parser.error("--total-timeout-seconds must be greater than 0")
    if args.task_total_timeout_seconds is not None and args.task_total_timeout_seconds <= 0:
        parser.error("--task-total-timeout-seconds must be greater than 0")
    if args.max_retries < 0:
        parser.error("--max-retries must be greater than or equal to 0")
    return cmd_dispatch(args)


if __name__ == "__main__":
    sys.exit(main())
