        failures: list[str] = []
        if first.returncode != 0 or "PRISM_DISPATCH_DRY_RUN_OK" not in first.stdout:
            failures.append("first dry-run dispatch did not pass")
        if blocked.returncode == 0:
            failures.append("follow-up without session handle was not blocked")
        if file_init.returncode != 0:
            failures.append("file access self-check manifest init failed")
        if file_access_dry_run.returncode != 0 or "PRISM_DISPATCH_DRY_RUN_OK" not in file_access_dry_run.stdout:
            failures.append("bounded file access dry-run did not pass")
        else:
            file_access_objects = iter_json_objects(file_access_dry_run.stdout)
            file_access_result = file_access_objects[0] if file_access_objects else {}
            file_access_meta = file_access_result.get("file_access") if isinstance(file_access_result, dict) else None
            bundle_path_value = file_access_meta.get("bundle_path") if isinstance(file_access_meta, dict) else None
            if not isinstance(bundle_path_value, str) or not bundle_path_value:
                failures.append("bounded file access dry-run did not report a bundle path")
            else:
                bundle_path = pathlib.Path(bundle_path_value)
                if not bundle_path.is_file():
                    failures.append("bounded file access bundle file was not created")
                else:
                    bundle = load_json(bundle_path)
                    if bundle.get("schema_id") != KIMI_FILE_BUNDLE_SCHEMA_ID:
                        failures.append("bounded file access bundle schema_id invalid")
                    if bundle.get("mode") != "bounded-read":
                        failures.append("bounded file access bundle mode invalid")
                    entries = bundle.get("entries")
                    if not isinstance(entries, list) or len(entries) != 2:
                        failures.append("bounded file access bundle did not preserve both authorized paths")
                    elif not any(entry.get("kind") == "directory" for entry in entries if isinstance(entry, dict)):
                        failures.append("bounded file access bundle did not include directory listing support")
                    if isinstance(file_access_meta, dict) and file_access_meta.get("bundle_sha256") != sha256_file(bundle_path):
                        failures.append("bounded file access dry-run bundle sha256 mismatch")
        if bad_file_init.returncode != 0:
            failures.append("bad file access self-check manifest init failed")
        if bad_file_access.returncode == 0:
            failures.append("bounded file access accepted a path outside the RedCap repo")
        if truncation_init.returncode != 0:
            failures.append("truncation self-check manifest init failed")
        if truncation_dry_run.returncode != 0 or "PRISM_DISPATCH_DRY_RUN_OK" not in truncation_dry_run.stdout:
            failures.append("bounded file access truncation dry-run did not pass")
        else:
            truncation_objects = iter_json_objects(truncation_dry_run.stdout)
            truncation_result = truncation_objects[0] if truncation_objects else {}
            truncation_meta = truncation_result.get("file_access") if isinstance(truncation_result, dict) else None
            truncation_bundle_path = truncation_meta.get("bundle_path") if isinstance(truncation_meta, dict) else None
            if not isinstance(truncation_bundle_path, str) or not truncation_bundle_path:
                failures.append("bounded file access truncation dry-run did not report a bundle path")
            else:
                truncation_bundle = load_json(pathlib.Path(truncation_bundle_path))
                truncation_entries = truncation_bundle.get("entries")
                first_truncation_entry = truncation_entries[0] if isinstance(truncation_entries, list) and truncation_entries else {}
                if not isinstance(first_truncation_entry, dict) or first_truncation_entry.get("content_truncated") is not True:
                    failures.append("bounded file access truncation fixture did not record content_truncated=true")
                if isinstance(first_truncation_entry, dict) and first_truncation_entry.get("bytes_included") != 1024:
                    failures.append("bounded file access truncation fixture did not respect the 1024 byte budget")
        if nested.get("provider") != "kimi":
            failures.append("nested review extraction failed")
        if kimi_text_part_review.get("provider") != "kimi" or kimi_text_part_review.get("verdict") != "pass":
            failures.append("Kimi TextPart JSON review extraction failed")
        if kimi_wrapped_text_part_review.get("confidence") != "high":
            failures.append("Kimi wrapped TextPart JSON repair failed")
        if contradictory_anti_loop.get("anti_loop_signal", {}).get("present") is not False:
            failures.append("contradictory anti-loop JSON normalization failed")
        if defaults.timeout_seconds != DEFAULT_TIMEOUT_SECONDS:
            failures.append("dispatcher default timeout is not 300 seconds")
        if defaults.max_retries != DEFAULT_MAX_RETRIES:
            failures.append("dispatcher default max retries is not 5")
        if defaults.total_timeout_seconds is not None:
            failures.append("dispatcher default total timeout should be computed at dispatch time")
        if defaults.task_total_timeout_seconds is not None:
            failures.append("dispatcher default task total timeout should be unset")
        if not task_total_payload:
            failures.append("task total timeout fixture did not raise ProviderTimeoutError")
        if task_total_ran_marker.exists():
            failures.append("task total timeout fixture started provider after task budget was exhausted")
        if task_total_attempts and task_total_attempts[0].get("timeout_scope") != "task-total":
            failures.append("task total timeout fixture did not record task-total scope")
        if task_total_payload.get("task_total_timeout_seconds") != 0.001:
            failures.append("task total timeout raw payload did not persist task budget")
        if task_total_report.returncode != 0 or "PRISM_TIMEOUT_REPORT_OK" not in task_total_report.stdout:
            failures.append("timeout report command did not accept task-total raw output")
        if "整任务预算" not in task_total_report.stdout:
            failures.append("timeout report did not emit a Chinese task-budget summary")
        if retry_completed.returncode != 0:
            failures.append("timeout retry fixture did not eventually succeed")
        if len(retry_attempts) != 3:
            failures.append("timeout retry fixture did not exercise two retries plus final success")
        if sum(1 for attempt in retry_attempts if attempt.get("timed_out") is True) != 2:
            failures.append("timeout retry fixture did not record exactly two timeout retries")
        if len(rebuild_calls) != 2 or any(handle != retry_handle for handle in rebuild_calls):
            failures.append("timeout retry fixture did not rebuild retry commands with the captured provider handle")
        if timeout_payload.get("max_retries") != 2 or len(timeout_payload.get("attempts", [])) != 3:
            failures.append("timeout raw evidence writer did not persist exhausted retry attempts")
        if not timeout_raw.is_file():
            failures.append("timeout raw evidence file was not written")
        if not stubborn_payload:
            failures.append("stubborn child timeout fixture did not raise ProviderTimeoutError")
        if stubborn_elapsed > 5:
            failures.append("stubborn child timeout fixture exceeded hard-timeout budget")
        if stubborn_child_survived:
            failures.append("stubborn child timeout fixture left a child process alive")
        if stubborn_payload and len(stubborn_payload.get("attempts", [])) != 1:
            failures.append("stubborn child timeout fixture did not record exactly one timeout attempt")
        if stubborn_payload and stubborn_payload.get("attempts", [{}])[0].get("timed_out") is not True:
            failures.append("stubborn child timeout fixture did not record a timed-out attempt")
        if not stubborn_timeout_raw.is_file():
            failures.append("stubborn timeout raw evidence file was not written")
        total_deadline_fixture = tmp / "total_deadline.py"
        total_deadline_fixture.write_text(
            "\n".join([
                "import time",
                "print('To resume this session: kimi -r 22222222-2222-4222-8222-222222222222', flush=True)",
                "time.sleep(2)",
