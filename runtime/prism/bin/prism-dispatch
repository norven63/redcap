#!/usr/bin/env python3
"""Dispatch Prism reviews through approved providers with session enforcement."""

from __future__ import annotations

import argparse
import ast
import datetime as dt
import hashlib
import json
import os
import pathlib
import re
import signal
import subprocess
import sys
import tempfile
import time
import uuid
from typing import Any


ROOT = pathlib.Path(__file__).resolve().parents[1]
REPO_ROOT = ROOT.parents[1]
PRISM = ROOT / "bin" / "prism"
KIMI_REVIEW_AGENT_FILE = ROOT / "provider-agents" / "kimi-review-agent.yaml"
KIMI_EMPTY_SKILLS_DIR = ROOT / "skills" / "kimi-empty"
ALLOWED_PROVIDERS = {"kimi", "claude-code"}
DEFAULT_TIMEOUT_SECONDS = 300
DEFAULT_MAX_RETRIES = 5
TIMEOUT_KILL_GRACE_SECONDS = 0.5
DEFAULT_TOTAL_TIMEOUT_MULTIPLIER = 1.0
REQUIRED_REVIEW_KEYS = {
    "provider",
    "verdict",
    "confidence",
    "reality_delta",
    "main_concern",
    "top_risks",
    "missing_evidence",
    "minimum_fix",
    "anti_loop_signal",
    "user_intent_alignment",
}
RAW_META_SCHEMA_ID = "prism-provider-raw-metadata"
DEFAULT_TIMEOUT_GOVERNANCE_CONTRACT = REPO_ROOT / "assets" / "contracts" / "prism-timeout-governance.json"
KIMI_FILE_BUNDLE_SCHEMA_ID = "redcap-prism-kimi-file-bundle-v1"
KIMI_FILE_ACCESS_MODES = {"prompt-only", "bounded-read"}
DEFAULT_KIMI_FILE_MAX_FILES = 20
DEFAULT_KIMI_FILE_MAX_DIRECTORY_ENTRIES = 200
DEFAULT_KIMI_FILE_MAX_BYTES_PER_FILE = 20_000
DEFAULT_KIMI_FILE_MAX_TOTAL_BYTES = 80_000
KIMI_FILE_ACCESS_DENIED_PARTS = {
    ".git",
    ".venv",
    "venv",
    "node_modules",
    "__pycache__",
}
KIMI_FILE_ACCESS_DENIED_FILENAMES = {
    ".env",
    ".env.local",
    ".env.production",
    ".env.development",
    ".npmrc",
}


REVIEW_JSON_SCHEMA = {
    "type": "object",
    "properties": {
        "provider": {"type": "string", "enum": ["kimi", "claude-code"]},
        "verdict": {"type": "string", "enum": ["pass", "concern", "block"]},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "reality_delta": {"type": "string", "minLength": 12},
        "main_concern": {"type": "string", "minLength": 12},
        "top_risks": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
        "missing_evidence": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
        "minimum_fix": {"type": "string", "minLength": 12},
        "anti_loop_signal": {
            "type": "object",
            "properties": {
                "present": {"type": "boolean"},
                "reason": {"type": "string", "minLength": 8},
            },
            "required": ["present", "reason"],
        },
        "user_intent_alignment": {"type": "string", "enum": ["aligned", "unclear", "drifting", "misaligned"]},
    },
    "required": sorted(REQUIRED_REVIEW_KEYS),
}


def review_json_schema_arg() -> str:
    return json.dumps(REVIEW_JSON_SCHEMA, ensure_ascii=False, separators=(",", ":"))


def load_json(path: pathlib.Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid json: {path}: {exc}") from exc


def sha256_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def raw_meta_path(raw_out: pathlib.Path) -> pathlib.Path:
    if raw_out.name.endswith(".raw.json"):
        return raw_out.with_name(raw_out.name[:-len(".raw.json")] + ".raw.meta.json")
    if raw_out.name.endswith(".raw.txt"):
        return raw_out.with_name(raw_out.name[:-len(".raw.txt")] + ".raw.meta.json")
    return raw_out.with_name(raw_out.name + ".meta.json")


def stream_size(value: Any) -> int:
    return len(output_text(value).encode("utf-8"))


def attempts_summary(attempts: list[dict[str, Any]]) -> list[dict[str, Any]]:
    summary: list[dict[str, Any]] = []
    for attempt in attempts:
        summary.append({
            "attempt": attempt.get("attempt"),
            "exit_code": attempt.get("exit_code"),
            "timed_out": attempt.get("timed_out") is True,
            "timeout_scope": attempt.get("timeout_scope"),
            "stdout_bytes": stream_size(attempt.get("stdout")),
            "stderr_bytes": stream_size(attempt.get("stderr")),
            "captured_session_handle": attempt.get("captured_session_handle"),
            "recovery": attempt.get("recovery"),
        })
    return summary


def write_json_file(path: pathlib.Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def raw_metadata_payload(
    raw_out: pathlib.Path,
    raw_payload: dict[str, Any],
    provider: str,
    *,
    raw_kind: str,
    review_path: pathlib.Path | None = None,
) -> dict[str, Any]:
    attempts = raw_payload.get("attempts")
    if not isinstance(attempts, list):
        attempts = []
    timed_out = any(isinstance(attempt, dict) and attempt.get("timed_out") is True for attempt in attempts)
    return {
        "schema_id": RAW_META_SCHEMA_ID,
        "provider": provider,
        "raw_kind": raw_kind,
        "raw_path": str(raw_out),
        "raw_size_bytes": raw_out.stat().st_size,
        "raw_sha256": sha256_file(raw_out),
        "exit_code": raw_payload.get("exit_code"),
        "timed_out": timed_out,
        "timeout_seconds": raw_payload.get("timeout_seconds"),
        "total_timeout_seconds": raw_payload.get("total_timeout_seconds"),
        "task_total_timeout_seconds": raw_payload.get("task_total_timeout_seconds"),
        "task_elapsed_timeout_seconds": raw_payload.get("task_elapsed_timeout_seconds"),
        "task_remaining_timeout_seconds": raw_payload.get("task_remaining_timeout_seconds"),
        "max_retries": raw_payload.get("max_retries"),
        "attempts_count": len(attempts),
        "attempts": attempts_summary([attempt for attempt in attempts if isinstance(attempt, dict)]),
        "review_path": str(review_path) if review_path is not None else None,
    }


def write_raw_and_meta(
    raw_out: pathlib.Path,
    raw_payload: dict[str, Any],
    provider: str,
    *,
    raw_kind: str,
    review_path: pathlib.Path | None = None,
) -> dict[str, Any]:
    raw_out.parent.mkdir(parents=True, exist_ok=True)
    write_json_file(raw_out, raw_payload)
    meta_payload = raw_metadata_payload(raw_out, raw_payload, provider, raw_kind=raw_kind, review_path=review_path)
    meta_path = raw_meta_path(raw_out)
    write_json_file(meta_path, meta_payload)
    ok, failures, _ = verify_raw_meta(meta_path)
    if not ok:
        raise SystemExit(json.dumps({
            "ok": False,
            "stage": "raw-meta-write",
            "provider": provider,
            "raw_path": str(raw_out),
            "meta_path": str(meta_path),
            "failures": failures,
        }, ensure_ascii=False))
    return meta_payload


def verify_raw_meta(meta_path: pathlib.Path) -> tuple[bool, list[str], dict[str, Any]]:
    failures: list[str] = []
    if not meta_path.exists():
        return False, ["raw metadata file does not exist"], {}
    meta = load_json(meta_path)
    if not isinstance(meta, dict):
        return False, ["raw metadata must be a JSON object"], {}
    if meta.get("schema_id") != RAW_META_SCHEMA_ID:
        failures.append(f"schema_id must be {RAW_META_SCHEMA_ID}")
    raw_value = meta.get("raw_path")
    if not isinstance(raw_value, str) or not raw_value:
        failures.append("raw_path must be a non-empty string")
        raw_path = None
    else:
        raw_path = pathlib.Path(raw_value)
        if not raw_path.is_absolute():
            raw_path = (meta_path.parent / raw_path).resolve()
    if raw_path is None or not raw_path.exists():
        failures.append("raw_path does not exist")
        return False, failures, meta
    actual_size = raw_path.stat().st_size
    actual_sha = sha256_file(raw_path)
    if meta.get("raw_size_bytes") != actual_size:
        failures.append("raw_size_bytes does not match raw file")
    if meta.get("raw_sha256") != actual_sha:
        failures.append("raw_sha256 does not match raw file")
    try:
        raw_payload = load_json(raw_path)
    except SystemExit as exc:
        failures.append(f"raw file is not parseable JSON: {exc}")
        return False, failures, meta
    if not isinstance(raw_payload, dict):
        failures.append("raw file must be a JSON object")
        return False, failures, meta
    attempts = raw_payload.get("attempts")
    if not isinstance(attempts, list):
        attempts = []
    expected_attempts = attempts_summary([attempt for attempt in attempts if isinstance(attempt, dict)])
    expected_timed_out = any(isinstance(attempt, dict) and attempt.get("timed_out") is True for attempt in attempts)
    semantic_fields = {
        "exit_code": raw_payload.get("exit_code"),
        "timed_out": expected_timed_out,
        "timeout_seconds": raw_payload.get("timeout_seconds"),
        "total_timeout_seconds": raw_payload.get("total_timeout_seconds"),
        "task_total_timeout_seconds": raw_payload.get("task_total_timeout_seconds"),
        "task_elapsed_timeout_seconds": raw_payload.get("task_elapsed_timeout_seconds"),
        "task_remaining_timeout_seconds": raw_payload.get("task_remaining_timeout_seconds"),
        "max_retries": raw_payload.get("max_retries"),
        "attempts_count": len(attempts),
        "attempts": expected_attempts,
    }
    for key, expected in semantic_fields.items():
        if meta.get(key) != expected:
            failures.append(f"{key} does not match raw file")
    return not failures, failures, meta


def provider_cwd(argv: list[str]) -> str:
    if argv and pathlib.Path(argv[0]).name == "kimi":
        return tempfile.gettempdir()
    return str(REPO_ROOT)


def provider_env() -> dict[str, str]:
    env = os.environ.copy()
    path_parts = [part for part in env.get("PATH", "").split(os.pathsep) if part]
    preferred = [
        str(pathlib.Path.home() / "bin"),
        "/opt/homebrew/bin",
        "/usr/local/bin",
        "/usr/bin",
        "/bin",
    ]
    merged = [part for part in preferred if part not in path_parts]
    merged.extend(path_parts)
    env["PATH"] = os.pathsep.join(merged)
    return env


def run(argv: list[str], *, timeout: float | None = None) -> subprocess.CompletedProcess[str]:
    if timeout is not None:
        return run_with_hard_timeout(argv, timeout)
    return subprocess.run(
        argv,
        cwd=provider_cwd(argv),
        env=provider_env(),
        check=False,
        capture_output=True,
        text=True,
        timeout=timeout,
    )


def output_text(value: Any) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return str(value)


def process_group_alive(pgid: int) -> bool:
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def terminate_process_group(proc: subprocess.Popen[str], grace_seconds: float) -> None:
    try:
        pgid = os.getpgid(proc.pid)
    except ProcessLookupError:
        return
    for sig in [signal.SIGTERM, signal.SIGKILL]:
        if not process_group_alive(pgid):
            return
        try:
            os.killpg(pgid, sig)
        except ProcessLookupError:
            return
        deadline = time.monotonic() + grace_seconds
        while time.monotonic() < deadline:
            proc.poll()
            if not process_group_alive(pgid):
                return
            time.sleep(0.02)


def run_with_hard_timeout(argv: list[str], timeout: float) -> subprocess.CompletedProcess[str]:
    proc = subprocess.Popen(
        argv,
        cwd=provider_cwd(argv),
        env=provider_env(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    old_handlers: dict[int, Any] = {}

    def terminate_child_then_exit(signum: int, _frame: Any) -> None:
        terminate_process_group(proc, TIMEOUT_KILL_GRACE_SECONDS)
        raise SystemExit(128 + signum)

    for signum in [signal.SIGTERM, signal.SIGINT]:
        old_handlers[signum] = signal.getsignal(signum)
        signal.signal(signum, terminate_child_then_exit)
    try:
        stdout, stderr = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        terminate_process_group(proc, TIMEOUT_KILL_GRACE_SECONDS)
        try:
            stdout, stderr = proc.communicate(timeout=TIMEOUT_KILL_GRACE_SECONDS)
        except subprocess.TimeoutExpired:
            proc.kill()
            stdout, stderr = proc.communicate()
        raise subprocess.TimeoutExpired(
            cmd=argv,
            timeout=timeout,
            output=stdout or output_text(exc.stdout),
            stderr=stderr or output_text(exc.stderr),
        ) from exc
    finally:
        for signum, handler in old_handlers.items():
            signal.signal(signum, handler)
    return subprocess.CompletedProcess(argv, proc.returncode, stdout, stderr)


class ProviderTimeoutError(Exception):
    def __init__(
        self,
        attempts: list[dict[str, Any]],
        captured_handle: str | None,
        timeout_seconds: float,
        total_timeout_seconds: float | None = None,
        reason: str = "provider command timed out",
        task_timeout_budget: dict[str, Any] | None = None,
    ):
        super().__init__("provider command timed out")
        self.attempts = attempts
        self.captured_handle = captured_handle
        self.timeout_seconds = timeout_seconds
        self.total_timeout_seconds = total_timeout_seconds
        self.reason = reason
        self.task_timeout_budget = task_timeout_budget or {}


def redacted_argv(argv: list[str]) -> list[str]:
    redacted: list[str] = []
    skip_next = False
    for index, item in enumerate(argv):
        if skip_next:
            skip_next = False
            continue
        redacted.append(item)
        if item in {"-p", "--prompt"}:
            redacted.append("<prompt>")
            skip_next = True
        elif index == len(argv) - 1 and argv and pathlib.Path(argv[0]).name == "claude":
            redacted[-1] = "<prompt>"
    return redacted


def require_session_allowed(manifest: pathlib.Path, provider: str) -> dict[str, Any]:
    completed = run([
        str(PRISM),
        "session-check",
        "--manifest",
        str(manifest),
        "--provider",
        provider,
        "--require-existing-session",
    ])
    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"session-check returned invalid JSON: {completed.stdout}") from exc
    if completed.returncode != 0:
        raise SystemExit(json.dumps({
            "ok": False,
            "stage": "session-check",
            "provider": provider,
            "blocked": payload.get("blocked", []),
        }, ensure_ascii=False))
    return payload


def provider_record(manifest: pathlib.Path, provider: str) -> dict[str, Any]:
    payload = load_json(manifest)
    if not isinstance(payload, dict):
        raise SystemExit("session manifest must be a JSON object")
    providers = payload.get("providers")
    if not isinstance(providers, dict) or provider not in providers:
        raise SystemExit(f"session manifest missing provider: {provider}")
    record = providers[provider]
    if not isinstance(record, dict):
        raise SystemExit(f"provider record must be object: {provider}")
    return record


def parse_manifest_time(value: Any) -> dt.datetime | None:
    if not isinstance(value, str) or not value.strip():
        return None
    try:
        parsed = dt.datetime.fromisoformat(value)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed.astimezone(dt.timezone.utc)


def task_timeout_budget(manifest: pathlib.Path, task_total_timeout_seconds: float | None) -> dict[str, Any] | None:
    if task_total_timeout_seconds is None:
        return None
    payload = load_json(manifest)
    if not isinstance(payload, dict):
        raise SystemExit("session manifest must be a JSON object")
    created_at = parse_manifest_time(payload.get("task_started_at") or payload.get("created_at"))
    if created_at is None:
        raise SystemExit("session manifest missing valid created_at for task total timeout")
    now = dt.datetime.now(dt.timezone.utc)
    elapsed = max(0.0, (now - created_at).total_seconds())
    remaining = max(0.0, task_total_timeout_seconds - elapsed)
    return {
        "task_total_timeout_seconds": task_total_timeout_seconds,
        "task_elapsed_timeout_seconds": round(elapsed, 3),
        "task_remaining_timeout_seconds": round(remaining, 3),
        "task_timeout_started_at": created_at.isoformat(),
    }


def timeout_budget_fields(budget: dict[str, Any] | None) -> dict[str, Any]:
    if not isinstance(budget, dict):
        return {
            "task_total_timeout_seconds": None,
            "task_elapsed_timeout_seconds": None,
            "task_remaining_timeout_seconds": None,
        }
    return {
        "task_total_timeout_seconds": budget.get("task_total_timeout_seconds"),
        "task_elapsed_timeout_seconds": budget.get("task_elapsed_timeout_seconds"),
        "task_remaining_timeout_seconds": budget.get("task_remaining_timeout_seconds"),
    }


def bounded_int(value: Any, default: int, *, minimum: int, maximum: int) -> int:
    if value is None:
        return default
    try:
        parsed = int(value)
    except (TypeError, ValueError):
        raise SystemExit(f"Kimi file access limit must be an integer: {value!r}")
    return max(minimum, min(maximum, parsed))


def is_relative_to(path: pathlib.Path, parent: pathlib.Path) -> bool:
    try:
        path.relative_to(parent)
        return True
    except ValueError:
        return False


def repo_relative_path(path: pathlib.Path) -> str:
    try:
        return str(path.relative_to(REPO_ROOT))
    except ValueError:
        return str(path)


def denied_kimi_file_access_path(path: pathlib.Path) -> str | None:
    parts = set(path.parts)
    denied_parts = sorted(parts & KIMI_FILE_ACCESS_DENIED_PARTS)
    if denied_parts:
        return f"path contains denied segment: {denied_parts[0]}"
    if path.name in KIMI_FILE_ACCESS_DENIED_FILENAMES:
        return f"path uses denied filename: {path.name}"
    return None


def resolve_kimi_allowed_path(raw_path: str) -> pathlib.Path:
    candidate = pathlib.Path(raw_path).expanduser()
    if not candidate.is_absolute():
        candidate = REPO_ROOT / candidate
    resolved = candidate.resolve()
    if not is_relative_to(resolved, REPO_ROOT):
        raise SystemExit(f"Kimi file access path must stay inside the RedCap repo: {raw_path}")
    denied_reason = denied_kimi_file_access_path(resolved)
    if denied_reason is not None:
        raise SystemExit(f"Kimi file access path denied: {raw_path}: {denied_reason}")
    return resolved


def kimi_file_access_config(request_payload: dict[str, Any]) -> dict[str, Any]:
    raw_config = request_payload.get("file_access")
    if raw_config is None:
        raw_config = request_payload.get("kimi_file_access")
    if raw_config is None:
        return {"mode": "prompt-only"}
    if not isinstance(raw_config, dict):
        raise SystemExit("Kimi file_access must be a JSON object")
    mode = str(raw_config.get("mode") or "prompt-only").strip()
    if mode not in KIMI_FILE_ACCESS_MODES:
        raise SystemExit(f"Kimi file_access.mode must be one of {sorted(KIMI_FILE_ACCESS_MODES)}")
    if mode == "prompt-only":
        return {"mode": "prompt-only"}
    raw_paths = raw_config.get("allowed_paths")
    if raw_paths is None:
        raw_paths = raw_config.get("paths")
    if not isinstance(raw_paths, list) or not raw_paths:
        raise SystemExit("Kimi bounded-read file_access requires non-empty allowed_paths")
    allowed_paths: list[pathlib.Path] = []
    for raw_path in raw_paths:
        if not isinstance(raw_path, str) or not raw_path.strip():
            raise SystemExit("Kimi bounded-read allowed_paths must contain non-empty strings")
        allowed_paths.append(resolve_kimi_allowed_path(raw_path.strip()))
    max_files = bounded_int(
        raw_config.get("max_files"),
        DEFAULT_KIMI_FILE_MAX_FILES,
        minimum=1,
        maximum=100,
    )
    if len(allowed_paths) > max_files:
        raise SystemExit(f"Kimi bounded-read allowed_paths exceeds max_files: {len(allowed_paths)} > {max_files}")
    return {
        "mode": "bounded-read",
        "allowed_paths": allowed_paths,
        "purpose": str(raw_config.get("purpose") or "Prism review file evidence").strip(),
        "max_files": max_files,
        "max_directory_entries": bounded_int(
            raw_config.get("max_directory_entries"),
            DEFAULT_KIMI_FILE_MAX_DIRECTORY_ENTRIES,
            minimum=1,
            maximum=1000,
        ),
        "max_bytes_per_file": bounded_int(
            raw_config.get("max_bytes_per_file"),
            DEFAULT_KIMI_FILE_MAX_BYTES_PER_FILE,
            minimum=1024,
            maximum=200_000,
        ),
        "max_total_bytes": bounded_int(
            raw_config.get("max_total_bytes"),
            DEFAULT_KIMI_FILE_MAX_TOTAL_BYTES,
            minimum=1024,
            maximum=1_000_000,
        ),
    }


def directory_listing(path: pathlib.Path, max_entries: int) -> tuple[list[dict[str, Any]], bool]:
    entries: list[dict[str, Any]] = []
    truncated = False
    for child in sorted(path.rglob("*")):
        denied_reason = denied_kimi_file_access_path(child)
        if denied_reason is not None:
            continue
        entries.append({
            "path": repo_relative_path(child),
            "kind": "directory" if child.is_dir() else "file",
            "size_bytes": child.stat().st_size if child.is_file() else None,
        })
        if len(entries) >= max_entries:
            truncated = True
            break
    return entries, truncated


def read_limited_text(path: pathlib.Path, max_bytes: int, remaining_total: int) -> tuple[str, int, bool]:
    read_limit = min(max_bytes, max(0, remaining_total))
    if read_limit <= 0:
        return "", 0, True
    with path.open("rb") as handle:
        data = handle.read(read_limit + 1)
    truncated = len(data) > read_limit
    data = data[:read_limit]
    return data.decode("utf-8", errors="replace"), len(data), truncated


def build_kimi_file_bundle(config: dict[str, Any], bundle_path: pathlib.Path, request_path: pathlib.Path) -> dict[str, Any]:
    remaining_total = int(config["max_total_bytes"])
    entries: list[dict[str, Any]] = []
    for path in config["allowed_paths"]:
        if not path.exists():
            entries.append({
                "path": repo_relative_path(path),
                "kind": "missing",
                "error": "path does not exist",
            })
            continue
        if path.is_dir():
            listing, truncated = directory_listing(path, int(config["max_directory_entries"]))
            entries.append({
                "path": repo_relative_path(path),
                "kind": "directory",
                "listing_truncated": truncated,
                "listing_count": len(listing),
                "listing": listing,
            })
            continue
        if not path.is_file():
            entries.append({
                "path": repo_relative_path(path),
                "kind": "unsupported",
                "error": "path is not a regular file or directory",
            })
            continue
        content, bytes_read, truncated = read_limited_text(path, int(config["max_bytes_per_file"]), remaining_total)
        remaining_total -= bytes_read
        entries.append({
            "path": repo_relative_path(path),
            "kind": "file",
            "size_bytes": path.stat().st_size,
            "bytes_included": bytes_read,
            "content_truncated": truncated,
            "content": content,
        })
    bundle = {
        "schema_id": KIMI_FILE_BUNDLE_SCHEMA_ID,
        "mode": "bounded-read",
        "created_at": dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat(),
        "request_path": str(request_path),
        "purpose": config["purpose"],
        "limits": {
            "max_files": config["max_files"],
            "max_directory_entries": config["max_directory_entries"],
            "max_bytes_per_file": config["max_bytes_per_file"],
            "max_total_bytes": config["max_total_bytes"],
        },
        "entries": entries,
    }
    write_json_file(bundle_path, bundle)
    return bundle


def apply_kimi_file_access(prompt: str, request: pathlib.Path, out_path: pathlib.Path) -> tuple[str, dict[str, Any]]:
    payload = load_json(request)
    if not isinstance(payload, dict):
        raise SystemExit(f"request must be a JSON object: {request}")
    config = kimi_file_access_config(payload)
    if config["mode"] == "prompt-only":
        summary = {
            "mode": "prompt-only",
            "bundle_path": None,
            "entry_count": 0,
            "rule": "Kimi may use only the prompt text and must not inspect files.",
        }
        prompt = prompt + "\n\n--- KIMI FILE ACCESS ---\nmode: prompt-only\nNo file reading is authorized for this review.\n"
        return prompt, summary

    bundle_path = out_path.with_suffix(".files.json")
    bundle = build_kimi_file_bundle(config, bundle_path, request)
    summary = {
        "mode": "bounded-read",
        "bundle_path": str(bundle_path),
        "bundle_sha256": sha256_file(bundle_path),
        "entry_count": len(bundle.get("entries", [])),
        "allowed_paths": [repo_relative_path(path) for path in config["allowed_paths"]],
        "limits": bundle.get("limits", {}),
        "rule": "Kimi may read only the generated file bundle and must not inspect any other file.",
    }
    prompt = prompt + "\n\n".join([
        "",
        "--- AUTHORIZED FILE ACCESS ---",
        "mode: bounded-read",
        f"Authorized bundle JSON: {bundle_path}",
        f"Bundle sha256: {summary['bundle_sha256']}",
        "Rules:",
        "- You may read only this generated bundle JSON if file evidence is needed.",
        "- Do not inspect the original source paths directly.",
        "- Do not run commands.",
        "- If the bundle is insufficient, report missing evidence instead of fetching more files.",
        "",
    ])
    return prompt, summary


def build_brief(provider: str, request: pathlib.Path, out_path: pathlib.Path) -> tuple[str, dict[str, Any] | None]:
    completed = run([
        str(PRISM),
        "brief",
        "--provider",
        provider,
        "--request",
        str(request),
        "--out",
        str(out_path),
        "--inline-request",
    ])
    if completed.returncode != 0:
        raise SystemExit(completed.stderr or completed.stdout)
    prompt = out_path.read_text(encoding="utf-8")
    file_access: dict[str, Any] | None = None
    if provider == "kimi":
        prompt, file_access = apply_kimi_file_access(prompt, request, out_path)
        out_path.write_text(prompt, encoding="utf-8")
    return prompt, file_access


def iter_json_objects(text: str) -> list[dict[str, Any]]:
    objects: list[dict[str, Any]] = []
    starts = [index for index, char in enumerate(text) if char == "{"]
    decoder = json.JSONDecoder()
    for start in starts:
        try:
            parsed, _ = decoder.raw_decode(text[start:])
        except json.JSONDecodeError:
            continue
        if isinstance(parsed, dict):
            objects.append(parsed)
            result = parsed.get("result")
            if isinstance(result, str):
                objects.extend(iter_json_objects(result))
    return objects


def extract_review(raw_text: str, provider: str) -> dict[str, Any]:
    for obj in iter_json_objects(raw_text):
        if REQUIRED_REVIEW_KEYS.issubset(obj.keys()) and obj.get("provider") == provider:
            if obj.get("verdict") not in {"pass", "concern", "block"}:
                continue
            return normalize_review(obj, provider)
    for text in candidate_markdown_texts(raw_text):
        for obj in iter_json_objects(text):
            if REQUIRED_REVIEW_KEYS.issubset(obj.keys()) and obj.get("provider") == provider:
                if obj.get("verdict") not in {"pass", "concern", "block"}:
                    continue
                return normalize_review(obj, provider)
        markdown_review = extract_markdown_review(text, provider)
        if markdown_review is not None:
            return normalize_review(markdown_review, provider)
    raise SystemExit(json.dumps({
        "ok": False,
        "stage": "extract-review",
        "provider": provider,
        "reason": "provider output did not contain a valid Prism review JSON object",
    }, ensure_ascii=False))


def normalize_review(review: dict[str, Any], provider: str) -> dict[str, Any]:
    normalized = dict(review)
    normalized["provider"] = provider
    for key in ["top_risks", "missing_evidence"]:
        value = normalized.get(key)
        if isinstance(value, str):
            normalized[key] = [value] if value.strip() else []
        elif isinstance(value, list):
            normalized[key] = [str(item) for item in value]
        else:
            normalized[key] = []
    anti_loop = normalized.get("anti_loop_signal")
    if not isinstance(anti_loop, dict):
        text = str(anti_loop or "").strip()
        normalized["anti_loop_signal"] = {
            "present": bool(text),
            "reason": text or "No anti-loop signal provided.",
        }
    else:
        anti_loop_reason = str(anti_loop.get("reason") or "No anti-loop signal provided.")
        anti_loop_present = bool(anti_loop.get("present"))
        if re.search(r"\bpresent\s*:\s*false\b", anti_loop_reason, flags=re.I):
            anti_loop_present = False
        normalized["anti_loop_signal"] = {
            "present": anti_loop_present,
            "reason": anti_loop_reason,
        }
    for key in ["reality_delta", "main_concern", "minimum_fix", "user_intent_alignment"]:
        normalized[key] = str(normalized.get(key) or "")
    return normalized


def candidate_markdown_texts(raw_text: str) -> list[str]:
    candidates: list[str] = []
    for obj in iter_json_objects(raw_text):
        result = obj.get("result")
        if isinstance(result, str):
            candidates.append(result)
        content = obj.get("content")
        if isinstance(content, str):
            candidates.append(content)
        for stream_name in ["stdout", "stderr"]:
            stream = obj.get(stream_name)
            if isinstance(stream, str):
                for nested in iter_json_objects(stream):
                    nested_result = nested.get("result")
                    if isinstance(nested_result, str):
                        candidates.append(nested_result)
                    nested_content = nested.get("content")
                    if isinstance(nested_content, str):
                        candidates.append(nested_content)
                candidates.extend(kimi_text_part_candidates(stream))
                candidates.append(stream)
    candidates.extend(kimi_text_part_candidates(raw_text))
    candidates.append(raw_text)
    return candidates


def kimi_text_part_candidates(raw_text: str) -> list[str]:
    candidates: list[str] = []
    pattern = re.compile(
        r"TextPart\(\s*type=['\"]text['\"]\s*,\s*text=(?P<literal>'(?:\\.|[^'])*'|\"(?:\\.|[^\"])*\")\s*\)",
        flags=re.S,
    )
    for match in pattern.finditer(raw_text):
        try:
            value = ast.literal_eval(match.group("literal"))
        except (SyntaxError, ValueError):
            value = decode_broken_kimi_text_literal(match.group("literal"))
        if isinstance(value, str) and value.strip():
            candidates.append(value)
            repaired = remove_wrapped_newlines_inside_json_strings(value)
            if repaired != value:
                candidates.append(repaired)
    return candidates


def decode_broken_kimi_text_literal(literal: str) -> str:
    if len(literal) < 2:
        return ""
    value = literal[1:-1]
    return (
        value
        .replace("\\n", "\n")
        .replace("\\t", "\t")
        .replace("\\'", "'")
        .replace('\\"', '"')
    )


def remove_wrapped_newlines_inside_json_strings(text: str) -> str:
    chars: list[str] = []
    in_string = False
    escaped = False
    for char in text:
        if char == "\n" and in_string:
            continue
        chars.append(char)
        if escaped:
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == '"':
            in_string = not in_string
    return "".join(chars)


def markdown_section(text: str, name: str) -> str:
    target = normalize_heading(name)
    patterns = [
        r"\*\*([^*\n]+?):\*\*\s*(.*?)(?=\s*/?\s*\*{2}[^*\n]+(?::\*\*|\*\*\s*:)|\n\*\*[^*\n]+(?::\*\*|\*\*\s*:)|\n#{2,6}\s+|\n---|\Z)",
        r"\*\*([^*\n]+?)\*\*\s*:\s*(.*?)(?=\s*/?\s*\*{2}[^*\n]+(?::\*\*|\*\*\s*:)|\n\*\*[^*\n]+(?::\*\*|\*\*\s*:)|\n#{2,6}\s+|\n---|\Z)",
    ]
    for pattern in patterns:
        for match in re.finditer(pattern, text, flags=re.S):
            label = normalize_heading(match.group(1))
            if label == target or label.startswith(f"{target}_"):
                return match.group(2).strip()
    heading_value = markdown_heading_section(text, name)
    if heading_value:
        return heading_value
    return ""


def first_heading_body(text: str) -> str:
    headings = list(re.finditer(r"(?:^|\n)#{2,6}\s+(.+?)(?:\n|$)", text))
    if not headings:
        return text.strip()
    body_start = headings[0].end()
    body_end = headings[1].start() if len(headings) > 1 else len(text)
    return text[body_start:body_end].strip()


def normalize_heading(value: str) -> str:
    cleaned = re.sub(r"[*`]", "", value).strip().lower()
    return re.sub(r"[^a-z0-9]+", "_", cleaned).strip("_")


def markdown_heading_section(text: str, name: str) -> str:
    target = normalize_heading(name)
    headings = list(re.finditer(r"(?:^|\n)#{2,6}\s+(.+?)(?:\n|$)", text))
    for index, match in enumerate(headings):
        raw_heading = match.group(1).strip()
        heading_name = raw_heading
        inline_value = ""
        if ":" in raw_heading:
            heading_name, inline_value = raw_heading.split(":", 1)
        if normalize_heading(heading_name) != target:
            continue
        body_start = match.end()
        body_end = headings[index + 1].start() if index + 1 < len(headings) else len(text)
        parts = []
        if inline_value.strip():
            parts.append(inline_value.strip())
        body = text[body_start:body_end].strip()
        if body:
            parts.append(body)
        return "\n".join(parts).strip()
    return ""


def markdown_scalar(text: str, name: str) -> str:
    if name.lower() == "confidence":
        for line in text.splitlines():
            if re.search(r"\bverdict\b", line, flags=re.I) and re.search(r"\bconfidence\b", line, flags=re.I):
                verdict_line = re.search(r"\bconfidence\s*:\s*[*`\s]*([a-z]+)", line, flags=re.I)
                if verdict_line:
                    cleaned_confidence = re.sub(r"[*`]", "", verdict_line.group(1)).strip().lower()
                    for allowed in ["low", "medium", "high"]:
                        if cleaned_confidence == allowed or re.match(rf"^{re.escape(allowed)}(?:[\s.:-]|$)", cleaned_confidence):
                            return allowed
    inline = re.search(
        rf"\*\*\s*{re.escape(name)}\s*:\s*([^*\n]+?)\s*\*\*",
        text,
        flags=re.I,
    )
    if inline:
        cleaned_inline = re.sub(r"[*`]", "", inline.group(1)).strip().lower()
        for allowed in ["pass", "concern", "block", "low", "medium", "high", "aligned", "unclear", "drifting", "misaligned"]:
            if cleaned_inline == allowed or re.match(rf"^{re.escape(allowed)}(?:[\s.:-]|$)", cleaned_inline):
                return allowed
        return cleaned_inline
    value = markdown_section(text, name)
    first_line = value.splitlines()[0].strip() if value else ""
    cleaned = re.sub(r"[*`]", "", first_line).strip()
    for allowed in ["pass", "concern", "block", "low", "medium", "high", "aligned", "unclear", "drifting", "misaligned"]:
        if cleaned == allowed or re.match(rf"^{re.escape(allowed)}(?:[\s.:-]|$)", cleaned):
            return allowed
    return cleaned


def markdown_list(section: str) -> list[str]:
    items: list[str] = []
    current: list[str] = []
    for line in section.splitlines():
        if re.match(r"^\s*(?:[-*]|\d+\.)\s+", line):
            if current:
                items.append(" ".join(part.strip() for part in current if part.strip()))
            current = [re.sub(r"^\s*(?:[-*]|\d+\.)\s+", "", line).strip()]
        elif current and line.strip():
            current.append(line.strip())
    if current:
        items.append(" ".join(part.strip() for part in current if part.strip()))
    if not items and section.strip():
        items = [section.strip()]
    return items[:3]


def parse_anti_loop(section: str) -> dict[str, Any]:
    json_match = re.search(r"```json\s*(\{.*?\})\s*```", section, flags=re.S)
    if json_match:
        try:
            payload = json.loads(json_match.group(1))
        except json.JSONDecodeError:
            payload = {}
        if isinstance(payload, dict):
            return {
                "present": bool(payload.get("present")),
                "reason": str(payload.get("reason") or section.strip()),
            }
    normalized = re.sub(r"\s+", " ", section.strip().lower())
    if re.search(r"\b(no|none|not)\b.{0,40}\b(anti[- ]?loop|loop signal)\b", normalized):
        return {
            "present": False,
            "reason": section.strip() or "No anti-loop signal provided.",
        }
    return {
        "present": bool(section.strip()),
        "reason": section.strip() or "No anti-loop signal provided.",
    }


def summary_required_now_finding(text: str) -> str:
    match = re.search(
        r"\*\*(?:one\s+)?(?:required-now\s+)?(?:finding|concern)[^:]*:\s*(.+?)\*\*",
        text,
        flags=re.I | re.S,
    )
    if match:
        return re.sub(r"\s+", " ", match.group(1)).strip()
    return ""


def summary_minimum_fix(text: str) -> str:
    match = re.search(r"\bFix is\s+(.+?)(?:\n\s*\n|$)", text, flags=re.I | re.S)
    if match:
        return re.sub(r"\s+", " ", match.group(1)).strip()
    match = re.search(r"\bMinimum fix(?:\s+is)?[:\s]+(.+?)(?:\n\s*\n|$)", text, flags=re.I | re.S)
    if match:
        return re.sub(r"\s+", " ", match.group(1)).strip()
    return ""


def extract_markdown_review(raw_text: str, provider: str) -> dict[str, Any] | None:
    verdict = markdown_scalar(raw_text, "verdict")
    confidence = markdown_scalar(raw_text, "confidence")
    if verdict not in {"pass", "concern", "block"} or confidence not in {"low", "medium", "high"}:
        return None
    summary_body = first_heading_body(raw_text)
    review = {
        "provider": provider,
        "verdict": verdict,
        "confidence": confidence,
        "reality_delta": markdown_section(raw_text, "reality_delta"),
        "main_concern": markdown_section(raw_text, "main_concern"),
        "top_risks": markdown_list(markdown_section(raw_text, "top_risks")),
        "missing_evidence": markdown_list(markdown_section(raw_text, "missing_evidence")),
        "minimum_fix": markdown_section(raw_text, "minimum_fix"),
        "anti_loop_signal": parse_anti_loop(markdown_section(raw_text, "anti_loop_signal")),
        "user_intent_alignment": markdown_scalar(raw_text, "user_intent_alignment"),
    }
    if not review["reality_delta"] and verdict == "pass":
        review["reality_delta"] = summary_body
    if not review["main_concern"] and verdict == "pass":
        review["main_concern"] = "No blocking concern provided by provider."
    if not review["minimum_fix"] and verdict == "pass":
        review["minimum_fix"] = "Accept. No code changes needed."
    if verdict in {"concern", "block"}:
        if not review["reality_delta"]:
            review["reality_delta"] = summary_body
        if not review["main_concern"]:
            review["main_concern"] = summary_required_now_finding(raw_text) or summary_body
        if not review["minimum_fix"]:
            review["minimum_fix"] = (
                summary_minimum_fix(raw_text)
                or "Address the provider concern before claiming completion."
            )
    if not REQUIRED_REVIEW_KEYS.issubset(review.keys()):
        return None
    if review["user_intent_alignment"] not in {"aligned", "unclear", "drifting", "misaligned"}:
        review["user_intent_alignment"] = "unclear"
    if not review["reality_delta"] or not review["main_concern"] or not review["minimum_fix"]:
        return None
    return review


def extract_kimi_handle(raw_text: str, fallback: str | None) -> str | None:
    for obj in iter_json_objects(raw_text):
        session_id = obj.get("session_id")
        command = obj.get("command")
        content = obj.get("content")
        is_resume_hint = (
            obj.get("type") == "session.resume_hint"
            or (isinstance(command, str) and "kimi -r" in command)
            or (isinstance(content, str) and content.strip().startswith("To resume this session: kimi -r "))
        )
        if is_resume_hint and isinstance(session_id, str) and session_id.strip():
            return session_id.strip()
    match = re.search(
        r"(?m)^\s*To resume this session:\s*kimi\s+-r\s+(session_[0-9a-fA-F-]{36}|[0-9a-fA-F-]{36})\s*$",
        raw_text,
    )
    if match:
        return match.group(1)
    return fallback


def extract_provider_handle(raw_text: str, provider: str, fallback: str | None) -> str | None:
    if provider == "kimi":
        return extract_kimi_handle(raw_text, fallback)
    if provider == "claude-code":
        for obj in iter_json_objects(raw_text):
            session_id = obj.get("session_id")
            if isinstance(session_id, str) and session_id:
                return session_id
            for stream_name in ["stdout", "stderr"]:
                stream = obj.get(stream_name)
                if isinstance(stream, str):
                    for nested in iter_json_objects(stream):
                        session_id = nested.get("session_id")
                        if isinstance(session_id, str) and session_id:
                            return session_id
    return fallback


def assert_provider_command_safe(argv: list[str]) -> None:
    if "bypassPermissions" in argv:
        raise SystemExit("unsafe provider command: claude must not use bypassPermissions during Prism review")
    if argv and pathlib.Path(argv[0]).name == "kimi":
        if "--plan" in argv:
            raise SystemExit("unsafe provider command: kimi prompt mode cannot combine with plan mode")
        if "-p" not in argv and "--prompt" not in argv:
            raise SystemExit("unsafe provider command: kimi must run in non-interactive prompt mode during Prism review")
        if "--skills-dir" not in argv or str(KIMI_EMPTY_SKILLS_DIR) not in argv:
            raise SystemExit("unsafe provider command: kimi must use the Prism empty skills directory")
        if "--output-format" not in argv or "stream-json" not in argv:
            raise SystemExit("unsafe provider command: kimi must use stream-json output during Prism review")
        for forbidden in ["--work-dir", "--agent-file", "--print", "--final-message-only", "--max-steps-per-turn", "-y", "--yolo", "--auto"]:
            if forbidden in argv:
                raise SystemExit(f"unsafe provider command: kimi must not use unsupported or unsafe option {forbidden}")
        if str(REPO_ROOT) in argv:
            raise SystemExit("unsafe provider command: kimi must not use the RedCap repo as work-dir during Prism review")
    if argv and argv[0] == "claude":
        if "plan" not in argv:
            raise SystemExit("unsafe provider command: claude must run in plan permission mode during Prism review")
        if "--tools" not in argv or "" not in argv:
            raise SystemExit("unsafe provider command: claude Prism review must disable tools")
        if "--disallowedTools" in argv or "--disallowed-tools" in argv:
            raise SystemExit("unsafe provider command: claude Prism review should rely on --tools '' instead of stale deny lists")
        if "--json-schema" not in argv:
            raise SystemExit("unsafe provider command: claude Prism review must request structured JSON output")


def provider_command(provider: str, handle: str | None, prompt: str, max_steps: int) -> tuple[list[str], str | None]:
    if provider == "kimi":
        KIMI_EMPTY_SKILLS_DIR.mkdir(parents=True, exist_ok=True)
        argv = [
            "kimi",
            "--skills-dir",
            str(KIMI_EMPTY_SKILLS_DIR),
        ]
        if handle:
            argv.extend(["--session", handle])
        argv.extend(["-p", prompt, "--output-format", "stream-json"])
        assert_provider_command_safe(argv)
        return argv, handle
    if provider == "claude-code":
        if handle:
            argv = [
                "claude",
                "--print",
                "--output-format",
                "json",
                "--permission-mode",
                "plan",
                "--tools",
                "",
                "--json-schema",
                review_json_schema_arg(),
                "--resume",
                handle,
                prompt,
            ]
            assert_provider_command_safe(argv)
            return argv, handle
        next_handle = str(uuid.uuid4())
        argv = [
            "claude",
            "--print",
            "--output-format",
            "json",
            "--permission-mode",
            "plan",
            "--tools",
            "",
            "--json-schema",
            review_json_schema_arg(),
            "--session-id",
            next_handle,
            prompt,
        ]
        assert_provider_command_safe(argv)
        return argv, next_handle
    raise SystemExit(f"unsupported provider: {provider}")


def write_provider_timeout_raw(
    raw_out: pathlib.Path,
    argv: list[str],
    exc: ProviderTimeoutError,
    max_retries: int,
    provider: str,
    task_timeout_budget_value: dict[str, Any] | None = None,
) -> dict[str, Any]:
    payload = {
        "argv": redacted_argv(argv),
        "attempts": exc.attempts,
        "exit_code": None,
        "timeout_seconds": exc.timeout_seconds,
        "total_timeout_seconds": exc.total_timeout_seconds,
        **timeout_budget_fields(task_timeout_budget_value or exc.task_timeout_budget),
        "max_retries": max_retries,
        "reason": exc.reason,
    }
    write_raw_and_meta(raw_out, payload, provider, raw_kind="provider-timeout")
    return payload


def update_session(manifest: pathlib.Path, provider: str, handle: str | None, review_path: pathlib.Path) -> None:
    argv = [
        str(PRISM),
        "session-update",
        "--manifest",
        str(manifest),
        "--provider",
        provider,
        "--increment-round",
        "--provider-status",
        "active",
        "--last-review",
        str(review_path),
    ]
    if handle:
        argv.extend(["--session-handle", handle])
    completed = run(argv)
    if completed.returncode != 0:
        raise SystemExit(completed.stderr or completed.stdout)


def update_session_handle(manifest: pathlib.Path, provider: str, handle: str) -> None:
    completed = run([
        str(PRISM),
        "session-update",
        "--manifest",
        str(manifest),
        "--provider",
        provider,
        "--session-handle",
        handle,
        "--provider-status",
        "active",
    ])
    if completed.returncode != 0:
        raise SystemExit(completed.stderr or completed.stdout)


def mark_session_expired(manifest: pathlib.Path, provider: str, handle: str | None, reason: str) -> None:
    argv = [
        str(PRISM),
        "session-update",
        "--manifest",
        str(manifest),
        "--provider",
        provider,
        "--provider-status",
        "expired",
        "--status",
        "active",
        "--convergence-state",
        "unresolved",
        "--convergence-reason",
        reason,
    ]
    if handle:
        argv.extend(["--session-handle", handle])
    completed = run(argv)
    if completed.returncode != 0:
        raise SystemExit(completed.stderr or completed.stdout)


def provider_success_raw(run_dir: pathlib.Path, provider: str, max_age_hours: float | None) -> bool:
    raw_files = sorted(run_dir.glob("*.raw.json"), key=lambda path: path.stat().st_mtime, reverse=True)
    now = time.time()
    for path in raw_files:
        if max_age_hours is not None and now - path.stat().st_mtime > max_age_hours * 3600:
            continue
        meta_ok, _, meta = verify_raw_meta(raw_meta_path(path))
        if not meta_ok or meta.get("provider") != provider:
            continue
        try:
            payload = load_json(path)
        except SystemExit:
            continue
        if payload.get("exit_code") == 0 and (
            isinstance(payload.get("stdout"), str) or isinstance(payload.get("stderr"), str)
        ):
            return True
    return False


def provider_valid_review(run_dir: pathlib.Path, provider: str) -> bool:
    for path in run_dir.glob("*.review.json"):
        try:
            payload = load_json(path)
        except SystemExit:
            continue
        if REQUIRED_REVIEW_KEYS.issubset(payload.keys()) and payload.get("provider") == provider:
            return True
    return False


def cmd_verify_evidence(args: argparse.Namespace) -> int:
    run_dir = pathlib.Path(args.evidence_run_dir).resolve()
    providers = [provider.strip() for provider in args.providers.split(",") if provider.strip()]
    max_age_hours = args.max_age_hours
    manifest = load_json(run_dir / "session.json")
    failures: list[str] = []
    provider_records = manifest.get("providers", {}) if isinstance(manifest, dict) else {}
    for provider in providers:
        if provider not in ALLOWED_PROVIDERS:
            failures.append(f"unsupported provider in evidence check: {provider}")
            continue
        record = provider_records.get(provider) if isinstance(provider_records, dict) else None
        if not isinstance(record, dict):
            failures.append(f"{provider}: missing session manifest record")
            continue
        if not isinstance(record.get("session_handle"), str) or not record.get("session_handle"):
            failures.append(f"{provider}: missing provider session handle")
        if not isinstance(record.get("round_count"), int) or record.get("round_count", 0) < 1:
            failures.append(f"{provider}: no completed provider round recorded")
        if not provider_success_raw(run_dir, provider, max_age_hours):
            failures.append(f"{provider}: no successful raw provider output with valid metadata found")
        if not provider_valid_review(run_dir, provider):
            failures.append(f"{provider}: no valid extracted review found")
    result = {
        "ok": not failures,
        "run_dir": str(run_dir),
        "providers": providers,
        "max_age_hours": max_age_hours,
        "failures": failures,
    }
    print(json.dumps(result, ensure_ascii=False, indent=2))
    if failures:
        return 1
    print("PRISM_DISPATCH_EVIDENCE_OK")
    return 0


def cmd_verify_raw_meta(args: argparse.Namespace) -> int:
    if args.raw_meta:
        meta_path = pathlib.Path(args.raw_meta).resolve()
    elif args.raw_out:
        meta_path = raw_meta_path(pathlib.Path(args.raw_out).resolve())
    else:
        raise SystemExit("--raw-meta or --raw-out is required with --verify-raw-meta")
    ok, failures, meta = verify_raw_meta(meta_path)
    print(json.dumps({
        "ok": ok,
        "meta_path": str(meta_path),
        "raw_path": meta.get("raw_path") if isinstance(meta, dict) else None,
        "metadata": meta if ok else None,
        "failures": failures,
    }, ensure_ascii=False, indent=2))
    if not ok:
        return 1
    print("PRISM_RAW_META_OK")
    return 0


def cmd_timeout_report(args: argparse.Namespace) -> int:
    if args.raw_meta:
        meta_path = pathlib.Path(args.raw_meta).resolve()
    elif args.raw_out:
        meta_path = raw_meta_path(pathlib.Path(args.raw_out).resolve())
    else:
        raise SystemExit("--raw-meta or --raw-out is required with --timeout-report")
    ok, failures, meta = verify_raw_meta(meta_path)
    if not ok:
        print(json.dumps({
            "ok": False,
            "summary_zh": "超时报告无法生成，因为原始输出元数据未通过校验。",
            "failures": failures,
        }, ensure_ascii=False, indent=2))
        return 1
    raw_path_value = meta.get("raw_path")
    raw_payload = load_json(pathlib.Path(str(raw_path_value)))
    attempts = raw_payload.get("attempts") if isinstance(raw_payload, dict) else []
    attempts = [attempt for attempt in attempts if isinstance(attempt, dict)]
    timed_out = bool(meta.get("timed_out"))
    timeout_scopes = sorted({
        str(attempt.get("timeout_scope"))
        for attempt in attempts
        if attempt.get("timed_out") is True and attempt.get("timeout_scope")
    })
    reason = str(raw_payload.get("reason") or "") if isinstance(raw_payload, dict) else ""
    provider = str(meta.get("provider") or "unknown")
    if not timed_out:
        summary = f"{provider} 调用没有触发超时。"
        recommended = "无需超时补救，继续按评审结果处理。"
    elif "task-total" in timeout_scopes:
        summary = f"{provider} 调用在整任务预算耗尽前被拦截，未继续启动外部评审方。"
        recommended = "由 Cap 立即裁决：缩小任务、延长整任务预算，或把该评审方标记过期后改派。"
    elif "dispatcher-total" in timeout_scopes:
        summary = f"{provider} 调用耗尽了本次委派的总预算。"
        recommended = "优先复用已捕获会话继续一次短跟进；若仍超时，交给 Cap 裁决是否降级或改派。"
    else:
        summary = f"{provider} 单次评审尝试触发超时。"
        recommended = "可以按重试策略继续；若连续触发，改为更小的分片任务。"
    report = {
        "ok": True,
        "provider": provider,
        "timed_out": timed_out,
        "timeout_scopes": timeout_scopes,
        "reason": reason,
        "summary_zh": summary,
        "recommended_action_zh": recommended,
        "attempts_count": meta.get("attempts_count"),
        "timeout_seconds": meta.get("timeout_seconds"),
        "total_timeout_seconds": meta.get("total_timeout_seconds"),
        "task_total_timeout_seconds": meta.get("task_total_timeout_seconds"),
        "task_elapsed_timeout_seconds": meta.get("task_elapsed_timeout_seconds"),
        "task_remaining_timeout_seconds": meta.get("task_remaining_timeout_seconds"),
        "raw_path": raw_path_value,
        "meta_path": str(meta_path),
    }
    print(json.dumps(report, ensure_ascii=False, indent=2))
    print("PRISM_TIMEOUT_REPORT_OK")
    return 0


def tail_text(value: Any, limit: int = 1200) -> str:
    text = output_text(value)
    if len(text) <= limit:
        return text
    return text[-limit:]


def cmd_failure_report(args: argparse.Namespace) -> int:
    if args.raw_meta:
        meta_path = pathlib.Path(args.raw_meta).resolve()
    elif args.raw_out:
        meta_path = raw_meta_path(pathlib.Path(args.raw_out).resolve())
    else:
        raise SystemExit("--raw-meta or --raw-out is required with --failure-report")
    ok, failures, meta = verify_raw_meta(meta_path)
    if not ok:
        print(json.dumps({
            "ok": False,
            "summary_zh": "失败摘要无法生成，因为原始输出元数据未通过校验。",
            "failures": failures,
        }, ensure_ascii=False, indent=2))
        return 1
    raw_path_value = meta.get("raw_path")
    raw_payload = load_json(pathlib.Path(str(raw_path_value)))
    attempts = raw_payload.get("attempts") if isinstance(raw_payload, dict) else []
    attempts = [attempt for attempt in attempts if isinstance(attempt, dict)]
    report = {
        "ok": True,
        "provider": meta.get("provider"),
        "exit_code": meta.get("exit_code"),
        "timed_out": meta.get("timed_out"),
        "summary_zh": "已通过元数据校验，只展示最近三次尝试的短尾部输出。",
        "attempts": [
            {
                "attempt": attempt.get("attempt"),
                "exit_code": attempt.get("exit_code"),
                "timed_out": attempt.get("timed_out") is True,
                "timeout_scope": attempt.get("timeout_scope"),
                "recovery": attempt.get("recovery"),
                "stdout_tail": tail_text(attempt.get("stdout")),
                "stderr_tail": tail_text(attempt.get("stderr")),
            }
            for attempt in attempts[-3:]
        ],
        "raw_path": raw_path_value,
        "meta_path": str(meta_path),
    }
    print(json.dumps(report, ensure_ascii=False, indent=2))
    print("PRISM_FAILURE_REPORT_OK")
    return 0


def cmd_timeout_policy_check(args: argparse.Namespace) -> int:
    contract_path = pathlib.Path(args.timeout_policy_contract).resolve()
    payload = load_json(contract_path)
    failures: list[str] = []
    if not isinstance(payload, dict):
        failures.append("timeout policy contract must be a JSON object")
    elif payload.get("schema_id") != "prism-timeout-governance-policy":
        failures.append("schema_id must be prism-timeout-governance-policy")
    budget_model = payload.get("budget_model") if isinstance(payload, dict) else None
    if not isinstance(budget_model, dict):
        failures.append("budget_model must be an object")
    else:
        for key in ["provider_attempt", "dispatcher_total", "task_total", "per_provider_allocation"]:
            if not isinstance(budget_model.get(key), str) or not budget_model.get(key).strip():
                failures.append(f"budget_model.{key} must be non-empty")
        if budget_model.get("per_provider_allocation") != "shared_pool":
            failures.append("budget_model.per_provider_allocation must be shared_pool")
    if payload.get("task_timing_source") != "task_started_at":
        failures.append("task_timing_source must be task_started_at")
    decisions = payload.get("post_timeout_decisions") if isinstance(payload, dict) else None
    if not isinstance(decisions, dict):
        failures.append("post_timeout_decisions must be an object")
    else:
        for key in ["provider_attempt", "dispatcher_total", "task_total", "remote_state"]:
            value = decisions.get(key)
            if not isinstance(value, str) or not value.strip():
                failures.append(f"post_timeout_decisions.{key} must be non-empty")
    print(json.dumps({"ok": not failures, "contract": str(contract_path), "failures": failures}, ensure_ascii=False, indent=2))
    if failures:
        return 1
    print("PRISM_TIMEOUT_GOVERNANCE_POLICY_OK")
    return 0


def run_provider_command(
    provider: str,
    argv: list[str],
    prompt: str,
    handle: str | None,
    planned_handle: str | None,
    max_steps: int,
    timeout_seconds: float,
    max_retries: int,
    total_timeout_seconds: float | None = None,
    task_timeout_budget_value: dict[str, Any] | None = None,
    *,
    rebuild_on_retry: bool = True,
    retry_command_builder=provider_command,
) -> tuple[subprocess.CompletedProcess[str], list[dict[str, Any]], str | None]:
    attempts: list[dict[str, Any]] = []
    current_argv = list(argv)
    current_handle = handle
    current_planned_handle = planned_handle
    captured_handle = handle or planned_handle
    started_at = time.monotonic()
    deadline = started_at + total_timeout_seconds if total_timeout_seconds is not None else None
    if task_timeout_budget_value is not None:
        remaining_task = float(task_timeout_budget_value.get("task_remaining_timeout_seconds") or 0.0)
        if remaining_task <= 0:
            attempts.append({
                "attempt": 1,
                "argv": redacted_argv(current_argv),
                "exit_code": None,
                "timed_out": True,
                "timeout_seconds": 0,
                "total_timeout_seconds": total_timeout_seconds,
                "stdout": "",
                "stderr": "task total timeout exhausted before provider attempt",
                "captured_session_handle": captured_handle,
                "timeout_scope": "task-total",
            })
            raise ProviderTimeoutError(
                attempts,
                captured_handle,
                timeout_seconds,
                total_timeout_seconds,
                "task total timeout exhausted",
                task_timeout_budget_value,
            )
        if deadline is None:
            deadline = started_at + remaining_task
        else:
            deadline = min(deadline, started_at + remaining_task)

    for attempt_number in range(1, max_retries + 2):
        effective_timeout = timeout_seconds
        if deadline is not None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                attempts.append({
                    "attempt": attempt_number,
                    "argv": redacted_argv(current_argv),
                    "exit_code": None,
                    "timed_out": True,
                    "timeout_seconds": 0,
                    "total_timeout_seconds": total_timeout_seconds,
                    "stdout": "",
                    "stderr": "dispatcher total timeout exhausted before provider attempt",
                    "captured_session_handle": captured_handle,
                    "timeout_scope": "dispatcher-total",
                })
                raise ProviderTimeoutError(
                    attempts,
                    captured_handle,
                    timeout_seconds,
                    total_timeout_seconds,
                    "dispatcher total timeout exhausted",
                    task_timeout_budget_value,
                )
            effective_timeout = min(timeout_seconds, remaining)
        try:
            completed = run(current_argv, timeout=effective_timeout)
        except subprocess.TimeoutExpired as exc:
            stdout = output_text(exc.stdout)
            stderr = output_text(exc.stderr)
            captured_handle = extract_provider_handle(stdout + "\n" + stderr, provider, captured_handle)
            attempts.append({
                "attempt": attempt_number,
                "argv": redacted_argv(current_argv),
                "exit_code": None,
                "timed_out": True,
                "timeout_seconds": effective_timeout,
                "total_timeout_seconds": total_timeout_seconds,
                "stdout": stdout,
                "stderr": stderr,
                "captured_session_handle": captured_handle,
                "timeout_scope": "dispatcher-total" if deadline is not None and time.monotonic() >= deadline else "provider-attempt",
            })
            if attempt_number <= max_retries:
                current_handle = captured_handle
                if rebuild_on_retry:
                    current_argv, current_planned_handle = retry_command_builder(provider, current_handle, prompt, max_steps)
                    captured_handle = current_handle or current_planned_handle
                continue
            raise ProviderTimeoutError(attempts, captured_handle, timeout_seconds, total_timeout_seconds, task_timeout_budget=task_timeout_budget_value) from exc

        attempts.append({
            "attempt": attempt_number,
            "argv": redacted_argv(current_argv),
            "exit_code": completed.returncode,
            "timed_out": False,
            "stdout": completed.stdout,
            "stderr": completed.stderr,
        })
        if (
            provider == "claude-code"
            and completed.returncode != 0
            and current_handle
            and "already in use" in (completed.stderr or "")
        ):
            fallback_handle = str(uuid.uuid4())
            fallback_argv = [
                "claude",
                "--print",
                "--output-format",
                "json",
                "--permission-mode",
                "plan",
                "--tools",
                "",
                "--json-schema",
                review_json_schema_arg(),
                "--session-id",
                fallback_handle,
                prompt,
            ]
            try:
                fallback_timeout = timeout_seconds
                if deadline is not None:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise subprocess.TimeoutExpired(cmd=fallback_argv, timeout=0)
                    fallback_timeout = min(timeout_seconds, remaining)
                completed = run(fallback_argv, timeout=fallback_timeout)
            except subprocess.TimeoutExpired as exc:
                stdout = output_text(exc.stdout)
                stderr = output_text(exc.stderr)
                captured_handle = extract_provider_handle(stdout + "\n" + stderr, provider, fallback_handle)
                attempts.append({
                    "attempt": attempt_number,
                    "argv": redacted_argv(fallback_argv),
                    "exit_code": None,
                    "timed_out": True,
                    "timeout_seconds": fallback_timeout if "fallback_timeout" in locals() else 0,
                    "total_timeout_seconds": total_timeout_seconds,
                    "stdout": stdout,
                    "stderr": stderr,
                    "captured_session_handle": captured_handle,
                    "recovery": "fresh-session-after-resume-busy",
                    "timeout_scope": "dispatcher-total" if deadline is not None and time.monotonic() >= deadline else "provider-attempt",
                })
                if attempt_number <= max_retries:
                    current_handle = captured_handle
                    if rebuild_on_retry:
                        current_argv, current_planned_handle = retry_command_builder(provider, current_handle, prompt, max_steps)
                        captured_handle = current_handle or current_planned_handle
                    continue
                raise ProviderTimeoutError(attempts, captured_handle, timeout_seconds, total_timeout_seconds, task_timeout_budget=task_timeout_budget_value) from exc
            attempts.append({
                "attempt": attempt_number,
                "argv": redacted_argv(fallback_argv),
                "exit_code": completed.returncode,
                "timed_out": False,
                "stdout": completed.stdout,
                "stderr": completed.stderr,
                "recovery": "fresh-session-after-resume-busy",
            })
            return completed, attempts, fallback_handle
        return completed, attempts, current_handle or current_planned_handle

    raise ProviderTimeoutError(attempts, captured_handle, timeout_seconds, total_timeout_seconds, task_timeout_budget=task_timeout_budget_value)


def cmd_dispatch(args: argparse.Namespace) -> int:
    provider = args.provider
    if provider not in ALLOWED_PROVIDERS:
        raise SystemExit(f"excluded provider: {provider}")
    manifest = pathlib.Path(args.manifest).resolve()
    if not args.review_out:
        raise SystemExit("--review-out is required")
    review_out = pathlib.Path(args.review_out).resolve()
    raw_out = pathlib.Path(args.raw_out).resolve() if args.raw_out else review_out.with_suffix(".raw.txt")
    brief_out = pathlib.Path(args.brief_out).resolve() if args.brief_out else review_out.with_suffix(".brief.md")

    if args.extract_from_raw:
        raw_text = pathlib.Path(args.extract_from_raw).resolve().read_text(encoding="utf-8")
        record = provider_record(manifest, provider)
        handle = record.get("session_handle") if isinstance(record.get("session_handle"), str) else None
        review = extract_review(raw_text, provider)
        review_out.parent.mkdir(parents=True, exist_ok=True)
        review_out.write_text(json.dumps(review, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        next_handle = extract_provider_handle(raw_text, provider, handle)
        update_session(manifest, provider, next_handle, review_out)
        print(json.dumps({
            "ok": True,
            "provider": provider,
            "review_path": str(review_out),
            "raw_path": str(pathlib.Path(args.extract_from_raw).resolve()),
            "session_handle": next_handle,
            "extract_from_raw": True,
        }, ensure_ascii=False, indent=2))
        print("PRISM_DISPATCH_EXTRACT_OK")
        return 0

    if not args.request:
        raise SystemExit("--request is required unless --extract-from-raw is used")
    request = pathlib.Path(args.request).resolve()
    session_payload = require_session_allowed(manifest, provider)
    record = provider_record(manifest, provider)
    handle = record.get("session_handle") if isinstance(record.get("session_handle"), str) else None
    prompt, file_access = build_brief(provider, request, brief_out)
    argv, planned_handle = provider_command(provider, handle, prompt, args.max_steps)
    total_timeout_seconds = args.total_timeout_seconds
    if total_timeout_seconds is None:
        total_timeout_seconds = args.timeout_seconds * (args.max_retries + 1) * DEFAULT_TOTAL_TIMEOUT_MULTIPLIER
    task_budget = task_timeout_budget(manifest, args.task_total_timeout_seconds)
    if task_budget is not None:
        remaining_task = float(task_budget.get("task_remaining_timeout_seconds") or 0.0)
        total_timeout_seconds = min(total_timeout_seconds, remaining_task)

    if args.dry_run:
        print(json.dumps({
            "ok": True,
            "dry_run": True,
            "provider": provider,
            "session_check": session_payload,
            "has_existing_handle": bool(handle),
            "planned_handle": planned_handle,
            "argv_head": redacted_argv(argv)[:8],
            "brief_path": str(brief_out),
            "file_access": file_access,
            "timeout_seconds": args.timeout_seconds,
            "total_timeout_seconds": total_timeout_seconds,
            **timeout_budget_fields(task_budget),
            "max_retries": args.max_retries,
        }, ensure_ascii=False, indent=2))
        print("PRISM_DISPATCH_DRY_RUN_OK")
        return 0

    try:
        completed, attempts, command_handle = run_provider_command(
            provider,
            argv,
            prompt,
            handle,
            planned_handle,
            args.max_steps,
            args.timeout_seconds,
            args.max_retries,
            total_timeout_seconds,
            task_budget,
        )
    except ProviderTimeoutError as exc:
        write_provider_timeout_raw(raw_out, argv, exc, args.max_retries, provider, task_budget)
        captured_handle = exc.captured_handle
        mark_session_expired(manifest, provider, captured_handle or handle, exc.reason)
        raise SystemExit(json.dumps({
            "ok": False,
            "stage": "provider-timeout",
            "provider": provider,
            "timeout_seconds": exc.timeout_seconds,
            "total_timeout_seconds": exc.total_timeout_seconds,
            **timeout_budget_fields(task_budget or exc.task_timeout_budget),
            "attempts": len(exc.attempts),
            "max_retries": args.max_retries,
            "captured_session_handle": captured_handle,
            "raw_path": str(raw_out),
            "reason": exc.reason,
        }, ensure_ascii=False))
    raw_payload = {
        "argv": redacted_argv(argv),
        "attempts": attempts,
        "exit_code": completed.returncode,
        "timeout_seconds": args.timeout_seconds,
        "total_timeout_seconds": total_timeout_seconds,
        **timeout_budget_fields(task_budget),
        "max_retries": args.max_retries,
        "file_access": file_access,
        "stdout": completed.stdout,
        "stderr": completed.stderr,
    }
    write_raw_and_meta(
        raw_out,
        raw_payload,
        provider,
        raw_kind="provider-output",
        review_path=review_out,
    )
    if completed.returncode != 0:
        captured_handle = None
        if provider == "kimi":
            captured_handle = extract_kimi_handle(completed.stdout + "\n" + completed.stderr, handle)
            if captured_handle and captured_handle != handle:
                update_session_handle(manifest, provider, captured_handle)
        raise SystemExit(json.dumps({
            "ok": False,
            "stage": "provider-call",
            "provider": provider,
            "exit_code": completed.returncode,
            "captured_session_handle": captured_handle,
            "raw_path": str(raw_out),
        }, ensure_ascii=False))

    review = extract_review(completed.stdout + "\n" + completed.stderr, provider)
    review_out.parent.mkdir(parents=True, exist_ok=True)
    review_out.write_text(json.dumps(review, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    next_handle = command_handle or planned_handle
    if provider == "kimi":
        next_handle = extract_kimi_handle(completed.stdout + "\n" + completed.stderr, command_handle or handle)
        if not next_handle:
            raise SystemExit(json.dumps({
                "ok": False,
                "stage": "session-handle",
                "provider": provider,
                "reason": "Kimi review succeeded but no resume handle was captured",
                "raw_path": str(raw_out),
            }, ensure_ascii=False))
    update_session(manifest, provider, next_handle, review_out)
    print(json.dumps({
        "ok": True,
        "provider": provider,
        "review_path": str(review_out),
        "raw_path": str(raw_out),
        "session_handle": next_handle,
    }, ensure_ascii=False, indent=2))
    print("PRISM_DISPATCH_OK")
    return 0


def cmd_self_check(_: argparse.Namespace) -> int:
    with tempfile.TemporaryDirectory(prefix="redcap-prism-dispatch-") as tmp_raw:
        tmp = pathlib.Path(tmp_raw)
        request = tmp / "request.json"
        request.write_text(json.dumps({
            "task": "dispatcher self-check",
            "user_intent": "verify dispatcher gates provider calls",
            "main_claim": "dry-run dispatch should enforce session checks",
            "changed_reality": ["self-check fixture"],
            "review_mode": "implementation_review",
            "risk_level": "low",
            "requested_providers": ["kimi", "claude-code"],
        }, ensure_ascii=False), encoding="utf-8")
        manifest_dir = tmp / "run"
        init = run([str(PRISM), "session-init", "--task-id", "dispatcher-self-check", "--run-dir", str(manifest_dir)])
        if init.returncode != 0:
            raise SystemExit(init.stderr or init.stdout)
        manifest = manifest_dir / "session.json"
        self_cmd = [sys.executable, str(pathlib.Path(__file__).resolve())]
        first = run([
            *self_cmd,
            "--provider",
            "kimi",
            "--manifest",
            str(manifest),
            "--request",
            str(request),
            "--review-out",
            str(tmp / "kimi.review.json"),
            "--dry-run",
        ])
        run([
            str(PRISM),
            "session-update",
            "--manifest",
            str(manifest),
            "--provider",
            "kimi",
            "--round-count",
            "1",
        ])
        blocked = run([
            *self_cmd,
            "--provider",
            "kimi",
            "--manifest",
            str(manifest),
            "--request",
            str(request),
            "--review-out",
            str(tmp / "blocked.review.json"),
            "--dry-run",
        ])
        file_request = tmp / "file-request.json"
        file_request.write_text(json.dumps({
