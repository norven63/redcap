#!/usr/bin/env python3
"""Small local Prism helper.

This command does not call providers. It prepares review briefs for Kimi or
Claude Code, performs lightweight JSON validation, and merges provider verdicts
without hiding disagreement.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fnmatch
import json
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from typing import Any


ROOT = pathlib.Path(__file__).resolve().parents[1]
REPO_ROOT = ROOT.parents[1]
sys.path.insert(0, str(ROOT / "lib"))
sys.path.insert(0, str(REPO_ROOT / "runtime" / "core"))
from prism_lock import file_lock, write_json_atomic, write_text_atomic  # noqa: E402
from prism_ledger import record_gate, record_manifest  # noqa: E402
from intent_judge import classify_with_policy  # noqa: E402
from prompt_intent import classify_prompt_intent  # noqa: E402

ALLOWED_PROVIDERS = {"kimi", "claude-code"}
VERDICT_RANK = {"pass": 0, "concern": 1, "block": 2}
GATE_RANK = {"skipped": 0, "optional": 1, "required": 2}
PRISM_CONCERN_RESOLUTION_SCHEMA_ID = "prism-concern-resolution"
PRISM_REBUTTAL_REQUEST_GENERATOR = "runtime/prism/bin/prism rebuttal-request"
EXECUTED_CHECK_RECEIPT_SCHEMA_ID = "redcap-executed-check-receipt"
SESSION_STATUSES = {"active", "converged", "main-decided", "escalated", "expired", "closed"}
PROVIDER_SESSION_STATUSES = {"pending", "active", "converged", "escalated", "expired", "closed"}
SELF_DEVELOPMENT_LIFECYCLE_RISKS = {"medium", "high", "critical"}
SELF_DEVELOPMENT_LIFECYCLE_TERMS = {
    "redcap",
    "prism",
    "棱镜",
    "复活",
    "scaffold",
    "脚手架",
    "architecture",
    "directory",
    "目录",
    "runtime",
    "hook",
    "session",
    "会话",
    "fsm",
    "workflow",
    "工作流",
    "lifecycle",
    "archaeology",
    "考古",
    "provider",
    "dispatcher",
    "knowledge",
    "知识库",
}
SELF_DEVELOPMENT_LIFECYCLE_TAGS = {
    "architecture",
    "redcap-revival",
    "redcap-self-development",
    "runtime",
    "hook",
    "session",
    "fsm",
    "lifecycle",
    "archaeology",
    "provider-dispatcher",
    "knowledge",
}
SELF_DEVELOPMENT_LIFECYCLE_PATH_GLOBS = {
    "AGENTS.md",
    "runtime/**",
    "assets/contracts/**",
    "assets/docs/**",
    "assets/archaeology/**",
    "assets/knowledge/**",
}
DIAGNOSTIC_ONLY_TERMS = {
    "not",
    "no ",
    "does not",
    "do not",
    "without",
    "missing",
    "unimplemented",
    "not implemented",
    "not yet",
    "has not",
    "have not",
    "未",
    "没有",
    "尚未",
    "不能",
}


def iso_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()


def load_json(path: pathlib.Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid json: {path}: {exc}") from exc


def require_keys(payload: dict[str, Any], keys: list[str], label: str) -> None:
    missing = [key for key in keys if key not in payload]
    if missing:
        raise SystemExit(f"{label} missing required keys: {', '.join(missing)}")


def validate_request(path: pathlib.Path) -> None:
    payload = load_json(path)
    if not isinstance(payload, dict):
        raise SystemExit(f"request must be an object: {path}")
    require_keys(
        payload,
        [
            "task",
            "user_intent",
            "main_claim",
            "changed_reality",
            "review_mode",
            "risk_level",
            "requested_providers",
        ],
        "request",
    )
    providers = payload.get("requested_providers")
    if not isinstance(providers, list) or not providers:
        raise SystemExit("request requested_providers must be a non-empty list")
    unknown = sorted(set(providers) - ALLOWED_PROVIDERS)
    if unknown:
        raise SystemExit(f"request includes excluded providers: {', '.join(unknown)}")


def validate_review(path: pathlib.Path) -> None:
    payload = load_json(path)
    if not isinstance(payload, dict):
        raise SystemExit(f"review must be an object: {path}")
    require_keys(
        payload,
        [
            "provider",
            "verdict",
            "confidence",
            "reality_delta",
            "main_concern",
            "top_risks",
            "missing_evidence",
            "minimum_fix",
            "anti_loop_signal",
            "user_intent_alignment",
        ],
        "review",
    )
    provider = payload.get("provider")
    if provider not in ALLOWED_PROVIDERS:
        raise SystemExit(f"review provider is excluded: {provider}")
    verdict = payload.get("verdict")
    if verdict not in VERDICT_RANK:
        raise SystemExit(f"review verdict must be pass, concern, or block: {verdict}")


def validate_capability_status(path: pathlib.Path) -> None:
    payload = load_json(path)
    if not isinstance(payload, dict):
        raise SystemExit(f"capability status must be an object: {path}")
    require_keys(payload, ["schema_id", "capability", "status", "completion_claim"], "capability status")
    if payload["schema_id"] != "redcap-capability-status":
        raise SystemExit("capability status schema_id must be redcap-capability-status")
    if payload["status"] not in {
        "not_started",
        "documented_only",
        "partially_implemented",
        "manually_runnable",
        "tested",
        "operational",
    }:
        raise SystemExit(f"invalid capability status: {payload['status']}")
    if not str(payload["completion_claim"]).strip():
        raise SystemExit("capability status completion_claim must be non-empty")


def validate_session_manifest(path: pathlib.Path) -> None:
    payload = load_json(path)
    if not isinstance(payload, dict):
        raise SystemExit(f"session manifest must be an object: {path}")
    require_keys(
        payload,
        [
            "schema_id",
            "task_id",
            "run_dir",
            "status",
            "max_rounds_per_provider",
            "created_at",
            "updated_at",
            "providers",
            "convergence",
        ],
        "session manifest",
    )
    if payload["schema_id"] != "prism-session-manifest":
        raise SystemExit("session manifest schema_id must be prism-session-manifest")
    if payload["status"] not in SESSION_STATUSES:
        raise SystemExit(f"session manifest status invalid: {payload['status']}")
    max_rounds = payload["max_rounds_per_provider"]
    if not isinstance(max_rounds, int) or max_rounds < 1 or max_rounds > 5:
        raise SystemExit("session manifest max_rounds_per_provider must be an integer from 1 to 5")
    providers = payload["providers"]
    if not isinstance(providers, dict):
        raise SystemExit("session manifest providers must be an object")
    for provider in ALLOWED_PROVIDERS:
        if provider not in providers:
            raise SystemExit(f"session manifest missing provider: {provider}")
        record = providers[provider]
        if not isinstance(record, dict):
            raise SystemExit(f"session manifest provider record must be an object: {provider}")
        require_keys(
            record,
            ["session_handle", "round_count", "status", "last_review"],
            f"session manifest provider {provider}",
        )
        handle = record["session_handle"]
        if handle is not None and not isinstance(handle, str):
            raise SystemExit(f"session_handle must be string or null: {provider}")
        round_count = record["round_count"]
        if not isinstance(round_count, int) or round_count < 0 or round_count > max_rounds:
            raise SystemExit(f"round_count invalid for {provider}")
        if record["status"] not in PROVIDER_SESSION_STATUSES:
            raise SystemExit(f"provider session status invalid for {provider}: {record['status']}")
        last_review = record["last_review"]
        if last_review is not None and not isinstance(last_review, str):
            raise SystemExit(f"last_review must be string or null: {provider}")
    convergence = payload["convergence"]
    if not isinstance(convergence, dict):
        raise SystemExit("session manifest convergence must be an object")
    require_keys(convergence, ["state", "reason"], "session manifest convergence")
    if convergence["state"] not in {"unresolved", "converged", "main-decided", "escalated"}:
        raise SystemExit(f"convergence state invalid: {convergence['state']}")
    if not isinstance(convergence["reason"], str):
        raise SystemExit("convergence reason must be a string")


def validate_gate_request(payload: dict[str, Any], label: str = "gate request") -> None:
    task = payload.get("task")
    if not isinstance(task, str) or not task.strip():
        raise SystemExit(f"{label} task must be a non-empty string")
    risk_level = payload.get("risk_level", "medium")
    if risk_level not in {"low", "medium", "high", "critical"}:
        raise SystemExit(f"{label} risk_level must be low, medium, high, or critical")
    for list_key in ["changed_paths", "tags"]:
        value = payload.get(list_key, [])
        if value is not None and not (
            isinstance(value, list) and all(isinstance(item, str) for item in value)
        ):
            raise SystemExit(f"{label} {list_key} must be a list of strings")


def non_empty_string(value: Any) -> bool:
    return isinstance(value, str) and bool(value.strip())


def non_empty_string_list(value: Any) -> bool:
    return (
        isinstance(value, list)
        and bool(value)
        and all(isinstance(item, str) and item.strip() for item in value)
    )


def resolve_reference_path(raw: str, base_dir: pathlib.Path | None = None) -> pathlib.Path:
    path = pathlib.Path(raw)
    if path.is_absolute():
        return path.resolve()
    if base_dir is not None:
        candidate = (base_dir / path).resolve()
        if candidate.exists():
            return candidate
    return (REPO_ROOT / path).resolve()


def path_matches_reference(raw: str, actual: pathlib.Path, base_dir: pathlib.Path | None = None) -> bool:
    try:
        return resolve_reference_path(raw, base_dir) == actual.resolve()
    except OSError:
        return False


def load_review_for_resolution(path: pathlib.Path, failures: list[str], label: str) -> dict[str, Any] | None:
    try:
        validate_review(path)
        review = load_json(path)
    except SystemExit as exc:
        failures.append(f"{label} invalid Prism review: {exc}")
        return None
    if not isinstance(review, dict):
        failures.append(f"{label} review must be an object")
        return None
    return review


def concern_review_key(review: dict[str, Any]) -> tuple[str, str]:
    return str(review.get("provider")), str(review.get("verdict"))


def merge_verdicts(merge: dict[str, Any]) -> list[dict[str, Any]]:
    verdicts = merge.get("verdicts")
    if isinstance(verdicts, list):
        return [item for item in verdicts if isinstance(item, dict)]
    strictest_provider = merge.get("strictest_provider")
    strictest_verdict = merge.get("strictest_verdict")
    if strictest_provider in ALLOWED_PROVIDERS and strictest_verdict in VERDICT_RANK:
        return [{"provider": strictest_provider, "verdict": strictest_verdict, "confidence": "unknown"}]
    return []


def load_resolution_reviews(
    resolution: dict[str, Any],
    resolution_dir: pathlib.Path,
    cli_reviews: list[str] | None,
    failures: list[str],
) -> list[dict[str, Any]]:
    review_refs = cli_reviews or resolution.get("reviews", [])
    if not isinstance(review_refs, list):
        failures.append("resolution.reviews must be a list when present")
        return []
    reviews: list[dict[str, Any]] = []
    for index, raw_ref in enumerate(review_refs):
        if not non_empty_string(raw_ref):
            failures.append(f"resolution.reviews[{index}] must be a non-empty path string")
            continue
        review_path = resolve_reference_path(str(raw_ref), resolution_dir)
        review = load_review_for_resolution(review_path, failures, f"resolution.reviews[{index}]")
        if review is not None:
            review["_path"] = str(review_path)
            reviews.append(review)
    return reviews


def expected_concern_reviews(
    merge: dict[str, Any],
    resolution_reviews: list[dict[str, Any]],
    failures: list[str],
) -> list[dict[str, Any]]:
    expected: list[dict[str, Any]] = [
        review for review in resolution_reviews if review.get("verdict") in {"concern", "block"}
    ]
    if expected:
        return expected
    if merge.get("must_respond") is not True:
        return []
    for item in merge_verdicts(merge):
        provider = item.get("provider")
        verdict = item.get("verdict")
        if provider in ALLOWED_PROVIDERS and verdict in {"concern", "block"}:
            expected.append({"provider": provider, "verdict": verdict, "_path": None})
    if not expected:
        failures.append("merge.must_respond=true requires concern/block review attribution through resolution.reviews or merge.verdicts")
    return expected


def validate_rebuttal_request(
    request_path: pathlib.Path,
    merge_path: pathlib.Path,
    original_review: dict[str, Any],
    failures: list[str],
) -> None:
    try:
        validate_request(request_path)
        request = load_json(request_path)
    except SystemExit as exc:
        failures.append(f"reject decision followup_request invalid: {exc}")
        return
    provider = original_review.get("provider")
    if request.get("generated_by") != PRISM_REBUTTAL_REQUEST_GENERATOR:
        failures.append("reject decision followup_request must be generated by prism rebuttal-request")
    if request.get("review_mode") != "rebuttal_review":
        failures.append("reject decision followup_request.review_mode must be rebuttal_review")
    if request.get("requested_providers") != [provider]:
        failures.append("reject decision followup_request must target only the original provider")
    if request.get("additive_rebuttal_only") is not True:
        failures.append("reject decision followup_request must set additive_rebuttal_only=true")
    rebuttal_for = request.get("rebuttal_for")
    if not isinstance(rebuttal_for, dict):
        failures.append("reject decision followup_request.rebuttal_for must be an object")
        return
    if rebuttal_for.get("provider") != provider:
        failures.append("reject decision followup_request.rebuttal_for.provider must match the original provider")
    original_merge_path = rebuttal_for.get("original_merge_path")
    if not (non_empty_string(original_merge_path) and path_matches_reference(str(original_merge_path), merge_path, request_path.parent)):
        failures.append("reject decision followup_request.rebuttal_for.original_merge_path must match the checked merge")
    original_review_path = rebuttal_for.get("original_review_path")
    expected_review_path = original_review.get("_path")
    if expected_review_path and not (
        non_empty_string(original_review_path)
        and path_matches_reference(str(original_review_path), pathlib.Path(str(expected_review_path)), request_path.parent)
    ):
        failures.append("reject decision followup_request.rebuttal_for.original_review_path must match the original review")


def validate_reject_followup(
    resolution_item: dict[str, Any],
    resolution_dir: pathlib.Path,
    merge_path: pathlib.Path,
    original_review: dict[str, Any],
    failures: list[str],
) -> None:
    if not non_empty_string_list(resolution_item.get("rejection_evidence")):
        failures.append("reject decision requires non-empty rejection_evidence")
    followup_request_raw = resolution_item.get("followup_request")
    followup_review_raw = resolution_item.get("followup_review")
    if not (non_empty_string(followup_request_raw) and non_empty_string(followup_review_raw)):
        failures.append("reject decision requires bounded same-provider followup_request and followup_review")
        return
    request_path = resolve_reference_path(str(followup_request_raw), resolution_dir)
    review_path = resolve_reference_path(str(followup_review_raw), resolution_dir)
    validate_rebuttal_request(request_path, merge_path, original_review, failures)
    followup_review = load_review_for_resolution(review_path, failures, "reject decision followup_review")
    if followup_review is None:
        return
    if followup_review.get("provider") != original_review.get("provider"):
        failures.append("reject decision followup_review provider must match the original provider")
    if followup_review.get("verdict") != "pass":
        failures.append("reject decision is invalid while bounded followup_review still returns concern/block")


def evidence_entry_exists(raw: str, base_dir: pathlib.Path) -> bool:
    try:
        tokens = shlex.split(raw)
    except ValueError:
        tokens = raw.split()
    target = tokens[0] if tokens else raw.strip()
    if not target:
        return False
    if target.startswith(("http://", "https://")):
        return True
    target_path = pathlib.Path(target)
    if target_path.is_absolute() or "/" in target:
        return resolve_reference_path(target, base_dir).exists()
    return shutil.which(target) is not None


def valid_executed_check_receipt(raw: str, base_dir: pathlib.Path) -> tuple[bool, str]:
    path = resolve_reference_path(raw, base_dir)
    if not path.exists():
        return False, f"receipt does not exist: {raw}"
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return False, f"receipt is not valid JSON: {raw}: {exc}"
    if not isinstance(payload, dict):
        return False, f"receipt must be a JSON object: {raw}"
    if payload.get("schema_id") != EXECUTED_CHECK_RECEIPT_SCHEMA_ID:
        return False, f"receipt.schema_id must be {EXECUTED_CHECK_RECEIPT_SCHEMA_ID}: {raw}"
    for key in ["command", "executed_at", "executor", "stdout_sha256", "stderr_sha256"]:
        if not non_empty_string(payload.get(key)):
            return False, f"receipt.{key} must be non-empty: {raw}"
    if not isinstance(payload.get("exit_code"), int):
        return False, f"receipt.exit_code must be an integer: {raw}"
    if payload.get("exit_code") != 0:
        return False, f"receipt.exit_code must be 0: {raw}"
    return True, ""


def validate_evidence_entries(
    entries: Any,
    label: str,
    base_dir: pathlib.Path,
    failures: list[str],
    require_executed_check: bool = False,
) -> None:
    if not non_empty_string_list(entries):
        failures.append(f"{label} requires non-empty evidence entries")
        return
    for index, raw in enumerate(entries):
        if not evidence_entry_exists(str(raw), base_dir):
            failures.append(f"{label}[{index}] does not resolve to an existing file or command: {raw}")
            continue
        if require_executed_check:
            ok, reason = valid_executed_check_receipt(str(raw), base_dir)
            if not ok:
                failures.append(f"{label}[{index}] must be an executed-check receipt: {reason}")


def validate_concern_references(
    resolution_item: dict[str, Any],
    expected_review: dict[str, Any],
    failures: list[str],
) -> None:
    concern_ref = resolution_item.get("concern_ref")
    if concern_ref != "main_concern":
        failures.append("resolution item concern_ref must be main_concern so it structurally references the provider concern")
    minimum_fix_ref = resolution_item.get("minimum_fix_ref")
    if minimum_fix_ref is not None and minimum_fix_ref != "minimum_fix":
        failures.append("resolution item minimum_fix_ref must be minimum_fix when present")
    if not non_empty_string(expected_review.get("main_concern")):
        failures.append("expected review main_concern must be non-empty")


def validate_resolution_item(
    resolution_item: dict[str, Any],
    expected_review: dict[str, Any],
    resolution_dir: pathlib.Path,
    merge_path: pathlib.Path,
    failures: list[str],
) -> str | None:
    for key in ["provider", "verdict", "decision", "concern_ref", "rationale"]:
        if key not in resolution_item:
            failures.append(f"resolution item missing {key}")
    provider = resolution_item.get("provider")
    verdict = resolution_item.get("verdict")
    decision = resolution_item.get("decision")
    if provider != expected_review.get("provider") or verdict != expected_review.get("verdict"):
        failures.append(
            f"resolution item for {provider}/{verdict} does not match expected concern {expected_review.get('provider')}/{expected_review.get('verdict')}"
        )
    if decision not in {"accept", "reject", "escalate"}:
        failures.append(f"resolution decision invalid: {decision}")
        return None
    if not non_empty_string(resolution_item.get("concern_ref")):
        failures.append("resolution item concern_ref must be non-empty")
    if not non_empty_string(resolution_item.get("rationale")):
        failures.append("resolution item rationale must be non-empty")
    validate_concern_references(resolution_item, expected_review, failures)
    if decision == "accept":
        validate_evidence_entries(
            resolution_item.get("implementation_evidence"),
            "accept decision implementation_evidence",
            resolution_dir,
            failures,
        )
        validate_evidence_entries(
            resolution_item.get("verification_evidence"),
            "accept decision verification_evidence",
            resolution_dir,
            failures,
            require_executed_check=True,
        )
    elif decision == "reject":
        validate_reject_followup(resolution_item, resolution_dir, merge_path, expected_review, failures)
    elif decision == "escalate":
        escalation = resolution_item.get("escalation")
        if not isinstance(escalation, dict):
            failures.append("escalate decision requires escalation object")
        else:
            for key in ["target", "blocking_reason", "user_visible_question"]:
                if not non_empty_string(escalation.get(key)):
                    failures.append(f"escalate decision escalation.{key} must be non-empty")
    return str(decision)


def validate_concern_resolution(
    merge_path: pathlib.Path,
    resolution_path: pathlib.Path,
    cli_reviews: list[str] | None = None,
    manifest_path: pathlib.Path | None = None,
) -> dict[str, Any]:
    failures: list[str] = []
    merge = load_json(merge_path)
    resolution = load_json(resolution_path)
    if not isinstance(merge, dict):
        failures.append("merge must be an object")
        merge = {}
    if not isinstance(resolution, dict):
        failures.append("resolution must be an object")
        resolution = {}
    if resolution.get("schema_id") != PRISM_CONCERN_RESOLUTION_SCHEMA_ID:
        failures.append(f"resolution.schema_id must be {PRISM_CONCERN_RESOLUTION_SCHEMA_ID}")
    if not (non_empty_string(resolution.get("merge_path")) and path_matches_reference(str(resolution.get("merge_path")), merge_path, resolution_path.parent)):
        failures.append("resolution.merge_path must match the checked merge path")
    reviews = load_resolution_reviews(resolution, resolution_path.parent, cli_reviews, failures)
    expected = expected_concern_reviews(merge, reviews, failures)
    resolution_items = resolution.get("resolutions")
    if not isinstance(resolution_items, list):
        failures.append("resolution.resolutions must be a list")
        resolution_items = []
    by_key: dict[tuple[str, str], dict[str, Any]] = {}
    for item in resolution_items:
        if not isinstance(item, dict):
            failures.append("resolution.resolutions entries must be objects")
            continue
        key = (str(item.get("provider")), str(item.get("verdict")))
        if key in by_key:
            failures.append(f"duplicate resolution entry for {key[0]}/{key[1]}")
        by_key[key] = item

    decisions: list[str] = []
    for review in expected:
        key = concern_review_key(review)
        item = by_key.get(key)
        if item is None:
            failures.append(f"missing resolution for {key[0]} {key[1]}")
            continue
        decision = validate_resolution_item(item, review, resolution_path.parent, merge_path, failures)
        if decision is not None:
            decisions.append(decision)
    for key in by_key:
        if key not in {concern_review_key(review) for review in expected}:
            failures.append(f"resolution entry has no matching concern/block review: {key[0]} {key[1]}")

    conclusion = resolution.get("conclusion")
    if not isinstance(conclusion, dict):
        failures.append("resolution.conclusion must be an object")
        conclusion_state = None
    else:
        conclusion_state = conclusion.get("state")
        if conclusion_state not in {"resolved", "escalated"}:
            failures.append("resolution.conclusion.state must be resolved or escalated")
        if not non_empty_string(conclusion.get("reason")):
            failures.append("resolution.conclusion.reason must be non-empty")
    expected_state = "escalated" if "escalate" in decisions else "resolved"
    if decisions and conclusion_state != expected_state:
        failures.append(f"resolution.conclusion.state must be {expected_state} for the recorded decisions")

    if manifest_path is not None:
        try:
            validate_session_manifest(manifest_path)
            manifest = load_json(manifest_path)
            convergence_state = (manifest.get("convergence") or {}).get("state")
            if conclusion_state == "resolved" and convergence_state not in {"converged", "main-decided"}:
                failures.append("resolved Prism concern resolution requires manifest convergence converged or main-decided")
            if conclusion_state == "escalated" and convergence_state != "escalated":
                failures.append("escalated Prism concern resolution requires manifest convergence escalated")
        except SystemExit as exc:
            failures.append(f"manifest invalid: {exc}")

    return {
        "ok": not failures,
        "merge_path": str(merge_path),
        "resolution_path": str(resolution_path),
        "must_respond": bool(merge.get("must_respond")),
        "expected_resolutions": [
            {"provider": review.get("provider"), "verdict": review.get("verdict")}
            for review in expected
        ],
        "conclusion_state": conclusion_state,
        "failures": failures,
    }


def parse_leading_json_object(stdout: str) -> dict[str, Any]:
    parsed, _ = json.JSONDecoder().raw_decode(stdout.lstrip())
    if not isinstance(parsed, dict):
        raise ValueError("leading JSON value is not an object")
    return parsed


def load_gate_rules() -> dict[str, Any]:
    path = ROOT / "rules" / "prism-gate-rules.json"
    payload = load_json(path)
    if not isinstance(payload, dict):
        raise SystemExit(f"gate rules must be an object: {path}")
    rules = payload.get("rules")
    if not isinstance(rules, list) or not rules:
        raise SystemExit("gate rules must contain a non-empty rules list")
    for rule in rules:
        if not isinstance(rule, dict):
            raise SystemExit("gate rule must be an object")
        require_keys(rule, ["id", "decision", "review_mode", "reason", "match"], "gate rule")
        if rule["decision"] not in GATE_RANK:
            raise SystemExit(f"gate rule decision invalid: {rule['id']}")
        if not isinstance(rule["match"], dict):
            raise SystemExit(f"gate rule match must be an object: {rule['id']}")
    return payload


def _text_terms(payload: dict[str, Any]) -> str:
    parts = [
        payload.get("task", ""),
        payload.get("user_intent", ""),
        payload.get("main_claim", ""),
        " ".join(payload.get("tags", []) or []),
    ]
    return "\n".join(str(part).lower() for part in parts)


def _has_cjk(value: str) -> bool:
    return any("\u3400" <= char <= "\u9fff" for char in value)


def _term_in_text(term: str, text: str) -> bool:
    normalized = term.lower().strip()
    if not normalized:
        return False
    if _has_cjk(normalized):
        return normalized in text
    return bool(re.search(r"(?<![a-z0-9_])" + re.escape(normalized) + r"(?![a-z0-9_])", text, flags=re.I))


def _rule_matches(rule: dict[str, Any], payload: dict[str, Any]) -> bool:
    match = rule["match"]
    text = _text_terms(payload)
    risk_level = payload.get("risk_level", "medium")
    changed_paths = payload.get("changed_paths", []) or []
    tags = {tag.lower() for tag in (payload.get("tags", []) or [])}

    if "risk_levels" in match and risk_level not in match["risk_levels"]:
        return False
    if "any_terms" in match:
        terms = [str(term).lower() for term in match["any_terms"]]
        if not any(_term_in_text(term, text) for term in terms):
            return False
    if "all_terms" in match:
        terms = [str(term).lower() for term in match["all_terms"]]
        if not all(_term_in_text(term, text) for term in terms):
            return False
    if "tags_any" in match:
        wanted = {str(tag).lower() for tag in match["tags_any"]}
        if not (tags & wanted):
            return False
    if "path_globs" in match:
        globs = [str(item) for item in match["path_globs"]]
        if not any(fnmatch.fnmatch(path, glob) for path in changed_paths for glob in globs):
            return False
    return True


def command_json(argv: list[str]) -> tuple[int, dict[str, Any] | None, str]:
    completed = subprocess.run(argv, cwd=str(REPO_ROOT), check=False, capture_output=True, text=True)
    try:
        parsed = parse_leading_json_object(completed.stdout)
    except (json.JSONDecodeError, ValueError) as exc:
        return completed.returncode, None, str(exc)
    return completed.returncode, parsed, ""


def resolve_boundary_context(payload: dict[str, Any], args: argparse.Namespace) -> tuple[dict[str, Any] | None, dict[str, Any]]:
    argv = [str(REPO_ROOT / "runtime" / "bin" / "redcap"), "boundary", "resolve"]
    boundary_cwd = getattr(args, "boundary_cwd", None) or payload.get("boundary_cwd")
    project_workspace = getattr(args, "project_workspace", None) or payload.get("project_workspace")
    if isinstance(boundary_cwd, str) and boundary_cwd.strip():
        argv.extend(["--cwd", boundary_cwd])
    if isinstance(project_workspace, str) and project_workspace.strip():
        argv.extend(["--project-workspace", project_workspace])
    exit_code, parsed, parse_error = command_json(argv)
    meta: dict[str, Any] = {
        "boundary_command": argv,
        "boundary_exit_code": exit_code,
        "boundary_parse_error": parse_error or None,
    }
    if exit_code != 0 or parsed is None:
        return None, meta
    return parsed, meta


def self_development_lifecycle_topic(payload: dict[str, Any]) -> bool:
    text = _text_terms(payload)
    if any(term in text for term in SELF_DEVELOPMENT_LIFECYCLE_TERMS):
        return True
    tags = {tag.lower() for tag in (payload.get("tags", []) or [])}
    if tags & SELF_DEVELOPMENT_LIFECYCLE_TAGS:
        return True
    changed_paths = payload.get("changed_paths", []) or []
    return any(
        fnmatch.fnmatch(path, glob)
        for path in changed_paths
        for glob in SELF_DEVELOPMENT_LIFECYCLE_PATH_GLOBS
    )


def mark_required(result: dict[str, Any], rule_id: str, reason: str, next_step: str) -> None:
    if rule_id not in result["matched_rules"]:
        result["matched_rules"].append(rule_id)
    result["decision"] = "required"
    result["review_mode"] = "lifecycle_review"
    result["reason"] = reason
    result["required_providers"] = ["kimi", "claude-code"]
    result["next_step"] = next_step


def apply_self_development_lifecycle_gate(
    payload: dict[str, Any],
    result: dict[str, Any],
    args: argparse.Namespace,
) -> None:
    lifecycle_packet = getattr(args, "lifecycle_packet", None) or payload.get("lifecycle_packet")
    boundary_context, boundary_meta = resolve_boundary_context(payload, args)
    lifecycle = {
        "required": False,
        "checked": False,
        "ok": None,
        **boundary_meta,
    }
    if boundary_context is not None:
        lifecycle["boundary_mode"] = boundary_context.get("boundary_mode")
        lifecycle["project_workspace"] = boundary_context.get("project_workspace")
        lifecycle["cwd"] = boundary_context.get("cwd")
    result["self_development_lifecycle"] = lifecycle

    if boundary_context is None:
        mark_required(
            result,
            "self-development-lifecycle-gate",
            "Self-development lifecycle gate could not resolve runtime boundary context.",
            "Resolve the runtime boundary and rerun the gate with a lifecycle packet if this is RedCap self-development.",
        )
        return
    if boundary_context.get("boundary_mode") != "self-development":
        return
    if payload.get("risk_level", "medium") not in SELF_DEVELOPMENT_LIFECYCLE_RISKS:
        return
    semantic_intent = ((result.get("semantic_gate") or {}).get("prompt_intent") or {})
    if isinstance(semantic_intent, dict) and semantic_intent.get("action_evidence") in {"none", "diagnostic"}:
        lifecycle["skip_reason"] = (
            "semantic intent is non-mutating; lifecycle packet is required before implementation or completion, "
            "not before ordinary answers or read-only review"
        )
        return

    lifecycle["required"] = True
    if not isinstance(lifecycle_packet, str) or not lifecycle_packet.strip():
        mark_required(
            result,
            "self-development-lifecycle-gate",
            "Medium-or-higher RedCap self-development work requires a lifecycle packet before implementation or completion claims.",
            "Create or update a lifecycle packet and rerun with --lifecycle-packet so requirements, technical review, FSM transition, and verification evidence are checked.",
        )
        return

    lifecycle["packet"] = lifecycle_packet
    argv = [
        str(REPO_ROOT / "runtime" / "bin" / "redcap"),
        "lifecycle",
        "check",
        "--packet",
        lifecycle_packet,
    ]
    lifecycle_events = getattr(args, "lifecycle_events", None) or payload.get("lifecycle_events")
    if isinstance(lifecycle_events, str) and lifecycle_events.strip():
        argv.extend(["--events", lifecycle_events])
    exit_code, parsed, parse_error = command_json(argv)
    lifecycle.update({
        "checked": True,
        "check_command": argv,
        "check_exit_code": exit_code,
        "check_parse_error": parse_error or None,
    })
    if isinstance(parsed, dict):
        lifecycle["ok"] = parsed.get("ok")
        lifecycle["failures"] = parsed.get("failures", [])
    if exit_code != 0 or not isinstance(parsed, dict) or parsed.get("ok") is not True:
        mark_required(
            result,
            "self-development-lifecycle-gate",
            "RedCap self-development lifecycle packet failed validation.",
            "Fix the lifecycle packet failures before implementation or completion claims proceed.",
        )


def evaluate_gate(payload: dict[str, Any], rules_payload: dict[str, Any] | None = None) -> dict[str, Any]:
    validate_gate_request(payload)
    rules_payload = rules_payload or load_gate_rules()
    matched = [rule for rule in rules_payload["rules"] if _rule_matches(rule, payload)]
    if "changed_reality" in payload and changed_reality_warning(payload):
        matched.append({
            "id": "diagnostic-only-changed-reality",
            "decision": "required",
            "review_mode": "anti_loop_review",
            "reason": "changed_reality only describes missing, unimplemented, or not-yet behavior.",
            "match": {},
        })
    if matched:
        strictest = max(matched, key=lambda rule: GATE_RANK[rule["decision"]])
    else:
        strictest = rules_payload.get("default", {})
    decision = strictest.get("decision", "optional")
    review_mode = strictest.get("review_mode", "strategy_review")
    result = {
        "gate": "prism-rule-review",
        "decision": decision,
        "review_mode": review_mode if decision != "skipped" else None,
        "risk_level": payload.get("risk_level", "medium"),
        "matched_rules": [rule["id"] for rule in matched],
        "reason": strictest.get("reason", "Default Prism rule review decision."),
        "required_providers": ["kimi", "claude-code"] if decision == "required" else [],
        "host_enforcement": "redcap-owned-intake-only; host-level automatic interception is not claimed",
        "next_step": {
            "required": "Run full Prism before implementation or completion claim.",
            "optional": "Main agent may proceed, but should request Prism if uncertainty or risk rises.",
            "skipped": "No Prism provider call needed; continue with normal verification.",
        }[decision],
    }
    return result


def semantic_gate_prompt(payload: dict[str, Any]) -> str:
    parts = [
        payload.get("task", ""),
        payload.get("user_intent", ""),
        payload.get("main_claim", ""),
    ]
    return "\n".join(str(part) for part in parts if str(part).strip())


def semantic_gate_has_hard_state_change(args: argparse.Namespace, payload: dict[str, Any]) -> bool:
    if payload.get("changed_paths"):
        return True
    for key in ["completion_claim", "capability_status", "completion_label"]:
        value = getattr(args, key, None)
        if value:
            return True
    return False


def apply_semantic_gate(
    payload: dict[str, Any],
    result: dict[str, Any],
    args: argparse.Namespace,
) -> None:
    policy = getattr(args, "semantic_policy", "off")
    if policy == "off":
        return
    prompt = semantic_gate_prompt(payload)
    semantic_gate: dict[str, Any] = {
        "policy": policy,
        "attempted": False,
        "before_decision": result.get("decision"),
        "before_matched_rules": list(result.get("matched_rules", [])),
    }
    if not prompt.strip():
        semantic_gate["reason"] = "empty gate prompt"
        result["semantic_gate"] = semantic_gate
        return
    try:
        fake_delay = float(getattr(args, "semantic_fake_delay_seconds", 0.0) or 0.0)
    except ValueError:
        fake_delay = 0.0
    judgment = classify_with_policy(
        prompt,
        llm_policy=policy,
        provider=getattr(args, "semantic_provider", "claude-code"),
        fallback_provider=getattr(args, "semantic_fallback_provider", "claude-code"),
        timeout_seconds=float(getattr(args, "semantic_timeout_seconds", 20.0)),
        fake_response=getattr(args, "semantic_fake_response", None),
        fake_delay_seconds=fake_delay,
    )
    intent = judgment.get("prompt_intent") if isinstance(judgment, dict) else {}
    semantic_gate.update({
        "attempted": bool(judgment.get("llm_attempted")) if isinstance(judgment, dict) else False,
        "ok": judgment.get("ok") if isinstance(judgment, dict) else False,
        "source": judgment.get("source") if isinstance(judgment, dict) else None,
        "prompt_intent": intent,
        "llm_appeal_reason": judgment.get("llm_appeal_reason") if isinstance(judgment, dict) else None,
        "llm_judgment_applied": judgment.get("llm_judgment_applied") if isinstance(judgment, dict) else None,
        "llm_application_reason": judgment.get("llm_application_reason") if isinstance(judgment, dict) else None,
        "llm_results": judgment.get("llm_results", []) if isinstance(judgment, dict) else [],
        "fallback_reason": judgment.get("reason") if isinstance(judgment, dict) else None,
        "hard_state_change": semantic_gate_has_hard_state_change(args, payload),
    })
    if (
        isinstance(intent, dict)
        and intent.get("action_evidence") == "none"
        and intent.get("confidence") != "low"
        and not semantic_gate["hard_state_change"]
    ):
        result["decision"] = "skipped"
        result["review_mode"] = None
        result["required_providers"] = []
        result["reason"] = (
            "语义判断认为这是仅需回答的问题；不需要棱镜外部评审，但实现动作或完成声明仍受后续门禁约束。"
        )
        result["next_step"] = "继续普通回答；如后续要改代码、提交或推送，必须重新进入对应门禁。"
        semantic_gate["decision_adjusted"] = "required_or_optional_to_skipped"
    elif isinstance(intent, dict) and intent.get("action_evidence") == "diagnostic":
        semantic_gate["decision_adjusted"] = "none; diagnostic review may still require Prism"
    else:
        semantic_gate["decision_adjusted"] = "none"
    semantic_gate["after_decision"] = result.get("decision")
    result["semantic_gate"] = semantic_gate


def cmd_check(_: argparse.Namespace) -> int:
    for path in [
        ROOT / "schemas" / "prism-request.schema.json",
        ROOT / "schemas" / "prism-review.schema.json",
        ROOT / "schemas" / "prism-session.schema.json",
        ROOT / "schemas" / "prism-concern-resolution.schema.json",
        ROOT / "schemas" / "capability-status.schema.json",
        REPO_ROOT / "assets" / "contracts" / "prism-gate-request.schema.json",
        REPO_ROOT / "assets" / "contracts" / "prism-gate-response.schema.json",
        REPO_ROOT / "assets" / "contracts" / "enforcement-matrix.schema.json",
        REPO_ROOT / "assets" / "contracts" / "enforcement-matrix.json",
        REPO_ROOT / "assets" / "contracts" / "hook-coverage.schema.json",
        REPO_ROOT / "assets" / "contracts" / "hook-coverage.json",
        ROOT / "rules" / "prism-gate-rules.json",
        ROOT / "examples" / "prism-request.example.json",
        ROOT / "examples" / "capability-status.example.json",
        ROOT / "examples" / "completion-block.example.json",
        ROOT / "examples" / "design-concern.example.json",
        ROOT / "examples" / "prism-session.example.json",
        ROOT / "examples" / "prism-concern-resolution.merge.concern.json",
        ROOT / "examples" / "prism-concern-resolution.merge.pass.json",
        ROOT / "examples" / "prism-concern-resolution.kimi-concern.json",
        ROOT / "examples" / "prism-concern-resolution.claude-pass.json",
        ROOT / "examples" / "prism-concern-resolution.kimi-followup-pass.json",
        ROOT / "examples" / "prism-concern-resolution.kimi-followup-concern.json",
        ROOT / "examples" / "prism-concern-resolution.followup-request.json",
        ROOT / "examples" / "prism-concern-resolution.valid-accept.json",
        ROOT / "examples" / "prism-resolution-check.receipt.json",
        ROOT / "examples" / "prism-concern-resolution.valid-reject.json",
        ROOT / "examples" / "prism-concern-resolution.valid-escalate.json",
        ROOT / "examples" / "prism-concern-resolution.valid-pass-merge.json",
        ROOT / "examples" / "prism-concern-resolution.invalid-accept-missing-verification.json",
        ROOT / "examples" / "prism-concern-resolution.invalid-accept-missing-evidence-path.json",
        ROOT / "examples" / "prism-concern-resolution.invalid-reject-missing-followup.json",
        ROOT / "examples" / "prism-concern-resolution.invalid-reject-followup-still-concern.json",
        ROOT / "examples" / "self-development-lifecycle-packet.json",
        ROOT / "examples" / "gate-skip-trivial.json",
        ROOT / "examples" / "gate-optional-implementation.json",
        ROOT / "examples" / "gate-required-architecture.json",
        ROOT / "examples" / "gate-required-completion-pathology.json",
        ROOT / "examples" / "gate-required-diagnostic-only-changed-reality.json",
        ROOT / "examples" / "gate-false-positive-completion-substring.json",
        ROOT / "examples" / "enforcement-matrix-hook-bad.json",
        ROOT / "examples" / "enforcement-matrix-hook-good.json",
        ROOT / "examples" / "hook-coverage-missing-required-event.json",
    ]:
        load_json(path)
    load_gate_rules()
    validate_request(ROOT / "examples" / "prism-request.example.json")
    validate_review(ROOT / "examples" / "completion-block.example.json")
    validate_review(ROOT / "examples" / "design-concern.example.json")
    validate_review(ROOT / "examples" / "prism-concern-resolution.kimi-concern.json")
    validate_review(ROOT / "examples" / "prism-concern-resolution.claude-pass.json")
    validate_review(ROOT / "examples" / "prism-concern-resolution.kimi-followup-pass.json")
    validate_review(ROOT / "examples" / "prism-concern-resolution.kimi-followup-concern.json")
    validate_session_manifest(ROOT / "examples" / "prism-session.example.json")
    validate_capability_status(ROOT / "examples" / "capability-status.example.json")
    blocked_status = subprocess.run(
        [
            str(ROOT / "bin" / "completion-semantics-check"),
            "--json",
            str(ROOT / "examples" / "capability-status.example.json"),
        ],
        check=False,
        capture_output=True,
        text=True,
    )
    if blocked_status.returncode != 2:
        raise SystemExit(
            "completion-semantics example should reject manually_runnable status"
        )
    allowed_status = subprocess.run(
        [
            str(ROOT / "bin" / "completion-semantics-check"),
            "--capability",
            "prism-check",
            "--status",
            "operational",
            "--claim",
            "Prism check exercises completion semantics.",
        ],
        check=False,
        capture_output=True,
        text=True,
    )
    if allowed_status.returncode != 0:
        raise SystemExit("completion-semantics operational status should pass")
    tested_status = subprocess.run(
        [
            str(ROOT / "bin" / "completion-semantics-check"),
            "--capability",
            "tested-only-capability",
            "--status",
            "tested",
            "--claim",
            "Tests passed, so the capability is complete.",
        ],
        check=False,
        capture_output=True,
        text=True,
    )
    if tested_status.returncode != 2:
        raise SystemExit("completion-semantics tested status should not complete by default")
    completion_probe = evaluate_gate({
        "task": "Claim provider dispatcher is complete",
        "risk_level": "high",
        "changed_paths": [],
        "tags": [],
    })
    apply_completion_semantics(
        completion_probe,
        run_completion_semantics_check(
            status="manually_runnable",
            claim="Provider dispatcher is complete",
            labels=[],
        ),
    )
    if "completion-semantics-check" not in completion_probe["matched_rules"]:
        raise SystemExit("gate must attach completion-semantics-check when completion is rejected")
    false_positive_probe = evaluate_gate({
        "task": "review Prism implementation completeness",
        "risk_level": "low",
        "changed_paths": [],
        "tags": [],
    })
    if "completion-claim" in false_positive_probe["matched_rules"]:
        raise SystemExit("gate must not treat completeness as a completion claim")
    legitimate_completion_probe = evaluate_gate({
        "task": "Claim provider dispatcher is complete",
        "risk_level": "low",
        "changed_paths": [],
        "tags": [],
    })
    if "completion-claim" not in legitimate_completion_probe["matched_rules"]:
        raise SystemExit("gate must still match a legitimate complete claim")
    semantic_fixture_args = argparse.Namespace(
        semantic_policy="auto-on-ambiguous",
        semantic_provider="claude-code",
        semantic_fallback_provider="claude-code",
        semantic_timeout_seconds=1.0,
        semantic_fake_response=json.dumps({
            "prompt_kind": "question",
            "authorized_scope": "answer_only",
            "action_evidence": "none",
            "confidence": "high",
            "reason": "fixture restart question",
        }, ensure_ascii=False),
        semantic_fake_delay_seconds=0.0,
        completion_claim=None,
        capability_status=None,
        completion_label=[],
    )
    semantic_restart_probe = evaluate_gate({
        "task": "再问一个问题，这波改动落地后，是否需要重启codex才能生效？因为我记得codex的hook钩子需要重启才能生效。",
        "risk_level": "medium",
        "changed_paths": [],
        "tags": ["codex-user-prompt", "codex-hook"],
    })
    apply_semantic_gate(
        {
            "task": "再问一个问题，这波改动落地后，是否需要重启codex才能生效？因为我记得codex的hook钩子需要重启才能生效。",
            "risk_level": "medium",
            "changed_paths": [],
            "tags": ["codex-user-prompt", "codex-hook"],
        },
        semantic_restart_probe,
        semantic_fixture_args,
    )
    if semantic_restart_probe["decision"] != "skipped":
        raise SystemExit("semantic gate should skip answer-only restart questions")
    semantic_implementation_probe = evaluate_gate({
        "task": "请立即修复Hook误伤问题并运行测试",
        "risk_level": "medium",
        "changed_paths": [],
        "tags": ["codex-user-prompt", "codex-hook"],
    })
    apply_semantic_gate(
        {
            "task": "请立即修复Hook误伤问题并运行测试",
            "risk_level": "medium",
            "changed_paths": [],
            "tags": ["codex-user-prompt", "codex-hook"],
        },
        semantic_implementation_probe,
        semantic_fixture_args,
    )
    if semantic_implementation_probe["decision"] == "skipped":
        raise SystemExit("semantic gate must not downgrade clear implementation directives")
    semantic_review_args = argparse.Namespace(
        semantic_policy="auto-on-ambiguous",
        semantic_provider="claude-code",
        semantic_fallback_provider="claude-code",
        semantic_timeout_seconds=1.0,
        semantic_fake_response=json.dumps({
            "prompt_kind": "directive",
            "authorized_scope": "review_only",
            "action_evidence": "diagnostic",
            "confidence": "high",
            "reason": "fixture review request",
        }, ensure_ascii=False),
        semantic_fake_delay_seconds=0.0,
        completion_claim=None,
        capability_status=None,
        completion_label=[],
    )
    semantic_review_probe = evaluate_gate({
        "task": "和棱镜一起整体review当前新RedCap的设计思路、目录结构、逻辑实现，细致评估需要改进、调整和尚未执行完毕的任务",
        "risk_level": "high",
        "changed_paths": [],
        "tags": ["codex-user-prompt", "codex-hook"],
    })
    apply_semantic_gate(
        {
            "task": "和棱镜一起整体review当前新RedCap的设计思路、目录结构、逻辑实现，细致评估需要改进、调整和尚未执行完毕的任务",
            "risk_level": "high",
            "changed_paths": [],
            "tags": ["codex-user-prompt", "codex-hook"],
        },
        semantic_review_probe,
        semantic_review_args,
    )
    if ((semantic_review_probe.get("semantic_gate") or {}).get("prompt_intent") or {}).get("authorized_scope") != "review_only":
