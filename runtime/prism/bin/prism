def cmd_gate(args: argparse.Namespace) -> int:
    started_at = iso_now()
    start = time.perf_counter()
    if args.request:
        payload = load_json(pathlib.Path(args.request).resolve())
        if not isinstance(payload, dict):
            raise SystemExit("gate request must be an object")
    else:
        task = args.task
        if task is None and not sys.stdin.isatty():
            task = sys.stdin.read().strip()
        payload = {
            "task": task or "",
            "risk_level": args.risk_level,
            "changed_paths": args.changed_paths or [],
            "tags": args.tags or [],
        }
    if args.boundary_cwd:
        payload["boundary_cwd"] = args.boundary_cwd
    if args.project_workspace:
        payload["project_workspace"] = args.project_workspace
    if args.task_id:
        payload["task_id"] = args.task_id
    result = evaluate_gate(payload)
    apply_semantic_gate(payload, result, args)
    if args.completion_claim or args.capability_status or args.completion_label:
        completion_semantics = run_completion_semantics_check(
            status=args.capability_status,
            claim=args.completion_claim,
            labels=args.completion_label or [],
        )
        apply_completion_semantics(result, completion_semantics)
    apply_self_development_lifecycle_gate(payload, result, args)
    ended_at = iso_now()
    elapsed = round(time.perf_counter() - start, 3)
    planned_exit_code = 2 if args.fail_when_required and result["decision"] == "required" else 0
    print(json.dumps(result, ensure_ascii=False, indent=2))
    sys.stdout.flush()
    trigger = "codex-UserPromptSubmit" if "codex-user-prompt" in set(payload.get("tags", [])) else "cli-gate"
    try:
        record_gate(
            payload,
            result,
            trigger=trigger,
            executor="prism",
            started_at=started_at,
            ended_at=ended_at,
            duration_seconds_value=elapsed,
            planned_exit_code=planned_exit_code,
        )
    except Exception as exc:
        print(f"prism gate ledger append failed: {exc}", file=sys.stderr)
        return planned_exit_code if planned_exit_code else 1
    return planned_exit_code


def run_completion_semantics_check(status: str | None, claim: str | None, labels: list[str]) -> dict[str, Any]:
    if not status:
        raise SystemExit("--capability-status is required when checking a completion claim")
    if not claim:
        raise SystemExit("--completion-claim is required when checking completion semantics")
    cmd = [
        str(ROOT / "bin" / "completion-semantics-check"),
        "--capability",
        "gate-completion-claim",
        "--status",
        status,
        "--claim",
        claim,
    ]
    for label in labels:
        cmd.extend(["--label", label])
    completed = subprocess.run(cmd, check=False, capture_output=True, text=True)
    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"completion-semantics-check returned invalid JSON: {completed.stdout}") from exc
    payload["exit_code"] = completed.returncode
    return payload


def apply_completion_semantics(result: dict[str, Any], completion_semantics: dict[str, Any]) -> None:
    result["completion_semantics"] = completion_semantics
    if not completion_semantics["completion_allowed"]:
        result["decision"] = "required"
        result["review_mode"] = "completion_review"
        result["matched_rules"] = sorted(
            set(result.get("matched_rules", [])) | {"completion-semantics-check"}
        )
        result["reason"] = "Completion semantics check rejected the completion claim."
        result["required_providers"] = ["kimi", "claude-code"]
        result["next_step"] = "Do not claim completion; run full Prism or narrow the claim."


def cmd_brief(args: argparse.Namespace) -> int:
    provider = args.provider
    if provider not in ALLOWED_PROVIDERS:
        raise SystemExit(f"excluded provider: {provider}")
    request_path = pathlib.Path(args.request).resolve()
    validate_request(request_path)
    request = load_json(request_path)
    shared = (ROOT / "prompts" / "prism-shared-brief.md").read_text(encoding="utf-8")
    provider_prompt = (
        ROOT / "prompts" / f"{provider}-prism-review.md"
    ).read_text(encoding="utf-8")
    sections = [
        shared.rstrip(),
        "\n--- PROVIDER PROMPT ---\n",
        provider_prompt.rstrip(),
        "\n--- REVIEW REQUEST FILE ---\n",
        str(request_path),
        "\n--- REVIEW REQUEST SUMMARY ---\n",
        json.dumps(
            {
                "task": request["task"],
                "review_mode": request["review_mode"],
                "risk_level": request["risk_level"],
                "requested_providers": request["requested_providers"],
                "evidence_count": len(request.get("evidence", [])),
                "known_constraint_count": len(request.get("known_constraints", [])),
            },
            ensure_ascii=False,
            indent=2,
        ),
    ]
    diagnostic_warning = changed_reality_warning(request)
    if diagnostic_warning:
        sections.extend([
            "\n--- DIAGNOSTIC WARNING ---\n",
            diagnostic_warning,
        ])
    if args.inline_request:
        sections.extend([
            "\n--- REVIEW REQUEST JSON ---\n",
            json.dumps(request, ensure_ascii=False, indent=2),
        ])
    text = "\n".join(sections)
    if args.out:
        out_path = pathlib.Path(args.out).resolve()
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(text + "\n", encoding="utf-8")
        print(json.dumps({"brief_path": str(out_path), "inline_request": args.inline_request}, ensure_ascii=False))
    else:
        print(text)
    return 0


def changed_reality_warning(request: dict[str, Any]) -> str | None:
    changed_reality = request.get("changed_reality", [])
    if not changed_reality:
        return "changed_reality is empty; this request may be proof-only or diagnostic-only."
    items = [str(item).strip().lower() for item in changed_reality if str(item).strip()]
    if not items:
        return "changed_reality has no non-empty entries; this request may be proof-only or diagnostic-only."
    negative_count = sum(
        1 for item in items if any(term in item for term in DIAGNOSTIC_ONLY_TERMS)
    )
    if negative_count == len(items):
        return (
            "Every changed_reality entry appears to describe missing, unimplemented, "
            "or not-yet behavior. Treat this as diagnostic-only unless a positive "
            "behavioral or filesystem change is added."
        )
    return None


def cmd_merge(args: argparse.Namespace) -> int:
    reviews = []
    for raw_path in args.reviews:
        path = pathlib.Path(raw_path).resolve()
        validate_review(path)
        reviews.append(load_json(path))
    strictest = max(reviews, key=lambda item: VERDICT_RANK[item["verdict"]])
    providers = [item["provider"] for item in reviews]
    merged = {
        "providers": providers,
        "verdicts": [
            {
                "provider": item["provider"],
                "verdict": item["verdict"],
                "confidence": item["confidence"],
            }
            for item in reviews
        ],
        "strictest_verdict": strictest["verdict"],
        "strictest_provider": strictest["provider"],
        "must_respond": strictest["verdict"] in {"concern", "block"},
        "main_concerns": [
            {"provider": item["provider"], "concern": item["main_concern"]}
            for item in reviews
        ],
        "minimum_fixes": [
            {"provider": item["provider"], "minimum_fix": item["minimum_fix"]}
            for item in reviews
        ],
        "anti_loop_detected": any(
            bool(item.get("anti_loop_signal", {}).get("present")) for item in reviews
        ),
    }
    text = json.dumps(merged, ensure_ascii=False, indent=2)
    if args.out:
        out_path = pathlib.Path(args.out).resolve()
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(text + "\n", encoding="utf-8")
        print(json.dumps({"merge_path": str(out_path), "strictest_verdict": merged["strictest_verdict"]}, ensure_ascii=False))
    else:
        print(text)
    return 0


def cmd_rebuttal_request(args: argparse.Namespace) -> int:
    merge_path = pathlib.Path(args.merge).resolve()
    review_path = pathlib.Path(args.review).resolve()
    provider = args.provider
    validate_review(review_path)
    review = load_json(review_path)
    if review.get("provider") != provider:
        raise SystemExit("rebuttal-request provider must match the original review provider")
    if review.get("verdict") not in {"concern", "block"}:
        raise SystemExit("rebuttal-request is only valid for an original concern/block review")
    payload = {
        "task": f"Bounded Prism rebuttal for {provider} concern",
        "user_intent": "Give the same Prism provider one bounded opportunity to evaluate RedCap's proposed rejection evidence.",
        "main_claim": args.main_claim,
        "changed_reality": args.changed_reality or [
            "RedCap provided explicit rejection evidence for a Prism concern or block.",
        ],
        "review_mode": "rebuttal_review",
        "risk_level": args.risk_level,
        "requested_providers": [provider],
        "evidence": args.evidence or [],
        "known_constraints": [
            "This is a one-round same-provider rebuttal request.",
            "The provider must return one Prism review JSON and must not open an unbounded discussion loop.",
            "The request preserves the original concern context and adds only rebuttal evidence.",
        ],
        "generated_by": PRISM_REBUTTAL_REQUEST_GENERATOR,
        "rebuttal_for": {
            "provider": provider,
            "original_merge_path": str(merge_path),
            "original_review_path": str(review_path),
        },
        "additive_rebuttal_only": True,
    }
    validate_request_dict = dict(payload)
    validate_gate_request({"task": payload["task"]}, "rebuttal request task")
    # Reuse the normal Prism request validator through a temporary file because
    # it is intentionally file-oriented elsewhere in this command.
    if args.out:
        out_path = pathlib.Path(args.out).resolve()
        out_path.parent.mkdir(parents=True, exist_ok=True)
        write_text_atomic(out_path, json.dumps(payload, ensure_ascii=False, indent=2) + "\n")
        validate_request(out_path)
        print(json.dumps({"rebuttal_request": str(out_path), "provider": provider}, ensure_ascii=False))
    else:
        # Validate the in-memory request shape without adding another dependency.
        for key in ["task", "user_intent", "main_claim", "changed_reality", "review_mode", "risk_level", "requested_providers"]:
            if key not in validate_request_dict:
                raise SystemExit(f"rebuttal request missing {key}")
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


def run_resolution_self_check() -> list[str]:
    failures: list[str] = []
    good_cases = [
        "prism-concern-resolution.valid-accept.json",
        "prism-concern-resolution.valid-reject.json",
        "prism-concern-resolution.valid-escalate.json",
    ]
    bad_cases = [
        ("prism-concern-resolution.invalid-accept-missing-verification.json", "accept decision verification_evidence requires non-empty evidence entries"),
        ("prism-concern-resolution.invalid-accept-missing-evidence-path.json", "does not resolve to an existing file or command"),
        ("prism-concern-resolution.invalid-reject-missing-followup.json", "reject decision requires bounded same-provider followup_request and followup_review"),
        ("prism-concern-resolution.invalid-reject-followup-still-concern.json", "reject decision is invalid while bounded followup_review still returns concern/block"),
    ]
    merge_path = ROOT / "examples" / "prism-concern-resolution.merge.concern.json"
    for name in good_cases:
        result = validate_concern_resolution(merge_path, ROOT / "examples" / name)
        if result["failures"]:
            failures.append(f"{name} should pass: {result['failures']}")
    for name, expected_failure in bad_cases:
        result = validate_concern_resolution(merge_path, ROOT / "examples" / name)
        if result["ok"]:
            failures.append(f"{name} should fail")
        if expected_failure not in "\n".join(result["failures"]):
            failures.append(f"{name} did not fail for expected reason: {expected_failure}")
    pass_merge_result = validate_concern_resolution(
        ROOT / "examples" / "prism-concern-resolution.merge.pass.json",
        ROOT / "examples" / "prism-concern-resolution.valid-pass-merge.json",
    )
    if not pass_merge_result["ok"]:
        failures.append(f"pass merge resolution fixture should pass: {pass_merge_result['failures']}")
    with tempfile.TemporaryDirectory(prefix="prism-rebuttal-request-") as tmp_raw:
        out_path = pathlib.Path(tmp_raw) / "request.json"
        generated = subprocess.run(
            [
                str(ROOT / "bin" / "prism"),
                "rebuttal-request",
                "--merge",
                str(ROOT / "examples" / "prism-concern-resolution.merge.concern.json"),
                "--review",
                str(ROOT / "examples" / "prism-concern-resolution.kimi-concern.json"),
                "--provider",
                "kimi",
                "--main-claim",
                "Fixture rebuttal request generation is executable.",
                "--evidence",
                "runtime/prism/examples/prism-concern-resolution.valid-reject.json",
                "--out",
                str(out_path),
            ],
            cwd=str(REPO_ROOT),
            check=False,
            capture_output=True,
            text=True,
        )
        if generated.returncode != 0:
            failures.append(f"rebuttal-request command should pass: {generated.stdout} {generated.stderr}")
        elif load_json(out_path).get("generated_by") != PRISM_REBUTTAL_REQUEST_GENERATOR:
            failures.append("rebuttal-request command did not stamp generated_by")
    return failures


def cmd_resolution_check(args: argparse.Namespace) -> int:
    if args.self_check:
        failures = run_resolution_self_check()
        print(json.dumps({"ok": not failures, "failures": failures}, ensure_ascii=False, indent=2))
        if failures:
            return 1
        print("PRISM_CONCERN_RESOLUTION_SELF_CHECK_OK")
        return 0
    if not args.merge or not args.resolution:
        raise SystemExit("resolution-check requires --merge and --resolution unless --self-check is used")
    manifest_path = pathlib.Path(args.manifest).resolve() if args.manifest else None
    result = validate_concern_resolution(
        pathlib.Path(args.merge).resolve(),
        pathlib.Path(args.resolution).resolve(),
        args.review,
        manifest_path,
    )
    print(json.dumps(result, ensure_ascii=False, indent=2))
    if not result["ok"]:
        return 1
    print("PRISM_CONCERN_RESOLUTION_OK")
    return 0


def cmd_session_init(args: argparse.Namespace) -> int:
    run_dir = pathlib.Path(args.run_dir).resolve()
    run_dir.mkdir(parents=True, exist_ok=True)
    manifest_path = run_dir / "session.json"
    now = iso_now()
    payload = {
        "schema_id": "prism-session-manifest",
        "task_id": args.task_id,
        "run_dir": str(run_dir),
        "status": "active",
        "max_rounds_per_provider": args.max_rounds,
        "created_at": now,
        "task_started_at": now,
        "updated_at": now,
        "providers": {
            provider: {
                "session_handle": None,
                "round_count": 0,
                "status": "pending",
                "last_review": None,
            }
            for provider in sorted(ALLOWED_PROVIDERS)
        },
        "convergence": {
            "state": "unresolved",
            "reason": "Initial Prism task session manifest.",
        },
    }
    validate_session_payload(payload, "session init")
    write_json_atomic(manifest_path, payload)
    ledger = record_manifest(manifest_path, trigger="session-init", executor="prism")
    print(json.dumps({
        "session_manifest": str(manifest_path),
        "ledger_path": ledger["ledger_path"],
        "health_path": ledger["health_path"],
    }, ensure_ascii=False))
    return 0


def validate_session_payload(payload: dict[str, Any], label: str) -> None:
    temp_path = pathlib.Path(f"<{label}>")
    try:
        # Reuse the file validator's logic without introducing a schema library.
        require_keys(
            payload,
            [
                "schema_id",
                "task_id",
                "run_dir",
                "status",
                "max_rounds_per_provider",
                "created_at",
                "updated_at",
                "providers",
                "convergence",
            ],
            "session manifest",
        )
        if payload["schema_id"] != "prism-session-manifest":
            raise SystemExit("session manifest schema_id must be prism-session-manifest")
        if payload["status"] not in SESSION_STATUSES:
            raise SystemExit(f"session manifest status invalid: {payload['status']}")
        max_rounds = payload["max_rounds_per_provider"]
        if not isinstance(max_rounds, int) or max_rounds < 1 or max_rounds > 5:
            raise SystemExit("session manifest max_rounds_per_provider must be an integer from 1 to 5")
        providers = payload["providers"]
        if not isinstance(providers, dict):
            raise SystemExit("session manifest providers must be an object")
        for provider in ALLOWED_PROVIDERS:
            if provider not in providers:
                raise SystemExit(f"session manifest missing provider: {provider}")
            record = providers[provider]
            if not isinstance(record, dict):
                raise SystemExit(f"session manifest provider record must be an object: {provider}")
            require_keys(
                record,
                ["session_handle", "round_count", "status", "last_review"],
                f"session manifest provider {provider}",
            )
            if record["session_handle"] is not None and not isinstance(record["session_handle"], str):
                raise SystemExit(f"session_handle must be string or null: {provider}")
            if not isinstance(record["round_count"], int) or record["round_count"] < 0 or record["round_count"] > max_rounds:
                raise SystemExit(f"round_count invalid for {provider}")
            if record["status"] not in PROVIDER_SESSION_STATUSES:
                raise SystemExit(f"provider session status invalid for {provider}: {record['status']}")
            if record["last_review"] is not None and not isinstance(record["last_review"], str):
                raise SystemExit(f"last_review must be string or null: {provider}")
        convergence = payload["convergence"]
        if not isinstance(convergence, dict):
            raise SystemExit("session manifest convergence must be an object")
        require_keys(convergence, ["state", "reason"], "session manifest convergence")
        if convergence["state"] not in {"unresolved", "converged", "main-decided", "escalated"}:
            raise SystemExit(f"convergence state invalid: {convergence['state']}")
        if not isinstance(convergence["reason"], str):
            raise SystemExit("convergence reason must be a string")
    except SystemExit as exc:
        raise SystemExit(f"{temp_path}: {exc}") from exc


def cmd_session_update(args: argparse.Namespace) -> int:
    manifest_path = pathlib.Path(args.manifest).resolve()
    provider = args.provider
    with file_lock(manifest_path):
        payload = load_json(manifest_path)
        if not isinstance(payload, dict):
            raise SystemExit("session manifest must be an object")
        validate_session_payload(payload, str(manifest_path))
        record = payload["providers"][provider]
        if args.session_handle is not None:
            record["session_handle"] = args.session_handle
        if args.round_count is not None:
            record["round_count"] = args.round_count
        elif args.increment_round:
            record["round_count"] += 1
        if args.provider_status is not None:
            record["status"] = args.provider_status
        if args.last_review is not None:
            record["last_review"] = args.last_review
        if args.status is not None:
            payload["status"] = args.status
        if args.convergence_state is not None:
            payload["convergence"]["state"] = args.convergence_state
        if args.convergence_reason is not None:
            payload["convergence"]["reason"] = args.convergence_reason
        payload["updated_at"] = iso_now()
        validate_session_payload(payload, str(manifest_path))
        write_text_atomic(manifest_path, json.dumps(payload, ensure_ascii=False, indent=2) + "\n")
    ledger = record_manifest(manifest_path, trigger="session-update", executor="prism")
    print(json.dumps({
        "session_manifest": str(manifest_path),
        "provider": provider,
        "ledger_path": ledger["ledger_path"],
        "health_path": ledger["health_path"],
    }, ensure_ascii=False))
    return 0


def cmd_session_check(args: argparse.Namespace) -> int:
    manifest_path = pathlib.Path(args.manifest).resolve()
    payload = load_json(manifest_path)
    if not isinstance(payload, dict):
        raise SystemExit("session manifest must be an object")
    validate_session_payload(payload, str(manifest_path))
    providers = [args.provider] if args.provider else sorted(ALLOWED_PROVIDERS)
    blocked = []
    allowed = []
    max_rounds = payload["max_rounds_per_provider"]
    if payload["status"] != "active":
        blocked.append({
            "scope": "task",
            "reason": f"task status is {payload['status']}",
        })
    for provider in providers:
        record = payload["providers"][provider]
        remaining = max_rounds - record["round_count"]
        if record["round_count"] >= max_rounds:
            blocked.append({
                "provider": provider,
                "reason": f"{provider} at round {record['round_count']} of {max_rounds}; escalate or decide",
            })
        elif args.require_existing_session and record["round_count"] > 0 and not record["session_handle"]:
            blocked.append({
                "provider": provider,
                "reason": f"{provider} has prior rounds but no recorded session handle",
            })
        elif record["status"] in {"escalated", "expired", "closed"}:
            blocked.append({
                "provider": provider,
                "reason": f"{provider} status is {record['status']}",
            })
        else:
            allowed.append({
                "provider": provider,
                "round_count": record["round_count"],
                "max_rounds": max_rounds,
                "remaining_rounds": remaining,
                "session_handle": record["session_handle"],
            })
    result = {
        "session_manifest": str(manifest_path),
        "allowed": allowed,
        "blocked": blocked,
    }
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 2 if blocked else 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Prism local helper")
    subparsers = parser.add_subparsers(dest="command", required=True)

    check = subparsers.add_parser("check", help="validate local Prism files")
    check.set_defaults(func=cmd_check)

    gate = subparsers.add_parser("gate", help="evaluate deterministic Prism invocation rules")
    gate.add_argument("--task", help="Task text to classify")
    gate.add_argument("--request", help="JSON request file to classify")
    gate.add_argument("--risk-level", default="medium", choices=["low", "medium", "high", "critical"])
    gate.add_argument("--changed-path", dest="changed_paths", action="append", default=[])
    gate.add_argument("--tag", dest="tags", action="append", default=[])
    gate.add_argument("--task-id", help="Optional stable task id to attach to the gate ledger record")
    gate.add_argument("--boundary-cwd", help="CWD used by runtime boundary resolution for lifecycle gating")
    gate.add_argument("--project-workspace", help="Project workspace used by runtime boundary resolution")
    gate.add_argument("--lifecycle-packet", help="Development lifecycle packet checked for RedCap self-development work")
    gate.add_argument("--lifecycle-events", help="UserPromptSubmit event JSONL used to verify lifecycle prompt_context excerpts")
    gate.add_argument(
        "--semantic-policy",
        choices=["off", "auto", "auto-on-ambiguous", "force"],
        default="off",
        help="Use bounded LLM semantic judgment before final gate decision. Default keeps CLI deterministic.",
    )
    gate.add_argument("--semantic-provider", choices=sorted(ALLOWED_PROVIDERS), default="claude-code")
    gate.add_argument("--semantic-fallback-provider", choices=sorted(ALLOWED_PROVIDERS), default="claude-code")
    gate.add_argument("--semantic-timeout-seconds", type=float, default=20.0)
    gate.add_argument("--semantic-fake-response", help="Test-only semantic judgment JSON.")
    gate.add_argument("--semantic-fake-delay-seconds", type=float, default=0.0, help="Test-only semantic delay.")
    gate.add_argument("--completion-claim", help="Completion claim text to validate before returning the gate decision")
    gate.add_argument(
        "--capability-status",
        choices=[
            "not_started",
            "documented_only",
            "partially_implemented",
            "manually_runnable",
            "tested",
            "operational",
        ],
        help="Capability status for completion semantics validation",
    )
    gate.add_argument(
        "--completion-label",
        action="append",
        default=[],
        help="Non-completion label attached to the completion claim",
    )
    gate.add_argument(
        "--fail-when-required",
        action="store_true",
        help="Exit 2 when full Prism is required, for intake wrappers that must halt.",
    )
    gate.set_defaults(func=cmd_gate)

    brief = subparsers.add_parser("brief", help="print a provider review brief")
    brief.add_argument("--provider", required=True, choices=sorted(ALLOWED_PROVIDERS))
    brief.add_argument("--request", required=True)
    brief.add_argument("--out", help="Write the brief to a file and print only its path")
    brief.add_argument(
        "--inline-request",
        action="store_true",
        help="Include the full request JSON in the brief. Use only for bounded/manual provider calls.",
    )
    brief.set_defaults(func=cmd_brief)

    merge = subparsers.add_parser("merge", help="merge provider reviews")
    merge.add_argument("--out", help="Write the merged review to a file and print only its path")
    merge.add_argument("reviews", nargs="+")
    merge.set_defaults(func=cmd_merge)

    rebuttal_request = subparsers.add_parser(
        "rebuttal-request",
        help="generate a bounded same-provider rebuttal request for a rejected Prism concern",
    )
    rebuttal_request.add_argument("--merge", required=True)
    rebuttal_request.add_argument("--review", required=True)
    rebuttal_request.add_argument("--provider", required=True, choices=sorted(ALLOWED_PROVIDERS))
    rebuttal_request.add_argument("--main-claim", required=True)
    rebuttal_request.add_argument("--risk-level", default="medium", choices=["low", "medium", "high", "critical"])
    rebuttal_request.add_argument("--changed-reality", action="append", default=[])
    rebuttal_request.add_argument("--evidence", action="append", default=[])
    rebuttal_request.add_argument("--out", help="Write the generated rebuttal request to a file")
    rebuttal_request.set_defaults(func=cmd_rebuttal_request)

    resolution_check = subparsers.add_parser(
        "resolution-check",
        help="check that Prism concern/block verdicts were accepted, rejected with bounded rebuttal, or escalated",
    )
    resolution_check.add_argument("--merge", help="Merged Prism review JSON")
    resolution_check.add_argument("--resolution", help="Prism concern resolution JSON")
    resolution_check.add_argument("--review", action="append", default=[], help="Original provider review JSON; may repeat")
    resolution_check.add_argument("--manifest", help="Optional Prism session manifest to check convergence consistency")
    resolution_check.add_argument("--self-check", action="store_true")
    resolution_check.set_defaults(func=cmd_resolution_check)

    session_init = subparsers.add_parser("session-init", help="create a Prism task session manifest")
    session_init.add_argument("--task-id", required=True)
    session_init.add_argument("--run-dir", required=True)
    session_init.add_argument("--max-rounds", type=int, default=3)
    session_init.set_defaults(func=cmd_session_init)

    session_update = subparsers.add_parser("session-update", help="update a Prism task session manifest")
    session_update.add_argument("--manifest", required=True)
    session_update.add_argument("--provider", required=True, choices=sorted(ALLOWED_PROVIDERS))
    session_update.add_argument("--session-handle")
    session_update.add_argument("--round-count", type=int)
    session_update.add_argument("--increment-round", action="store_true")
    session_update.add_argument("--provider-status", choices=sorted(PROVIDER_SESSION_STATUSES))
    session_update.add_argument("--last-review")
    session_update.add_argument("--status", choices=sorted(SESSION_STATUSES))
    session_update.add_argument("--convergence-state", choices=["unresolved", "converged", "main-decided", "escalated"])
    session_update.add_argument("--convergence-reason")
    session_update.set_defaults(func=cmd_session_update)

    session_check = subparsers.add_parser("session-check", help="check whether another provider round is allowed")
    session_check.add_argument("--manifest", required=True)
    session_check.add_argument("--provider", choices=sorted(ALLOWED_PROVIDERS))
    session_check.add_argument(
        "--require-existing-session",
        action="store_true",
        help="For follow-up rounds, fail if prior rounds exist without a recorded session handle.",
    )
    session_check.set_defaults(func=cmd_session_check)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    sys.exit(main())
