{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redcap.local/schemas/prism-request.schema.json",
  "title": "Prism Review Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "user_intent",
    "main_claim",
    "changed_reality",
    "review_mode",
    "risk_level",
    "requested_providers"
  ],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1
    },
    "user_intent": {
      "type": "string",
      "minLength": 1
    },
    "main_claim": {
      "type": "string",
      "minLength": 1
    },
    "changed_reality": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["diff", "test", "log", "screenshot", "document", "user_statement", "other"]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "review_mode": {
      "type": "string",
      "enum": [
        "strategy_review",
        "design_review",
        "implementation_review",
        "completion_review",
        "anti_loop_review",
        "migration_review",
        "release_review"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "requested_providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["kimi", "claude-code"]
      }
    },
    "known_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

