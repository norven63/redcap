{
  "version": 1,
  "description": "Contract for append-only RedCap shared knowledge entries.",
  "required_frontmatter": [
    "title",
    "kind",
    "user",
    "created_at",
    "fingerprint"
  ],
  "allowed_kinds": [
    "lesson",
    "identity-signal",
    "skill-candidate",
    "governance-rule",
    "methodology",
    "case-study",
    "source-note"
  ],
  "filename_prefix": "UTC timestamp in YYYYMMDDTHHMMSSZ form",
  "append_only": true,
  "dedupe": {
    "fingerprint_algorithm": "sha256(normalized(kind + title + body))",
    "exact_duplicate_policy": "reject append and return the existing entry path"
  }
}
