#!/usr/bin/env bash
# shellcheck shell=bash

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
CURRENT_HOOK="$HOOK_DIR/commit-msg"
MESSAGE_FILE="${1:-}"
CHECK_SCRIPT="$REPO_ROOT/compass/tools/redcap-commit-message-check.py"

resolve_hook_file() {
    local repo_root="$1"
    local hook_dir="$2"
    local hook_name="$3"

    if [[ -z "$hook_dir" ]]; then
        return 1
    fi

    if [[ "$hook_dir" != /* ]]; then
        hook_dir="$repo_root/$hook_dir"
    fi

    printf '%s\n' "$hook_dir/$hook_name"
}

if [[ -z "$MESSAGE_FILE" ]]; then
    echo "[redcap-commit-msg] missing commit message file" >&2
    exit 1
fi

if [[ ! -f "$MESSAGE_FILE" ]]; then
    echo "[redcap-commit-msg] commit message file not found: $MESSAGE_FILE" >&2
    exit 1
fi

if [[ ! -f "$CHECK_SCRIPT" ]]; then
    echo "[redcap-commit-msg] missing commit message check script: $CHECK_SCRIPT" >&2
    exit 1
fi

python3 "$CHECK_SCRIPT" "$MESSAGE_FILE"

PREVIOUS_HOOKS_PATH="$(git -C "$REPO_ROOT" config --local --get redcap.previousHooksPath || true)"
PREVIOUS_HOOK_FILE="$(resolve_hook_file "$REPO_ROOT" "$PREVIOUS_HOOKS_PATH" "commit-msg" || true)"

if [[ -n "$PREVIOUS_HOOK_FILE" && -x "$PREVIOUS_HOOK_FILE" ]]; then
    PREVIOUS_HOOK_ABS="$(cd "$(dirname "$PREVIOUS_HOOK_FILE")" && pwd)/$(basename "$PREVIOUS_HOOK_FILE")"
    if [[ "$PREVIOUS_HOOK_ABS" != "$CURRENT_HOOK" ]]; then
        "$PREVIOUS_HOOK_FILE" "$@"
    fi
fi
