{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "./scripts/redcap-layerB-session-start.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "./scripts/redcap-layerB-session-end.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 300
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "./scripts/redcap-layerB-post-tool.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 120
      }
    ]
  }
}
