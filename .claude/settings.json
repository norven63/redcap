{
  "hooks": {
    "InstructionsLoaded": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash compass/tools/redcap-claude-hook-init.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash compass/tools/redcap-on-stop-review.sh"
          },
          {
            "type": "command",
            "command": "bash compass/tools/redcap-claude-hook-stop.sh"
          }
        ]
      }
    ]
  }
}
