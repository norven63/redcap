{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redcap.local/contracts/hook-coverage.schema.json",
  "title": "RedCap Hook Coverage Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "host_source",
    "adapter_path",
    "hook_config_path",
    "required_events",
    "guardrails",
    "deferred_events",
    "future_hook_policy"
  ],
  "properties": {
    "schema_id": {
      "const": "redcap-hook-coverage"
    },
    "host_source": {
      "type": "string",
      "minLength": 1
    },
    "adapter_path": {
      "type": "string",
      "minLength": 1
    },
    "hook_config_path": {
      "type": "string",
      "minLength": 1
    },
    "required_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "matrix_hook_id", "mode", "covers_guardrails"],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "matrix_hook_id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "covers_guardrails": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "coverage", "required_event", "rationale"],
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "string",
            "enum": ["hook_required", "explicit_command_required", "manual_protocol", "deferred_not_claimed"]
          },
          "required_event": {
            "type": ["string", "null"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deferred_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "status", "unblock_condition"],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "deferred_not_claimed"
          },
          "unblock_condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "future_hook_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "reason"],
      "properties": {
        "default": {
          "const": "fail_closed_when_required_event_missing"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
