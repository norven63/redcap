{
  "schema_id": "redcap-longrun-observer-contract",
  "schema_version": 1,
  "purpose": "定义长期外部项目观察机制，用项目级 .redcap 运行时证据判断 OL-11 是否可以关闭，或是否必须继续观察、修复漏洞。",
  "project_runtime_paths": {
    "config": ".redcap/state/longrun-observer/config.json",
    "observations": ".redcap/state/longrun-observer/observations.jsonl",
    "evaluation_default": ".redcap/evidence/longrun-observer/evaluation.json"
  },
  "required_capabilities": [
    "project_install",
    "loom_role_session",
    "requirement_change",
    "failure_reflux",
    "knowledge_recall",
    "self_purification",
    "persona_boundary",
    "e2e_validation",
    "cache_retention",
    "prism_review"
  ],
  "thresholds": {
    "min_duration_days": 14,
    "min_calendar_days_observed": 7,
    "min_iterations": 3,
    "min_requirement_changes": 2,
    "min_failure_reflux_cycles": 1,
    "min_revalidations": 3,
    "required_final_prism_pass": true,
    "block_on_open_p0_p1_failure": true
  },
  "event_types": [
    "project_initialized",
    "requirement_change",
    "role_session_continued",
    "failure_reflux",
    "knowledge_used",
    "self_purification_decision",
    "persona_boundary_check",
    "cache_retention_check",
    "revalidation",
    "prism_review",
    "human_acceptance",
    "observer_verdict"
  ],
  "decisions": {
    "eligible_to_close_ol11": "长期外部项目样本覆盖所有门槛，且没有 P0/P1 开放失败，可以进入 OL-11 关闭评审。",
    "continue_observing": "样本仍不足以关闭 OL-11，需要继续观察或补充运行证据。",
    "needs_fix": "观察到 P0/P1 开放失败或结构性缺陷，必须先修复再继续观察。"
  },
  "anti_completion_rules": [
    "观察器通过只表示 OL-11 具备关闭候选资格，不表示 RedCap 完整复活终局完成。",
    "即时生成的短期样本不得冒充长期外部项目样本。",
    "观察证据必须写入外部项目自己的 .redcap/ 目录，不得写入 RedCap 源仓库 assets/evidence。",
    "观察器不得收集 Cap 私有人格正文或用户敏感内容。"
  ]
}
