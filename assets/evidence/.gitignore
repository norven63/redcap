*
!.gitignore
!README.md

# Stable evidence that may be referenced by contracts, lifecycle packets, and task facts.
!lifecycle/
!lifecycle/*-lifecycle.json

!migrations/
!migrations/20260611-process-artifact-migration-map.json

!check-receipts/
!check-receipts/20260611-process-artifact-migration/
!check-receipts/20260611-process-artifact-migration/**
!check-receipts/20260614-release-e2e-protection/
!check-receipts/20260614-release-e2e-protection/**
!check-receipts/20260614-e2e-final-readiness/
!check-receipts/20260614-e2e-final-readiness/**

!task-facts/
!task-facts/task-facts.json
!task-facts/task-facts.jsonl
!task-facts/task-facts-summary.json

# Prism keeps structured review artifacts visible, while raw provider output stays ignored by default.
!prism/
!prism/*/
!prism/task-ledger.jsonl
!prism/task-health.json
!prism/**/*-prism-request.json
!prism/20260611-process-artifact-migration/
!prism/20260611-process-artifact-migration/session.json
!prism/20260611-process-artifact-migration/request.json
!prism/20260611-process-artifact-migration/merge.json
!prism/20260611-process-artifact-migration/resolution.json
!prism/20260611-process-artifact-migration/*.review.json
!prism/20260611-process-artifact-migration/*.review.brief.md
!prism/20260614-release-e2e-protection/
!prism/20260614-release-e2e-protection/session.json
!prism/20260614-release-e2e-protection/request.json
!prism/20260614-release-e2e-protection/merge.json
!prism/20260614-release-e2e-protection/resolution.json
!prism/20260614-release-e2e-protection/*.review.json
!prism/20260614-release-e2e-protection/*.review.brief.md
!prism/20260614-release-e2e-protection/*-review.json
!prism/20260614-release-e2e-protection/*-review.brief.md
!prism/20260614-e2e-final-readiness/
!prism/20260614-e2e-final-readiness/session.json
!prism/20260614-e2e-final-readiness/20260614-e2e-final-readiness-prism-request.json
!prism/20260614-e2e-final-readiness/merge.json
!prism/20260614-e2e-final-readiness/resolution.json
!prism/20260614-e2e-final-readiness/*.review.json
!prism/20260614-e2e-final-readiness/*.review.brief.md
!prism/20260614-e2e-final-readiness/*-review.json
!prism/20260614-e2e-final-readiness/*-review.brief.md
