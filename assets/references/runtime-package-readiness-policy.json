{
  "version": 1,
  "policy_id": "redcap-runtime-package-readiness",
  "status": "readiness-only",
  "publish_allowed": false,
  "package_manager": "npm",
  "package_name": "@norven63/redcap",
  "package_version": "0.1.0-alpha.0",
  "public_identity_status": "prepared-private-readiness",
  "license_status": "manual-before-public-publish",
  "surface_mode": "curated-runtime-readiness-surface",
  "contract_profile": "alpha-readiness-split-contract",
  "contract_boundary_policy": "references/runtime-public-contract-policy.json",
  "candidate_count_target": {
    "max_before_release_task": 280,
    "reason": "Public npm candidates should contain the runnable CLI/runtime contract plus clearly labelled maintainer/readiness support and the contract-boundary policy itself. The alpha readiness surface may temporarily include repo-governance checks required by diagnose/spec-check, but these are not stable end-user API; the separate formal release task must decide whether to trim them into a smaller runtime profile or split a maintainer profile."
  },
  "bin": {
    "redcap": "bin/redcap"
  },
  "candidate_globs": [
    "package.json",
    "bin/redcap",
    "README.md",
    "ARCHITECTURE.md",
    "assets/README.md",
    "revive-cap.sh",
    "closeout-cap.sh",
    "runtime/redcap-core/**",
    "runtime/host-adapters/**",
    "compass/tools/redcap-*.sh",
    "compass/tools/redcap-*.py",
    "prism/tools/*.sh",
    "prism/tools/*.py",
    "prism/README.md",
    "assets/references/*.json",
    "assets/references/file-lookup-dictionary.md",
    "assets/references/public-release-handoff.md",
    "assets/references/redcap-system-layers.md",
    "templates/shared-knowledge/README.md",
    "templates/shared-knowledge/schemas/*.json"
  ],
  "exclude_globs": [
    "compass/tools/redcap-acceptance-index.*",
    "compass/tools/redcap-artifact-*",
