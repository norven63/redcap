{
  "version": 1,
  "policy_id": "full-llm-wiki-product",
  "status": "implemented-controlled-local-product",
  "purpose": "Define the release-blocking full LLM-wiki capability as a private, source-anchored, review-gated long-term memory product. It may propose and organize durable knowledge, but it never replaces RedCap source truth, receipts, Prism verdicts, task ledgers, or private raw evidence.",
  "storage": {
    "root": "assets/knowledge/llm-wiki-full",
    "index": "assets/knowledge/llm-wiki-full/index.json",
    "entries": "assets/knowledge/llm-wiki-full/entries",
    "queue": "assets/knowledge/llm-wiki-full/queue",
    "receipts": "assets/knowledge/llm-wiki-full/receipts",
    "entry_schema": "assets/references/full-llm-wiki-entry.schema.json",
    "candidate_schema": "assets/references/full-llm-wiki-candidate.schema.json",
    "visibility": "private",
    "authority": "non-authoritative-derived-context"
  },
  "entry_contract": {
    "required_fields": [
      "version",
      "id",
      "title",
      "status",
      "visibility",
      "authority",
      "candidate_type",
      "privacy_classification",
      "source_anchors",
      "summary",
      "body",
      "review_state",
      "staleness",
      "forge_promotion"
    ],
    "allowed_status": [
      "active",
      "stale",
      "retired"
    ],
    "allowed_review_state": [
      "candidate",
      "reviewing",
      "accepted",
      "rejected",
      "retired"
    ],
    "required_authority": "non-authoritative-derived-context"
  },
  "worker_contract": {
    "entrypoint": "compass/tools/redcap-full-llm-wiki-worker.sh",
    "default_mode": "proposal-only",
    "automatic_source_mutation_allowed": false,
    "automatic_public_writeback_allowed": false,
    "requires_source_anchor": true,
    "requires_secret_scan": true,
    "requires_duplicate_detection": true,
    "writes_only": [
      "assets/knowledge/llm-wiki-full/queue/*.json",
      "assets/knowledge/llm-wiki-full/receipts/*.json"
    ],
    "must_not_write": [
      ".dev-task.md",
      "assets/references/*.json",
      "prism/runs/**",
      "assets/evidence/**",
      "redcap-arsenal/**",
      "templates/shared-knowledge/**"
    ]
  },
  "source_boundaries": {
    "allowed_candidate_types": [
      "stable-concept",
      "design-philosophy",
      "repeated-failure-pattern",
      "decision-framework",
      "terminology-explainer"
    ],
    "denied_source_paths": [
      ".env",
      ".env.*",
      "~/.cap/identity.md",
      ".dev-task.md",
      "prism/runs/**",
      "assets/evidence/**",
      "assets/private-archive/**",
      "private-archive/**",
      "compass/tools/**",
      "bin/**",
      "runtime/**"
    ],
    "raw_excerpt_rule": "Entries must paraphrase. They must not inline secrets, identity text, raw private conversations, raw Prism output, runtime evidence, or local credential material."
  },
  "rag_boundary": {
    "policy": "assets/references/rag-graphrag-boundary-policy.json",
    "real_backend_enabled": false,
    "adapter_required": true,
    "claim_rule": "RedCap may claim a controlled retrieval boundary exists, but must not claim live RAG, GraphRAG, vector search, or background semantic backend is enabled."
  },
  "required_surfaces": [
    "assets/references/full-llm-wiki-policy.json",
    "assets/references/full-llm-wiki-entry.schema.json",
    "assets/references/full-llm-wiki-candidate.schema.json",
    "assets/references/rag-graphrag-boundary-policy.json",
    "assets/knowledge/llm-wiki-full/README.md",
    "assets/knowledge/llm-wiki-full/index.json",
    "assets/knowledge/llm-wiki-full/queue/index.json",
    "assets/knowledge/llm-wiki-full/receipts/index.json",
    "compass/tools/redcap-full-llm-wiki-check.sh",
    "compass/tools/redcap-full-llm-wiki-worker.sh",
    "compass/tools/redcap-rag-graphrag-boundary-check.sh"
  ],
  "must_not_claim": [
    "Do not claim LLM-wiki is a source of truth.",
    "Do not claim background worker can publish or rewrite source truth automatically.",
    "Do not claim RAG, GraphRAG, vector search, or live semantic backend is enabled.",
    "Do not claim private reports, identity, raw Prism runs, or runtime evidence are wiki content.",
    "Do not claim public arsenal or public redcap-arsenal promotion is allowed without RedCap Forge review."
  ]
}
