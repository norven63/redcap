{
  "version": 1,
  "roots": {
    "active": "compass/docs/specs",
    "archive": "compass/docs/archive/specs"
  },
  "allowed_statuses": [
    "active",
    "reference",
    "superseded"
  ],
  "allowed_roles": [
    "design-snapshot",
    "human-guide",
    "operator-guide"
  ],
  "filename_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.md$",
  "summary": {
    "min_length": 12,
    "max_length": 240
  },
  "status_rules": {
    "active": {
      "allowed_roots": [
        "active"
      ],
      "require_replaced_by": false
    },
    "reference": {
      "allowed_roots": [
        "active",
        "archive"
      ],
      "require_replaced_by": false
    },
    "superseded": {
      "allowed_roots": [
        "archive"
      ],
      "require_replaced_by": true
    }
  }
}
